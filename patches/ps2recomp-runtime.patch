diff --git a/ps2xRuntime/include/runtime/ps2_profile.h b/ps2xRuntime/include/runtime/ps2_profile.h
new file mode 100644
index 0000000..5dc4984
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_profile.h
@@ -0,0 +1,36 @@
+#pragma once
+// Lightweight host-time counters for finding emulation bottlenecks.
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace ps2_profile
+{
+    enum Counter : uint32_t
+    {
+        Vu1Exec,   // VU1 microprogram execution (includes XGKICK -> GS)
+        GsPacket,  // GS::processGIFPacket (GIF parsing + rasterization)
+        Vif1Parse, // VIF1 stream parsing (includes UNPACK, DIRECT -> GS)
+        GsSync,    // EE-side waits for the asynchronous GS queue (GS::sync)
+        EeIdle,    // EE scheduler waiting on host time (no guest thread ready / pacing)
+        Vif1Wait,  // EE waits for the asynchronous VIF1/VU1 worker (PS2Memory::syncVif1)
+        Count
+    };
+
+    inline std::atomic<uint64_t> g_ns[Count]{};
+    inline std::atomic<uint64_t> g_calls[Count]{};
+
+    struct Scope
+    {
+        Counter counter;
+        std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+        explicit Scope(Counter c) : counter(c) {}
+        ~Scope()
+        {
+            const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now() - start).count();
+            g_ns[counter].fetch_add(static_cast<uint64_t>(ns), std::memory_order_relaxed);
+            g_calls[counter].fetch_add(1, std::memory_order_relaxed);
+        }
+    };
+}
diff --git a/ps2xRuntime/include/runtime/ps2_stall_probe.h b/ps2xRuntime/include/runtime/ps2_stall_probe.h
new file mode 100644
index 0000000..54c7333
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_stall_probe.h
@@ -0,0 +1,40 @@
+#pragma once
+// Lock-free stall probe. Threads that may block on another thread (EE/VIF1 producers waiting for
+// the GS worker, the EE waiting for the VIF1 worker, the GS worker inside the device) publish what
+// they are waiting for and since when. ps2x_stallProbeReport() is safe from any thread (heartbeat,
+// watchdog) and never takes a lock, so it still answers while the waited-for thread is stuck.
+// Report only: nothing here changes scheduling, completes work or kills anything.
+#include <cstdint>
+#include <string>
+
+enum class Ps2xWait : uint32_t
+{
+    GsSync = 0,      // GS::sync(): waits until the GS worker processed every queued command
+    GsQueueFull = 1, // GS queue back-pressure: producer waits for queue space
+    GsRunOnWorker = 2,
+    Vif1Sync = 3,    // PS2Memory::syncVif1(): waits for the asynchronous VIF1 worker
+    Count = 4
+};
+
+// RAII marker: counts the waiter and stamps the start time of the newest wait of this kind.
+class Ps2xWaitScope
+{
+public:
+    explicit Ps2xWaitScope(Ps2xWait kind);
+    ~Ps2xWaitScope();
+    Ps2xWaitScope(const Ps2xWaitScope &) = delete;
+    Ps2xWaitScope &operator=(const Ps2xWaitScope &) = delete;
+
+private:
+    Ps2xWait m_kind;
+};
+
+// GS worker: the command it is executing (string literal) and the device operation inside it.
+void ps2x_setGsWorkerOp(const char *op);
+void ps2x_setGsDeviceActivity(const char *op, uint64_t a = 0, uint64_t b = 0);
+// VIF1 worker: busy with a chain of `bytes` (0 = idle).
+void ps2x_setVif1WorkerJob(uint64_t bytes);
+
+// Multi-line report ("  stall-probe: ..."), from any thread.
+std::string ps2x_stallProbeReport();
+uint64_t ps2x_probeNowMs();
