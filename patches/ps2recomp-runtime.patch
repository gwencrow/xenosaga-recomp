+    void publishHiresFrame(const GSPresentationRequest &request, PresentationFrame &frame);
+    Target *hiresSource(const GSPresentationRequest &request, const PresentationFrame &frame, int &x, int &y, int &w, int &h);
+    void applyScaleState();
+    void applyRequestedResolution();
+    // First few reasons the upscaled picture wasn't available (log only).
+    void hiresSkip(const char *why)
+    {
+        static int count = 0;
+        if (count < 8 && ++count)
+            std::fprintf(stderr, "[gs-gl] native frame shown: %s\n", why);
+    }
+
+    GSCpuBackend m_cpu;
+    // Upscaled pictures are read through two pixel buffers: each present
+    // starts reading the current frame and hands over the previous one, so
+    // the GS thread doesn't wait for the GPU (one frame of display delay).
+    struct HiresSlot
+    {
+        GLuint pbo = 0;
+        const uint8_t *map = nullptr;
+        size_t bytes = 0;
+        GLsync fence = nullptr;
+        uint32_t w = 0, h = 0;
+        bool valid = false;
+    };
+    HiresSlot m_hires[2];
+    int m_hiresNext = 0;
+    GLuint m_stagingTex = 0, m_readFbo = 0, m_drawFbo = 0;
+    int m_snapW = 0, m_snapH = 0; // m_snapshotTex size (scaled pixels)
+    uint8_t *m_vram = nullptr;
+    HWND m_hwnd = nullptr;
+    HDC m_hdc = nullptr;
+    HGLRC m_ctx = nullptr;
+    std::thread::id m_glThread{};
+    bool m_current = false;
+
+    GLuint m_program = 0, m_vao = 0, m_fbo = 0, m_vbo = 0, m_ubo = 0, m_clutTex = 0, m_snapshotTex = 0;
+    uint8_t *m_vboMap = nullptr, *m_uboMap = nullptr;
+    GLsizeiptr m_vboOffset = 0, m_uboOffset = 0;
+    GLint m_uboAlign = 256;
+
+    std::map<uint64_t, Target> m_targets; // (page, fbw, kind)
+    std::unordered_map<uint64_t, Texture> m_textures;
+    uint32_t m_useClock = 0;
+    std::array<uint64_t, kPages> m_pageVersions{};
+    GSMem::TexturePageCache m_pageCache;
+
+    std::unordered_map<uint64_t, int> m_clutRows;
+    int m_nextClutRow = 0;
+    uint64_t m_clutVersion = 1;
+    uint64_t m_lastClutKey = 0;
+    int m_lastClutRow = 0;
+
+    bool m_batchOpen = false;
+    DrawKey m_key{};
+    GLint m_batchFirst = 0;
+    GLsizei m_batchCount = 0;
+    bool m_bound = false;
+
+    std::vector<uint32_t> m_readback;
+    std::vector<uint32_t> m_decode;
+    std::vector<uint8_t> m_decode8;
+    GSTransferCommand m_transferCommand{};
+    bool m_transferWrites = false;
+    uint64_t m_draws = 0, m_syncs = 0;
+    bool m_statsLog = std::getenv("PS2X_GL_STATS") && std::getenv("PS2X_GL_STATS")[0] == '2';
+    uint64_t m_syncNs = 0, m_syncPixels = 0, m_decodedCells = 0, m_decodeNs = 0, m_decodedTexels = 0;
+};
+
+// --- context ---------------------------------------------------------------
+
+bool GSGlBackend::create(HGLRC share)
+{
+    WNDCLASSA wc{};
+    wc.lpfnWndProc = DefWindowProcA;
+    wc.hInstance = GetModuleHandleA(nullptr);
+    wc.lpszClassName = "XenosagaGsGl";
+    RegisterClassA(&wc);
+    m_hwnd = CreateWindowA(wc.lpszClassName, "gs", WS_OVERLAPPEDWINDOW, 0, 0, 16, 16, nullptr, nullptr, wc.hInstance, nullptr);
+    if (!m_hwnd)
+        return false;
+    m_hdc = GetDC(m_hwnd);
+    PIXELFORMATDESCRIPTOR pfd{};
+    pfd.nSize = sizeof(pfd);
+    pfd.nVersion = 1;
+    pfd.dwFlags = PFD_SUPPORT_OPENGL | PFD_DRAW_TO_WINDOW;
+    pfd.iPixelType = PFD_TYPE_RGBA;
+    pfd.cColorBits = 32;
+    if (!SetPixelFormat(m_hdc, ChoosePixelFormat(m_hdc, &pfd), &pfd))
+        return false;
+    HGLRC temp = wglCreateContext(m_hdc);
+    if (!temp || !wglMakeCurrent(m_hdc, temp))
+        return false;
+    auto createAttribs = reinterpret_cast<PFNWGLCREATECONTEXTATTRIBSARBPROC>(wglGetProcAddress("wglCreateContextAttribsARB"));
+    const int attribs[] = {WGL_CONTEXT_MAJOR_VERSION_ARB, 4, WGL_CONTEXT_MINOR_VERSION_ARB, 5,
+                           WGL_CONTEXT_PROFILE_MASK_ARB, WGL_CONTEXT_CORE_PROFILE_BIT_ARB, 0};
+    // Share objects with the window's context so finished pictures can be
+    // drawn by the window straight from GPU memory; without it they go
+    // through a CPU readback.
+    m_ctx = (createAttribs && share) ? createAttribs(m_hdc, share, attribs) : nullptr;
+    const char *sharedEnv = std::getenv("PS2X_GL_SHARED_PRESENT"); // =1: on (off by default: the driver serializes the shared contexts and the GS thread slows down)
+    g_presShared = m_ctx != nullptr && sharedEnv && sharedEnv[0] == '1';
+    if (!m_ctx && createAttribs)
+        m_ctx = createAttribs(m_hdc, nullptr, attribs);
+    wglMakeCurrent(nullptr, nullptr);
+    wglDeleteContext(temp);
+    if (!m_ctx || !wglMakeCurrent(m_hdc, m_ctx))
+        return false;
+
+#define X(type, name)                                            \
+    p_##name = reinterpret_cast<type>(wglGetProcAddress(#name)); \
+    if (!p_##name)                                               \
+    {                                                            \
+        std::fprintf(stderr, "[gs-gl] missing %s\n", #name);     \
+        return false;                                            \
+    }
+    XS_GL_FUNCS(X)
+#undef X
+
+    GLint extensions = 0;
+    glGetIntegerv(GL_NUM_EXTENSIONS, &extensions);
+    bool interlock = false;
+    for (GLint i = 0; i < extensions; ++i)
+        if (std::strcmp(reinterpret_cast<const char *>(p_glGetStringi(GL_EXTENSIONS, i)), "GL_ARB_fragment_shader_interlock") == 0)
+            interlock = true;
+    std::fprintf(stderr, "[gs-gl] %s, OpenGL %s, interlock %s\n", reinterpret_cast<const char *>(glGetString(GL_RENDERER)),
+                 reinterpret_cast<const char *>(glGetString(GL_VERSION)), interlock ? "yes" : "NO");
+    std::fprintf(stderr, "[gs-gl] internal resolution %dx%d\n", kScaleX, kScaleY);
+    if (!interlock || !compileProgram())
+        return false;
+
+    p_glCreateVertexArrays(1, &m_vao);
+    p_glCreateFramebuffers(1, &m_fbo);
+    // Room for the largest scale, so the resolution can change while playing.
+    p_glNamedFramebufferParameteri(m_fbo, GL_FRAMEBUFFER_DEFAULT_WIDTH, kRtWidth * 5);
+    p_glNamedFramebufferParameteri(m_fbo, GL_FRAMEBUFFER_DEFAULT_HEIGHT, kRtHeight * 4);
+    p_glCreateFramebuffers(1, &m_readFbo);
+    p_glCreateFramebuffers(1, &m_drawFbo);
+
+    const GLbitfield mapFlags = GL_MAP_WRITE_BIT | GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT;
+    p_glCreateBuffers(1, &m_vbo);
+    p_glNamedBufferStorage(m_vbo, kVertexRingBytes, nullptr, mapFlags);
+    m_vboMap = static_cast<uint8_t *>(p_glMapNamedBufferRange(m_vbo, 0, kVertexRingBytes, mapFlags));
+    p_glCreateBuffers(1, &m_ubo);
+    p_glNamedBufferStorage(m_ubo, kUniformRingBytes, nullptr, mapFlags);
+    m_uboMap = static_cast<uint8_t *>(p_glMapNamedBufferRange(m_ubo, 0, kUniformRingBytes, mapFlags));
+    glGetIntegerv(GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT, &m_uboAlign);
+
+    p_glVertexArrayVertexBuffer(m_vao, 0, m_vbo, 0, sizeof(GpuVertex));
+    const struct
+    {
+        GLuint location;
+        GLint size;
+        GLenum type;
+        GLuint offset;
+    } attrs[] = {{0, 3, GL_FLOAT, offsetof(GpuVertex, x)},
+                 {1, 3, GL_FLOAT, offsetof(GpuVertex, s)},
+                 {2, 4, GL_UNSIGNED_BYTE, offsetof(GpuVertex, r)},
+                 {3, 1, GL_FLOAT, offsetof(GpuVertex, fog)}};
+    for (const auto &a : attrs)
+    {
+        p_glEnableVertexArrayAttrib(m_vao, a.location);
+        p_glVertexArrayAttribFormat(m_vao, a.location, a.size, a.type, GL_FALSE, a.offset);
+        p_glVertexArrayAttribBinding(m_vao, a.location, 0);
+    }
+
+    p_glCreateTextures(GL_TEXTURE_2D, 1, &m_clutTex);
+    p_glTextureStorage2D(m_clutTex, 1, GL_R32UI, 256, kClutRows);
+    p_glTextureParameteri(m_clutTex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    p_glTextureParameteri(m_clutTex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+
+    // The context moves to the thread that first draws.
+    wglMakeCurrent(nullptr, nullptr);
+    return true;
+}
+
+bool GSGlBackend::compileProgram()
+{
+    const auto compile = [](GLenum type, const char *source) -> GLuint
+    {
+        const GLuint shader = p_glCreateShader(type);
+        p_glShaderSource(shader, 1, &source, nullptr);
+        p_glCompileShader(shader);
+        GLint ok = 0;
+        p_glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+        if (!ok)
+        {
+            char log[4096];
+            p_glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+            std::fprintf(stderr, "[gs-gl] shader error: %s\n", log);
+            return 0u;
+        }
+        return shader;
+    };
+    const GLuint vs = compile(GL_VERTEX_SHADER, kVertexShader);
+    const GLuint fs = compile(GL_FRAGMENT_SHADER, kFragmentShader);
+    if (!vs || !fs)
+        return false;
+    m_program = p_glCreateProgram();
+    p_glAttachShader(m_program, vs);
+    p_glAttachShader(m_program, fs);
+    p_glLinkProgram(m_program);
+    GLint ok = 0;
+    p_glGetProgramiv(m_program, GL_LINK_STATUS, &ok);
+    if (!ok)
+    {
+        char log[4096];
+        p_glGetProgramInfoLog(m_program, sizeof(log), nullptr, log);
+        std::fprintf(stderr, "[gs-gl] link error: %s\n", log);
+        return false;
+    }
+    return true;
+}
+
+// GL work happens on the thread that draws (the GS worker): the first draw
+// claims the context. Until then nothing has reached the GPU, so calls from
+// other threads (start-up resets) have nothing to do there.
+bool GSGlBackend::onGlThread()
+{
+    return m_current && std::this_thread::get_id() == m_glThread;
+}
+
+bool GSGlBackend::claimGlThread()
+{
+    if (!m_ctx)
+        return false;
+    if (!m_current)
+    {
+        if (!wglMakeCurrent(m_hdc, m_ctx))
+            return false;
+        m_glThread = std::this_thread::get_id();
+        m_current = true;
+        p_glUseProgram(m_program);
+        p_glBindVertexArray(m_vao);
+        p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_fbo);
+        applyScaleState();
+        glEnable(GL_SCISSOR_TEST);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_CULL_FACE);
+        glDisable(GL_BLEND);
+        glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+        p_glBindTextureUnit(1, m_clutTex);
+    }
+    return std::this_thread::get_id() == m_glThread;
+}
+
+void GSGlBackend::applyScaleState()
+{
+    glViewport(0, 0, kRtWidth * kScaleX, kRtHeight * kScaleY);
+    glPointSize(static_cast<float>(std::max(kScaleX, kScaleY)));
+}
+
+// A new resolution from the settings menu: everything drawn so far goes to
+// local memory, the targets are dropped and come back at the new size.
+void GSGlBackend::applyRequestedResolution()
+{
+    const int request = g_requestedResolution.exchange(-1);
+    if (request < 0)
+        return;
+    int sx, sy;
+    scalesFor(request & 0xFF, (request & 0x100) != 0, sx, sy);
+    if (sx == kScaleX && sy == kScaleY)
+        return;
+    flushDraws();
+    syncAllToMemory("resolution");
+    dropAllTargets();
+    if (m_snapshotTex)
+        glDeleteTextures(1, &m_snapshotTex);
+    m_snapshotTex = 0;
+    m_snapW = m_snapH = 0;
+    kScaleX = sx;
+    kScaleY = sy;
+    applyScaleState();
+    std::fprintf(stderr, "[gs-gl] internal resolution now %dx%d\n", kScaleX, kScaleY);
+}
+
+// --- render targets --------------------------------------------------------
+
+void GSGlBackend::dropAllTargets()
+{
+    flushDraws();
+    for (auto &[key, t] : m_targets)
+        glDeleteTextures(1, &t.tex);
+    m_targets.clear();
+    for (auto &[key, t] : m_textures)
+        glDeleteTextures(1, &t.tex);
+    m_textures.clear();
+}
+
+GLuint GSGlBackend::newTargetTexture(int w, int h)
+{
+    GLuint tex = 0;
+    p_glCreateTextures(GL_TEXTURE_2D, 1, &tex);
+    p_glTextureStorage2D(tex, 1, GL_R32UI, w * kScaleX, h * kScaleY);
+    p_glTextureParameteri(tex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    p_glTextureParameteri(tex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    return tex;
+}
+
+// Targets start 512 rows tall and grow when something reaches further down
+// (at 4x a full 2048x2048 texture would be 256 MB each).
+void GSGlBackend::growTarget(Target &t, int rows)
+{
+    if (rows <= t.allocH)
+        return;
+    const int h = std::min(kRtHeight, (rows + 255) / 256 * 256);
+    flushDraws(); // queued draws use the old texture
+    const GLuint tex = newTargetTexture(t.allocW, h);
+    if (t.tex)
+    {
+        p_glMemoryBarrier(GL_TEXTURE_UPDATE_BARRIER_BIT | GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+        p_glCopyImageSubData(t.tex, GL_TEXTURE_2D, 0, 0, 0, 0, tex, GL_TEXTURE_2D, 0, 0, 0, 0,
+                             t.allocW * kScaleX, t.allocH * kScaleY, 1);
+        glDeleteTextures(1, &t.tex);
+    }
+    t.tex = tex;
+    t.allocH = h;
+}
+
+GSGlBackend::Target &GSGlBackend::colorTarget(const GSFrameReg &frame)
+{
+    const uint64_t key = (static_cast<uint64_t>(frame.fbp) << 16) | (static_cast<uint64_t>(frame.fbw) << 8) | frame.psm;
+    auto it = m_targets.find(key);
+    if (it != m_targets.end())
+        return it->second;
+    Target t;
+    t.page = frame.fbp;
+    t.fbw = std::max<uint32_t>(frame.fbw, 1u);
+    t.psm = frame.psm;
+    t.allocW = std::min<int>(static_cast<int>(t.fbw) * 64, kRtWidth);
+    growTarget(t, 512);
+    return m_targets.emplace(key, t).first->second;
+}
+
+GSGlBackend::Target &GSGlBackend::depthTarget(const GSContext &ctx)
+{
+    const uint64_t key = (1ull << 40) | (static_cast<uint64_t>(ctx.zbuf.zbp) << 16) |
+                         (static_cast<uint64_t>(ctx.frame.fbw) << 8) | ctx.zbuf.psm;
+    auto it = m_targets.find(key);
+    if (it != m_targets.end())
+        return it->second;
+    Target t;
+    t.page = ctx.zbuf.zbp;
+    t.fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+    t.psm = ctx.zbuf.psm;
+    t.isDepth = true;
+    t.allocW = std::min<int>(static_cast<int>(t.fbw) * 64, kRtWidth);
+    growTarget(t, 512);
+    return m_targets.emplace(key, t).first->second;
+}
+
+void GSGlBackend::ensureStaging()
+{
+    if (m_stagingTex)
+        return;
+    p_glCreateTextures(GL_TEXTURE_2D, 1, &m_stagingTex);
+    p_glTextureStorage2D(m_stagingTex, 1, GL_R32UI, kRtWidth, kRtHeight);
+}
+
+// Nearest-neighbour copy between two textures (scaling up or down).
+void GSGlBackend::blit(GLuint src, int sx0, int sy0, int sx1, int sy1, GLuint dst, int dx0, int dy0, int dx1, int dy1)
+{
+    p_glNamedFramebufferTexture(m_readFbo, GL_COLOR_ATTACHMENT0, src, 0);
+    p_glNamedFramebufferTexture(m_drawFbo, GL_COLOR_ATTACHMENT0, dst, 0);
+    p_glMemoryBarrier(GL_FRAMEBUFFER_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT | GL_TEXTURE_FETCH_BARRIER_BIT);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    p_glBlitNamedFramebuffer(m_readFbo, m_drawFbo, sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+    glEnable(GL_SCISSOR_TEST);
+}
+
+void GSGlBackend::loadFromMemory(Target &t, int y0, int y1)
+{
+    y1 = std::min(y1, t.allocH);
+    if (y1 <= y0)
+        return;
+    const uint32_t width = static_cast<uint32_t>(t.allocW);
+    const uint32_t block = t.page * 32u;
+    m_decode.resize(static_cast<size_t>(width) * (y1 - y0));
+    uint32_t *out = m_decode.data();
+    for (int y = y0; y < y1; ++y)
+        for (uint32_t x = 0; x < width; ++x)
+            *out++ = GSMem::ReadTexture(m_pageCache, m_vram, t.psm, block, t.fbw, x, static_cast<uint32_t>(y));
+    if (kScaleX == 1 && kScaleY == 1)
+    {
+        p_glTextureSubImage2D(t.tex, 0, 0, y0, width, y1 - y0, GL_RED_INTEGER, GL_UNSIGNED_INT, m_decode.data());
+        return;
+    }
+    ensureStaging();
+    p_glTextureSubImage2D(m_stagingTex, 0, 0, y0, width, y1 - y0, GL_RED_INTEGER, GL_UNSIGNED_INT, m_decode.data());
+    blit(m_stagingTex, 0, y0, width, y1, t.tex, 0, y0 * kScaleY, width * kScaleX, y1 * kScaleY);
+}
+
+void GSGlBackend::ensureRows(Target &t, int rows)
+{
+    rows = std::min(rows, kRtHeight);
+    growTarget(t, rows);
+    if (t.stale)
+    {
+        loadFromMemory(t, 0, std::max(t.rows, rows));
+        t.rows = std::max(t.rows, rows);
+        t.stale = false;
+        return;
+    }
+    if (rows > t.rows)
+    {
+        loadFromMemory(t, t.rows, rows);
+        t.rows = rows;
+    }
+}
+
+void GSGlBackend::markDirty(Target &t, int x0, int y0, int x1, int y1)
+{
+    if (!t.gpuDirty)
+    {
+        t.gpuDirty = true;
+        t.dx0 = x0;
+        t.dy0 = y0;
+        t.dx1 = x1;
+        t.dy1 = y1;
+        return;
+    }
+    t.dx0 = std::min(t.dx0, x0);
+    t.dy0 = std::min(t.dy0, y0);
+    t.dx1 = std::max(t.dx1, x1);
+    t.dy1 = std::max(t.dy1, y1);
+}
+
+void GSGlBackend::syncToMemory(Target &t, const char *why)
+{
+    if (!t.gpuDirty)
+        return;
+    t.gpuDirty = false;
+    t.dx0 = std::max(t.dx0, 0);
+    t.dy0 = std::max(t.dy0, 0);
+    t.dx1 = std::min(t.dx1, t.allocW);
+    t.dy1 = std::min(t.dy1, t.allocH);
+    const int w = t.dx1 - t.dx0, h = t.dy1 - t.dy0;
+    if (w <= 0 || h <= 0)
+        return;
+    ++m_syncs;
+    const auto syncStart = std::chrono::steady_clock::now();
+    m_syncPixels += static_cast<uint64_t>(w) * h;
+    if (m_statsLog)
+        std::fprintf(stderr, "[gs-gl] sync %s page %u psm %u %dx%d at %d,%d\n", why, t.page, t.psm, w, h, t.dx0, t.dy0);
+    p_glMemoryBarrier(GL_TEXTURE_UPDATE_BARRIER_BIT);
+    m_readback.resize(static_cast<size_t>(w) * h);
+    GLuint source = t.tex;
+    if (kScaleX > 1 || kScaleY > 1)
+    {
+        // Down to native pixels first (one sample per pixel, near its centre).
+        ensureStaging();
+        blit(t.tex, t.dx0 * kScaleX, t.dy0 * kScaleY, t.dx1 * kScaleX, t.dy1 * kScaleY, m_stagingTex, t.dx0, t.dy0, t.dx1, t.dy1);
+        source = m_stagingTex;
+    }
+    p_glGetTextureSubImage(source, 0, t.dx0, t.dy0, 0, w, h, 1, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                           static_cast<GLsizei>(m_readback.size() * 4u), m_readback.data());
+    const uint32_t block = t.page * 32u;
+    const uint32_t *in = m_readback.data();
+    for (int y = t.dy0; y < t.dy1; ++y)
+    {
+        if (t.isDepth)
+        {
+            if (t.psm == GS_PSM_Z24)
+                for (int x = t.dx0; x < t.dx1; ++x)
+                    GSMem::WriteZ24(m_vram, block, t.fbw, x, y, *in++);
+            else
+                for (int x = t.dx0; x < t.dx1; ++x)
+                    GSMem::WriteZ32(m_vram, block, t.fbw, x, y, *in++);
+        }
+        else
+        {
+            for (int x = t.dx0; x < t.dx1; ++x)
+                GSMem::WriteCT32(m_vram, block, t.fbw, x, y, *in++);
+        }
+    }
+    markPages(block, t.isDepth ? static_cast<uint8_t>(GS_PSM_Z32) : t.psm, t.fbw, t.dx0, t.dy0, w, h);
+    m_syncNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - syncStart).count());
+}
+
+void GSGlBackend::syncAllToMemory(const char *why)
+{
+    for (auto &[key, t] : m_targets)
+        syncToMemory(t, why);
+}
+
+// A local memory rectangle changed: textures over those pages decode again.
+void GSGlBackend::markPages(uint32_t blockBase, uint8_t psm, uint32_t bw, uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    uint32_t pw, ph;
+    pageSize(psm, pw, ph);
+    const uint32_t wide = pagesWide(psm, bw);
+    const uint32_t basePage = blockBase / 32u;
+    const uint32_t extra = (blockBase % 32u) != 0u ? 1u : 0u;
+    for (uint32_t row = y / ph; row <= (y + h - 1u) / ph + extra; ++row)
+        for (uint32_t col = x / pw; col <= (x + w - 1u) / pw + extra; ++col)
+            ++m_pageVersions[(basePage + row * wide + col) % kPages];
+}
+
+bool GSGlBackend::targetOverlaps(const Target &t, uint32_t firstPage, uint32_t lastPage) const
+{
+    uint32_t pw, ph;
+    pageSize(t.psm, pw, ph);
+    const uint32_t rows = std::max(1, t.rows);
+    const uint32_t end = t.page + pagesWide(t.psm, t.fbw) * ((rows - 1u) / ph + 1u);
+    return firstPage < end && t.page <= lastPage;
+}
+
+// Something other than a draw wrote these pages: reload the targets over them
+// (keeping what they drew first, which reached memory before the write).
+void GSGlBackend::onMemoryWritten(uint32_t firstPage, uint32_t lastPage)
+{
+    for (auto &[key, t] : m_targets)
+        if (t.rows > 0 && targetOverlaps(t, firstPage, lastPage))
+            t.stale = true;
+}
+
+void GSGlBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    if (onGlThread())
+    {
+        flushDraws();
+        // A transfer reads or partly overwrites local memory: it must be current.
+        if (command.direction == 1u || command.direction == 2u)
+            syncAllToMemory(command.direction == 1u ? "transfer-out" : "transfer-copy");
+        else
+        {
+            const uint32_t first = command.bitbltbuf.dbp / 32u;
+            const uint32_t last = first + pagesWide(command.bitbltbuf.dpsm, command.bitbltbuf.dbw) *
+                                              (command.trxreg.rrh / 32u + 1u);
+            for (auto &[key, t] : m_targets)
+                if (t.gpuDirty && targetOverlaps(t, first, last))
+                    syncToMemory(t, "transfer-in");
+        }
+    }
+    m_cpu.BeginTransfer(command);
+    const auto &bb = command.bitbltbuf;
+    if (command.direction == 2u || command.direction == 0u)
+    {
+        markPages(bb.dbp, bb.dpsm, bb.dbw, command.trxpos.dsax, command.trxpos.dsay,
+                  std::max<uint32_t>(command.trxreg.rrw, 1u), std::max<uint32_t>(command.trxreg.rrh, 1u));
+        const uint32_t first = bb.dbp / 32u;
+        uint32_t pw, ph;
+        pageSize(bb.dpsm, pw, ph);
+        onMemoryWritten(first, first + pagesWide(bb.dpsm, bb.dbw) * ((command.trxpos.dsay + command.trxreg.rrh) / ph + 1u));
+    }
+    m_transferWrites = command.direction == 0u;
+    m_transferCommand = command;
+}
+
+void GSGlBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    m_cpu.UploadImage(data, sizeBytes);
+    if (m_transferWrites)
+    {
+        const auto &bb = m_transferCommand.bitbltbuf;
+        markPages(bb.dbp, bb.dpsm, bb.dbw, m_transferCommand.trxpos.dsax, m_transferCommand.trxpos.dsay,
+                  std::max<uint32_t>(m_transferCommand.trxreg.rrw, 1u), std::max<uint32_t>(m_transferCommand.trxreg.rrh, 1u));
+    }
+}
+
+bool GSGlBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    if (onGlThread())
+    {
+        flushDraws();
+        syncAllToMemory("clear");
+    }
+    const bool ok = m_cpu.ClearFramebuffer(context, rgba);
+    const uint32_t first = context.frame.fbp;
+    onMemoryWritten(first, first + pagesWide(context.frame.psm, context.frame.fbw) * 32u);
+    return ok;
+}
+
+// --- textures --------------------------------------------------------------
+
+int GSGlBackend::clutRow(const GSDrawState &state)
+{
+    const auto &tex = state.context.tex0;
+    const uint64_t paramKey = m_clutVersion * 0x100000001B3ull ^
+                              (static_cast<uint64_t>(tex.cpsm) | (static_cast<uint64_t>(tex.csm) << 8) |
+                               (static_cast<uint64_t>(tex.csa) << 16) | (static_cast<uint64_t>(tex.psm) << 24) |
+                               (static_cast<uint64_t>(state.texa.ta0) << 32) | (static_cast<uint64_t>(state.texa.ta1) << 40) |
+                               (static_cast<uint64_t>(state.texa.aem) << 48));
+    if (paramKey == m_lastClutKey)
+        return m_lastClutRow;
+    uint32_t entries[256];
+    uint64_t hash = 0xCBF29CE484222325ull;
+    for (int i = 0; i < 256; ++i)
+    {
+        entries[i] = m_cpu.ClutEntryForGpu(state, static_cast<uint8_t>(i));
+        hash = (hash ^ entries[i]) * 0x100000001B3ull;
+    }
+    auto it = m_clutRows.find(hash);
+    int row;
+    if (it != m_clutRows.end())
+    {
+        row = it->second;
+    }
+    else
+    {
+        if (m_nextClutRow == kClutRows)
+        {
+            // All rows used: queued draws still read them, so draw those first.
+            flushDraws();
+            m_clutRows.clear();
+            m_nextClutRow = 0;
+        }
+        row = m_nextClutRow++;
+        p_glTextureSubImage2D(m_clutTex, 0, 0, row, 256, 1, GL_RED_INTEGER, GL_UNSIGNED_INT, entries);
+        m_clutRows[hash] = row;
+    }
+    m_lastClutKey = paramKey;
+    m_lastClutRow = row;
+    return row;
+}
+
+GSGlBackend::Texture &GSGlBackend::decodedTexture(const GSDrawState &state)
+{
+    const auto &tex = state.context.tex0;
+    const uint32_t width = state.textureWidth, height = state.textureHeight;
+    const bool indexed = isT8(tex.psm) || isT4(tex.psm);
+    const uint32_t texaKey = tex.psm == GS_PSM_CT32 || indexed
+                                 ? 0u
+                                 : (static_cast<uint32_t>(state.texa.ta0) | (static_cast<uint32_t>(state.texa.ta1) << 8) |
+                                    (static_cast<uint32_t>(state.texa.aem) << 16));
+    const uint64_t key = static_cast<uint64_t>(tex.tbp0) | (static_cast<uint64_t>(tex.tbw) << 14) |
+                         (static_cast<uint64_t>(tex.psm) << 20) | (static_cast<uint64_t>(tex.tw) << 26) |
+                         (static_cast<uint64_t>(tex.th) << 30) | (static_cast<uint64_t>(texaKey) << 34);
+    Texture &t = m_textures[key];
+    t.lastUse = ++m_useClock;
+    if (!t.tex)
+    {
+        p_glCreateTextures(GL_TEXTURE_2D, 1, &t.tex);
+        p_glTextureStorage2D(t.tex, 1, indexed ? GL_R8UI : GL_R32UI, width, height);
+        p_glTextureParameteri(t.tex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        p_glTextureParameteri(t.tex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        pageSize(tex.psm, t.cellW, t.cellH);
+        t.cols = (width + t.cellW - 1u) / t.cellW;
+        t.rows = (height + t.cellH - 1u) / t.cellH;
+        t.cellVersions.assign(static_cast<size_t>(t.cols) * t.rows, ~0ull);
+    }
+    // Decode the cells (one page of texels each) whose pages have changed.
+    const uint32_t basePage = tex.tbp0 / 32u;
+    const uint32_t wide = pagesWide(tex.psm, tex.tbw);
+    const bool unaligned = (tex.tbp0 % 32u) != 0u;
+    for (uint32_t row = 0; row < t.rows; ++row)
+        for (uint32_t col = 0; col < t.cols; ++col)
+        {
+            const uint32_t page = basePage + row * wide + col;
+            uint64_t version = m_pageVersions[page % kPages];
+            if (unaligned)
+                version += m_pageVersions[(page + 1u) % kPages] + m_pageVersions[(page + wide) % kPages] +
+                           m_pageVersions[(page + wide + 1u) % kPages];
+            uint64_t &seen = t.cellVersions[row * t.cols + col];
+            if (seen == version)
+                continue;
+            if (seen != ~0ull || !t.valid)
+                flushDraws(); // queued draws use the old texels
+            seen = version;
+            const auto decodeStart = std::chrono::steady_clock::now();
+            const uint32_t x0 = col * t.cellW, y0 = row * t.cellH;
+            const uint32_t w = std::min(t.cellW, width - x0), h = std::min(t.cellH, height - y0);
+            ++m_decodedCells;
+            m_decodedTexels += static_cast<uint64_t>(w) * h;
+            if (indexed)
+            {
+                std::vector<uint8_t> &out = m_decode8;
+                out.resize(static_cast<size_t>(w) * h);
+                GSMem::ReadTextureRect(m_vram, tex.psm, tex.tbp0, tex.tbw, x0, y0, w, h, out.data());
+                p_glTextureSubImage2D(t.tex, 0, x0, y0, w, h, GL_RED_INTEGER, GL_UNSIGNED_BYTE, out.data());
+            }
+            else
+            {
+                m_decode.resize(static_cast<size_t>(w) * h);
+                uint32_t *o = m_decode.data();
+                GSMem::ReadTextureRect(m_vram, tex.psm, tex.tbp0, tex.tbw, x0, y0, w, h, o);
+                if (tex.psm == GS_PSM_CT16 || tex.psm == GS_PSM_CT16S)
+                    for (size_t i = 0; i < m_decode.size(); ++i)
+                        o[i] = texaExpand(state.texa, tex.psm, expand5551(o[i]));
+                else if (tex.psm != GS_PSM_CT32)
+                    for (size_t i = 0; i < m_decode.size(); ++i)
+                        o[i] = texaExpand(state.texa, tex.psm, o[i]);
+                p_glTextureSubImage2D(t.tex, 0, x0, y0, w, h, GL_RED_INTEGER, GL_UNSIGNED_INT, m_decode.data());
+            }
+            m_decodeNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - decodeStart).count());
+        }
+    t.valid = true;
+    return t;
+}
+
+GLuint GSGlBackend::bindTexture(const GSDrawState &state, Target &frame, StateBlock &block, const GSVertex *, uint32_t, bool &feedback)
+{
+    const auto &tex = state.context.tex0;
+    feedback = false;
+    uint32_t pw, ph;
+    pageSize(tex.psm, pw, ph);
+    const uint32_t firstPage = tex.tbp0 / 32u;
+    const uint32_t wide = pagesWide(tex.psm, tex.tbw);
+    const uint32_t lastPage = firstPage + wide * ((state.textureHeight - 1u) / ph + 1u) - 1u;
+
+    // The texture is a render target, same layout: read the GPU's copy.
+    if (tex.psm == GS_PSM_CT32 && (tex.tbp0 % 32u) == 0u)
+    {
+        const uint64_t key = (static_cast<uint64_t>(firstPage) << 16) | (static_cast<uint64_t>(tex.tbw) << 8) | GS_PSM_CT32;
+        const auto it = m_targets.find(key);
+        if (it != m_targets.end() && it->second.rows > 0)
+        {
+            Target &source = it->second;
+            ensureRows(source, source.rows);
+            block.s0[0] = 1;
+            block.s10[0] = kScaleX;
+            block.s10[1] = kScaleY;
+            if (&source == &frame)
+            {
+                feedback = true;
+                return m_snapshotTex;
+            }
+            return source.tex;
+        }
+    }
+    // Otherwise it decodes from local memory, which must hold what was drawn.
+    for (auto &[key, t] : m_targets)
+        if (t.gpuDirty && targetOverlaps(t, firstPage, lastPage))
+        {
+            flushDraws();
+            syncToMemory(t, "texture");
+        }
+    const bool indexed = isT8(tex.psm) || isT4(tex.psm);
+    block.s0[0] = indexed ? 2 : 1;
+    if (indexed)
+        block.s6[3] = clutRow(state);
+    return decodedTexture(state).tex;
+}
+
+// --- drawing ---------------------------------------------------------------
+
+void GSGlBackend::reserveVertices(GLsizeiptr bytes)
+{
+    if (m_vboOffset + bytes <= kVertexRingBytes)
+        return;
+    // Wrapping: wait until the GPU has used everything written so far.
+    flushDraws();
+    GLsync fence = p_glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    p_glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, 5000000000ull);
+    p_glDeleteSync(fence);
+    m_vboOffset = 0;
+}
+
+void GSGlBackend::appendVertices(const GpuVertex *v, uint32_t count)
+{
+    std::memcpy(m_vboMap + m_vboOffset, v, sizeof(GpuVertex) * count);
+    m_vboOffset += sizeof(GpuVertex) * count;
+    m_batchCount += static_cast<GLsizei>(count);
+}
+
+void GSGlBackend::flushDraws()
+{
+    if (!m_batchOpen || m_batchCount == 0)
+    {
+        m_batchOpen = false;
+        return;
+    }
+    m_batchOpen = false;
+    const GLsizeiptr aligned = (sizeof(StateBlock) + m_uboAlign - 1) / m_uboAlign * m_uboAlign;
+    if (m_uboOffset + aligned > kUniformRingBytes)
+    {
+        GLsync fence = p_glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        p_glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, 5000000000ull);
+        p_glDeleteSync(fence);
+        m_uboOffset = 0;
+    }
+    std::memcpy(m_uboMap + m_uboOffset, &m_key.block, sizeof(StateBlock));
+    p_glBindBufferRange(GL_UNIFORM_BUFFER, 0, m_ubo, m_uboOffset, sizeof(StateBlock));
+    m_uboOffset += aligned;
+
+    p_glBindImageTexture(0, m_key.frameTex, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    p_glBindImageTexture(1, m_key.depthTex, 0, GL_FALSE, 0, GL_READ_WRITE, GL_R32UI);
+    if (m_key.tex)
+    {
+        p_glBindTextureUnit(0, m_key.tex);
+        p_glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT);
+    }
+    glScissor(m_key.scissor[0], m_key.scissor[1], m_key.scissor[2], m_key.scissor[3]);
+    p_glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+    glDrawArrays(m_key.mode, m_batchFirst, m_batchCount);
+    ++m_draws;
+    m_batchCount = 0;
+}
+
+void GSGlBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    if (!claimGlThread() || !m_vram || batch.vertexCount == 0u)
+        return;
+    applyRequestedResolution();
+    const GSDrawState &state = batch.state;
+    const GSContext &ctx = state.context;
+    const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+    const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+
+    DrawKey key{};
+    StateBlock &b = key.block;
+    Target &frame = colorTarget(ctx.frame);
+    Target &depth = depthTarget(ctx);
+    const int rows = ctx.scissor.y1 + 1;
+    if (frame.stale || rows > frame.rows)
+    {
+        flushDraws();
+        ensureRows(frame, rows);
+    }
+    if (depth.stale || rows > depth.rows)
+    {
+        flushDraws();
+        ensureRows(depth, rows);
+    }
+    key.frameTex = frame.tex;
+    key.depthTex = depth.tex;
+    key.scissor[0] = ctx.scissor.x0 * kScaleX;
+    key.scissor[1] = ctx.scissor.y0 * kScaleY;
+    key.scissor[2] = (ctx.scissor.x1 - ctx.scissor.x0 + 1) * kScaleX;
+    key.scissor[3] = (ctx.scissor.y1 - ctx.scissor.y0 + 1) * kScaleY;
+    b.s10[0] = 1;
+    b.s10[1] = 1;
+
+    const auto &tex = ctx.tex0;
+    const uint64_t clamp = ctx.clamp;
+    b.s0[1] = tex.tfx;
+    b.s0[2] = tex.tcc;
+    b.s0[3] = state.linearFilter ? 1 : 0;
+    b.s1[0] = static_cast<int32_t>(clamp & 3u);
+    b.s1[1] = static_cast<int32_t>((clamp >> 2) & 3u);
+    b.s1[2] = state.textureWidth;
+    b.s1[3] = state.textureHeight;
+    b.s2[0] = static_cast<int32_t>((clamp >> 4) & 0x3FFu);
+    b.s2[1] = static_cast<int32_t>((clamp >> 14) & 0x3FFu);
+    b.s2[2] = static_cast<int32_t>((clamp >> 24) & 0x3FFu);
+    b.s2[3] = static_cast<int32_t>((clamp >> 34) & 0x3FFu);
+    const uint64_t test = ctx.test;
+    b.s3[0] = static_cast<int32_t>(test & 1u);
+    b.s3[1] = static_cast<int32_t>((test >> 1) & 7u);
+    b.s3[2] = static_cast<int32_t>((test >> 4) & 0xFFu);
+    b.s3[3] = static_cast<int32_t>((test >> 12) & 3u);
+    b.s4[0] = static_cast<int32_t>((test >> 17) & 3u);
+    b.s4[1] = ctx.zbuf.zmask ? 0 : 1;
+    b.s4[2] = state.prim.abe ? 1 : 0;
+    b.s4[3] = static_cast<int32_t>(ctx.fba & 1u);
+    const uint64_t alpha = ctx.alpha;
+    b.s5[0] = static_cast<int32_t>(alpha & 3u);
+    b.s5[1] = static_cast<int32_t>((alpha >> 2) & 3u);
+    b.s5[2] = static_cast<int32_t>((alpha >> 4) & 3u);
+    b.s5[3] = static_cast<int32_t>((alpha >> 6) & 3u);
+    b.s6[0] = static_cast<int32_t>((alpha >> 32) & 0xFFu);
+    b.s6[1] = state.prim.fst ? 1 : 0;
+    b.s6[2] = state.prim.iip ? 1 : 0;
+    b.s7[0] = static_cast<int32_t>((test >> 14) & 1u);
+    b.s7[1] = static_cast<int32_t>((test >> 15) & 1u);
+    b.s7[2] = state.pabe ? 1 : 0;
+    b.s8[0] = state.prim.fge ? 1 : 0;
+    b.s8[1] = state.fogR;
+    b.s8[2] = state.fogG;
+    b.s8[3] = state.fogB;
+    b.s9[0] = ctx.frame.fbmsk;
+    b.s9[1] = ctx.zbuf.psm == GS_PSM_Z32 ? 0xFFFFFFFFu : (ctx.zbuf.psm == GS_PSM_Z24 ? 0x00FFFFFFu : 0x0000FFFFu);
+
+    const auto vertex = [](const GSVertex &v, float x, float y) -> GpuVertex
+    {
+        return GpuVertex{x, y, static_cast<float>(v.z), v.s, v.t, v.q, v.r, v.g, v.b, v.a, static_cast<float>(v.fog)};
+    };
+
+    GpuVertex out[6];
+    uint32_t count = 0;
+    int bx0, by0, bx1, by1;
+    const GSPrimType type = state.prim.type;
+    if (type == GS_PRIM_SPRITE && batch.vertexCount >= 2u)
+    {
+        b.s7[3] = 1;
+        const GSVertex &v0 = batch.vertices[0], &v1 = batch.vertices[1];
+        int x0 = static_cast<int>(v0.x) - static_cast<int>(ofx), y0 = static_cast<int>(v0.y) - static_cast<int>(ofy);
+        int x1 = static_cast<int>(v1.x) - static_cast<int>(ofx), y1 = static_cast<int>(v1.y) - static_cast<int>(ofy);
+        if (x0 > x1)
+            std::swap(x0, x1);
+        if (y0 > y1)
+            std::swap(y0, y1);
+        const int spanX = std::max(1, x1 - x0), spanY = std::max(1, y1 - y0);
+        x1 = x0 + spanX;
+        y1 = y0 + spanY;
+        float u0, v0f, u1, v1f;
+        if (state.prim.fst)
+        {
+            u0 = static_cast<float>((v0.u >> 4) * 16);
+            v0f = static_cast<float>((v0.v >> 4) * 16);
+            u1 = static_cast<float>((v1.u >> 4) * 16);
+            v1f = static_cast<float>((v1.v >> 4) * 16);
+        }
+        else
+        {
+            const auto safeQ = [](float q) { return std::fabs(q) > 1.0e-8f ? q : 1.0f; };
+            u0 = v0.s / safeQ(v0.q);
+            v0f = v0.t / safeQ(v0.q);
+            u1 = v1.s / safeQ(v1.q);
+            v1f = v1.t / safeQ(v1.q);
+        }
+        const auto corner = [&](float x, float y, float s, float t) -> GpuVertex
+        {
+            return GpuVertex{x, y, std::floor(static_cast<float>(v1.z)), s, t, 1.0f, v1.r, v1.g, v1.b, v1.a, static_cast<float>(v1.fog)};
+        };
+        const GpuVertex a = corner(static_cast<float>(x0), static_cast<float>(y0), u0, v0f);
+        const GpuVertex c = corner(static_cast<float>(x1), static_cast<float>(y0), u1, v0f);
+        const GpuVertex e = corner(static_cast<float>(x0), static_cast<float>(y1), u0, v1f);
+        const GpuVertex f = corner(static_cast<float>(x1), static_cast<float>(y1), u1, v1f);
+        out[0] = a;
+        out[1] = c;
+        out[2] = e;
+        out[3] = c;
+        out[4] = e;
+        out[5] = f;
+        count = 6;
+        key.mode = GL_TRIANGLES;
+        bx0 = x0;
+        by0 = y0;
+        bx1 = x1;
+        by1 = y1;
+    }
+    else if (batch.vertexCount >= 3u)
+    {
+        for (int i = 0; i < 3; ++i)
+            out[i] = vertex(batch.vertices[i], batch.vertices[i].x - ofx, batch.vertices[i].y - ofy);
+        if (state.prim.fst)
+            for (int i = 0; i < 3; ++i)
+            {
+                out[i].s = static_cast<float>(batch.vertices[i].u);
+                out[i].t = static_cast<float>(batch.vertices[i].v);
+                out[i].q = 1.0f;
+            }
+        count = 3;
+        key.mode = GL_TRIANGLES;
+        bx0 = static_cast<int>(std::floor(std::min({out[0].x, out[1].x, out[2].x})));
+        by0 = static_cast<int>(std::floor(std::min({out[0].y, out[1].y, out[2].y})));
+        bx1 = static_cast<int>(std::ceil(std::max({out[0].x, out[1].x, out[2].x}))) + 1;
+        by1 = static_cast<int>(std::ceil(std::max({out[0].y, out[1].y, out[2].y}))) + 1;
+    }
+    else if (batch.vertexCount == 2u)
+    {
+        for (int i = 0; i < 2; ++i)
+            out[i] = vertex(batch.vertices[i], batch.vertices[i].x - ofx + 0.5f, batch.vertices[i].y - ofy + 0.5f);
+        count = 2;
+        key.mode = GL_LINES;
+        if (kScaleX > 1 || kScaleY > 1)
+        {
+            // Upscaled: a line one PS2 pixel thick, as a thin quad (core
+            // profile has no wide lines). Offset across its major axis.
+            const GpuVertex p0 = out[0], p1 = out[1];
+            const bool horizontal = std::fabs(p1.x - p0.x) >= std::fabs(p1.y - p0.y);
+            const auto shifted = [&](GpuVertex v, float d)
+            {
+                (horizontal ? v.y : v.x) += d;
+                return v;
+            };
+            const GpuVertex a = shifted(p0, -0.5f), c = shifted(p1, -0.5f);
+            const GpuVertex e = shifted(p0, 0.5f), f = shifted(p1, 0.5f);
+            out[0] = a;
+            out[1] = c;
+            out[2] = e;
+            out[3] = c;
+            out[4] = e;
+            out[5] = f;
+            count = 6;
+            key.mode = GL_TRIANGLES;
+        }
+        bx0 = static_cast<int>(std::min(out[0].x, out[1].x)) - 1;
+        by0 = static_cast<int>(std::min(out[0].y, out[1].y)) - 1;
+        bx1 = static_cast<int>(std::max(out[0].x, out[1].x)) + 2;
+        by1 = static_cast<int>(std::max(out[0].y, out[1].y)) + 2;
+    }
+    else
+    {
+        out[0] = vertex(batch.vertices[0], batch.vertices[0].x - ofx + 0.5f, batch.vertices[0].y - ofy + 0.5f);
+        count = 1;
+        key.mode = GL_POINTS;
+        bx0 = static_cast<int>(out[0].x);
+        by0 = static_cast<int>(out[0].y);
+        bx1 = bx0 + 1;
+        by1 = by0 + 1;
+    }
+    bx0 = std::max<int>(bx0, ctx.scissor.x0);
+    by0 = std::max<int>(by0, ctx.scissor.y0);
+    bx1 = std::min<int>(bx1, ctx.scissor.x1 + 1);
+    by1 = std::min<int>(by1, ctx.scissor.y1 + 1);
+    if (bx1 <= bx0 || by1 <= by0)
+        return;
+
+    bool feedback = false;
+    if (state.prim.tme)
+    {
+        key.tex = bindTexture(state, frame, b, batch.vertices.data(), batch.vertexCount, feedback);
+        if (feedback)
+        {
+            // Samples its own target: from a copy of the pixels before this draw.
+            flushDraws();
+            p_glMemoryBarrier(GL_TEXTURE_UPDATE_BARRIER_BIT | GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+            const int sw = frame.allocW * kScaleX, sh = frame.allocH * kScaleY;
+            if (sw > m_snapW || sh > m_snapH)
+            {
+                if (m_snapshotTex)
+                    glDeleteTextures(1, &m_snapshotTex);
+                m_snapW = std::max(m_snapW, sw);
+                m_snapH = std::max(m_snapH, sh);
+                p_glCreateTextures(GL_TEXTURE_2D, 1, &m_snapshotTex);
+                p_glTextureStorage2D(m_snapshotTex, 1, GL_R32UI, m_snapW, m_snapH);
+                p_glTextureParameteri(m_snapshotTex, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                p_glTextureParameteri(m_snapshotTex, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+                key.tex = m_snapshotTex;
+            }
+            p_glCopyImageSubData(frame.tex, GL_TEXTURE_2D, 0, 0, 0, 0, m_snapshotTex, GL_TEXTURE_2D, 0, 0, 0, 0,
+                                 sw, std::min(std::max(frame.rows, 1), frame.allocH) * kScaleY, 1);
+        }
+    }
+
+    reserveVertices(sizeof(GpuVertex) * count);
+    if (!m_batchOpen || !(m_key == key) || feedback)
+    {
+        flushDraws();
+        m_key = key;
+        m_batchOpen = true;
+        m_batchFirst = static_cast<GLint>(m_vboOffset / sizeof(GpuVertex));
+        m_batchCount = 0;
+    }
+    appendVertices(out, count);
+    markDirty(frame, bx0, by0, bx1, by1);
+    if (b.s4[1] != 0)
+        markDirty(depth, bx0, by0, bx1, by1);
+    if (feedback)
+        flushDraws();
+}
+
+// The picture on screen at the upscaled resolution, read straight from the
+// GPU target (local memory only has native pixels). Only for the simple case
+// the game uses: one buffer shown by one circuit, or both circuits showing the
+// same buffer. Interlaced field mode included: the game draws whole 448-line
+// frames, so showing every line is the progressive picture. Anything else
+// keeps the native frame.
+GSGlBackend::Target *GSGlBackend::hiresSource(const GSPresentationRequest &request, const PresentationFrame &frame,
+                                              int &x, int &y, int &sw, int &sh)
+{
+    auto skip = [this](const char *why) -> Target * { hiresSkip(why); return nullptr; };
+    if (frame.usedPreferred)
+        return skip("preferred source");
+    const bool en1 = (request.pmode & 1u) != 0u, en2 = (request.pmode & 2u) != 0u;
+    if (!en1 && !en2)
+        return skip("no circuit");
+    if (en1 && en2 && request.dispfb1 != request.dispfb2)
+        return skip("two different buffers");
+    const uint64_t d = en1 ? request.dispfb1 : request.dispfb2;
+    const uint32_t fbp = static_cast<uint32_t>(d & 0x1FFu);
+    const uint32_t fbw = static_cast<uint32_t>((d >> 9) & 0x3Fu);
+    const uint32_t psm = static_cast<uint32_t>((d >> 15) & 0x1Fu);
+    const int dbx = static_cast<int>((d >> 32) & 0x7FFu), dby = static_cast<int>((d >> 43) & 0x7FFu);
+    if (frame.sourceFbp != fbp || (psm != GS_PSM_CT32 && psm != GS_PSM_CT24))
+        return skip("source buffer/format");
+    const uint64_t key = (static_cast<uint64_t>(fbp) << 16) | (static_cast<uint64_t>(fbw) << 8) | psm;
+    const auto it = m_targets.find(key);
+    if (it == m_targets.end() || it->second.rows == 0)
+        return skip("no GPU target");
+    Target &t = it->second;
+    const int w = static_cast<int>(frame.width), h = static_cast<int>(frame.height);
+    if (dbx + w > t.allocW || dby + h > kRtHeight)
+        return skip("outside the target");
+    ensureRows(t, dby + h);
+    x = dbx * kScaleX;
+    y = dby * kScaleY;
+    sw = w * kScaleX;
+    sh = h * kScaleY;
+    return &t;
+}
+
+// Shared-context presentation (see PresentSlot): copy the picture into a free
+// slot on the GPU and publish it. Nothing is read back, except a snapshot now
+// and then when the debug heartbeat asks for one (xs_frame.bmp).
+void GSGlBackend::publishHiresFrame(const GSPresentationRequest &request, PresentationFrame &frame)
+{
+    int x = 0, y = 0, sw = 0, sh = 0;
+    Target *source = hiresSource(request, frame, x, y, sw, sh);
+    std::unique_lock<std::mutex> lock(g_presMutex);
+    if (!source)
+    {
+        g_presLatest = -1;
+        return;
+    }
+    int s = 0;
+    while (s == g_presLatest || s == g_presInUse)
+        ++s;
+    PresentSlot &slot = g_pres[s];
+    if (slot.ready)
+    {
+        p_glDeleteSync(slot.ready); // published but never shown
+        slot.ready = nullptr;
+    }
+    if (slot.released)
+    {
+        p_glWaitSync(slot.released, 0, GL_TIMEOUT_IGNORED);
+        p_glDeleteSync(slot.released);
+        slot.released = nullptr;
+    }
+    lock.unlock();
+    if (!slot.tex || slot.w != static_cast<uint32_t>(sw) || slot.h != static_cast<uint32_t>(sh))
+    {
+        if (slot.tex)
+            glDeleteTextures(1, &slot.tex);
+        p_glCreateTextures(GL_TEXTURE_2D, 1, &slot.tex);
+        p_glTextureStorage2D(slot.tex, 1, GL_RGBA8, sw, sh);
+        // The copy moves the packed 32-bit GS pixels as they are (same bytes
+        // as the readback path); alpha is shown as opaque.
+        p_glTextureParameteri(slot.tex, GL_TEXTURE_SWIZZLE_A, GL_ONE);
+        p_glTextureParameteri(slot.tex, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        p_glTextureParameteri(slot.tex, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        p_glTextureParameteri(slot.tex, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        p_glTextureParameteri(slot.tex, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        slot.w = static_cast<uint32_t>(sw);
+        slot.h = static_cast<uint32_t>(sh);
+    }
+    p_glMemoryBarrier(GL_TEXTURE_UPDATE_BARRIER_BIT | GL_TEXTURE_FETCH_BARRIER_BIT | GL_FRAMEBUFFER_BARRIER_BIT);
+    p_glCopyImageSubData(source->tex, GL_TEXTURE_2D, 0, x, y, 0, slot.tex, GL_TEXTURE_2D, 0, 0, 0, 0, sw, sh, 1);
+    if (g_presSnapshotWanted.exchange(false))
+    {
+        frame.hiresPixels.resize(static_cast<size_t>(sw) * sh * 4u);
+        p_glGetTextureSubImage(slot.tex, 0, 0, 0, 0, sw, sh, 1, GL_RGBA, GL_UNSIGNED_BYTE,
+                               static_cast<GLsizei>(frame.hiresPixels.size()), frame.hiresPixels.data());
+        uint32_t *px = reinterpret_cast<uint32_t *>(frame.hiresPixels.data());
+        for (size_t i = 0, n = static_cast<size_t>(sw) * sh; i < n; ++i)
+            px[i] |= 0xFF000000u;
+    }
+    GLsync ready = p_glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    glFlush(); // the window's context must see the fence
+    lock.lock();
+    slot.ready = ready;
+    g_presLatest = s;
+    frame.hiresWidth = static_cast<uint32_t>(sw);
+    frame.hiresHeight = static_cast<uint32_t>(sh);
+}
+
+void GSGlBackend::readHiresFrame(const GSPresentationRequest &request, PresentationFrame &frame)
+{
+    int sx = 0, sy = 0, sw = 0, sh = 0;
+    Target *source = hiresSource(request, frame, sx, sy, sw, sh);
+    if (!source)
+        return;
+    Target &t = *source;
+    const size_t bytes = static_cast<size_t>(sw) * sh * 4u;
+
+    // Start reading this frame into the next slot.
+    HiresSlot &cur = m_hires[m_hiresNext];
+    if (cur.fence)
+    {
+        p_glClientWaitSync(cur.fence, GL_SYNC_FLUSH_COMMANDS_BIT, 5000000000ull);
+        p_glDeleteSync(cur.fence);
+        cur.fence = nullptr;
+    }
+    if (cur.bytes < bytes)
+    {
+        if (cur.pbo)
+            p_glDeleteBuffers(1, &cur.pbo);
+        p_glCreateBuffers(1, &cur.pbo);
+        const GLbitfield flags = GL_MAP_READ_BIT | GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT;
+        p_glNamedBufferStorage(cur.pbo, static_cast<GLsizeiptr>(bytes), nullptr, flags | GL_CLIENT_STORAGE_BIT);
+        cur.map = static_cast<const uint8_t *>(p_glMapNamedBufferRange(cur.pbo, 0, static_cast<GLsizeiptr>(bytes), flags));
+        cur.bytes = cur.map ? bytes : 0;
+        if (!cur.map)
+            return hiresSkip("pixel buffer");
+    }
+    p_glMemoryBarrier(GL_TEXTURE_UPDATE_BARRIER_BIT | GL_PIXEL_BUFFER_BARRIER_BIT);
+    p_glBindBuffer(GL_PIXEL_PACK_BUFFER, cur.pbo);
+    p_glGetTextureSubImage(t.tex, 0, sx, sy, 0, sw, sh, 1, GL_RED_INTEGER, GL_UNSIGNED_INT,
+                           static_cast<GLsizei>(bytes), nullptr);
+    p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    cur.fence = p_glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    cur.w = static_cast<uint32_t>(sw);
+    cur.h = static_cast<uint32_t>(sh);
+    cur.valid = true;
+
+    // Show the previous frame's picture (done by now); the first frame, or
+    // after a size change, waits for this one instead.
+    HiresSlot &prev = m_hires[m_hiresNext ^ 1];
+    HiresSlot &use = (prev.valid && prev.w == cur.w && prev.h == cur.h) ? prev : cur;
+    if (use.fence)
+    {
+        p_glClientWaitSync(use.fence, GL_SYNC_FLUSH_COMMANDS_BIT, 5000000000ull);
+        p_glDeleteSync(use.fence);
+        use.fence = nullptr;
+    }
+    if (&use == &prev)
+        prev.valid = false;
+    m_hiresNext ^= 1;
+
+    frame.hiresPixels.resize(bytes);
+    const uint32_t *in = reinterpret_cast<const uint32_t *>(use.map);
+    uint32_t *px = reinterpret_cast<uint32_t *>(frame.hiresPixels.data());
+    for (size_t i = 0, n = static_cast<size_t>(sw) * sh; i < n; ++i)
+        px[i] = in[i] | 0xFF000000u;
+    frame.hiresWidth = static_cast<uint32_t>(sw);
+    frame.hiresHeight = static_cast<uint32_t>(sh);
+}
+
+void ps2x_glSetResolution(int upscale, bool widescreen)
+{
+    g_requestedResolution.store(std::clamp(upscale, 1, 4) | (widescreen ? 0x100 : 0));
+}
+
+// Window thread (its OpenGL context current): the newest upscaled picture as
+// a texture of the shared context, or false to show the native frame. A new
+// picture is waited for on the GPU; the one it replaces gets a fence so the
+// GS can reuse it once the window's draws from it are done.
+bool ps2x_glPresentTexture(unsigned &tex, uint32_t &w, uint32_t &h)
+{
+    std::lock_guard<std::mutex> lock(g_presMutex);
+    if (!g_presShared || g_presLatest < 0)
+        return false;
+    if (g_presLatest != g_presInUse)
+    {
+        if (g_presInUse >= 0)
+        {
+            PresentSlot &old = g_pres[g_presInUse];
+            if (old.released)
+                p_glDeleteSync(old.released);
+            old.released = p_glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+            glFlush();
+        }
+        g_presInUse = g_presLatest;
+        PresentSlot &cur = g_pres[g_presInUse];
+        if (cur.ready)
+        {
+            p_glWaitSync(cur.ready, 0, GL_TIMEOUT_IGNORED);
+            p_glDeleteSync(cur.ready);
+            cur.ready = nullptr;
+        }
+    }
+    const PresentSlot &cur = g_pres[g_presInUse];
+    tex = cur.tex;
+    w = cur.w;
+    h = cur.h;
+    return true;
+}
+
+bool ps2x_glPresentShared()
+{
+    return g_presShared;
+}
+
+// The next published picture is also read back (debug snapshots only).
+void ps2x_glRequestHiresSnapshot()
+{
+    g_presSnapshotWanted.store(true);
+}
+
+std::unique_ptr<GSRasterBackend> ps2x_createGlBackend(int scale, bool widescreen)
+{
+    scalesFor(scale, widescreen, kScaleX, kScaleY);
+    // create() switches OpenGL contexts on this thread, which is the window's:
+    // put the window's back, or everything it draws goes nowhere.
+    const HDC windowDc = wglGetCurrentDC();
+    const HGLRC windowContext = wglGetCurrentContext();
+    auto backend = std::make_unique<GSGlBackend>();
+    const bool created = backend->create(windowContext);
+    wglMakeCurrent(windowDc, windowContext);
+    if (!created)
+    {
+        std::fprintf(stderr, "[gs-gl] GPU renderer not available; using the CPU renderer\n");
+        return nullptr;
+    }
+    return backend;
+}
+
+#else // not Windows
+
+std::unique_ptr<GSRasterBackend> ps2x_createGlBackend(int, bool)
+{
+    return nullptr;
+}
+
+void ps2x_glSetResolution(int, bool)
+{
+}
+
+bool ps2x_glPresentTexture(unsigned &, uint32_t &, uint32_t &)
+{
+    return false;
+}
+
+bool ps2x_glPresentShared()
+{
+    return false;
+}
+
+void ps2x_glRequestHiresSnapshot()
+{
+}
+
+#endif
