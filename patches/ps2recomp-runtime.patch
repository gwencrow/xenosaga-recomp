+
+void GS::shutdownGifDevice()
+{
+    if (!m_deviceActive)
+        return;
+    // The device is destroyed on its worker after everything queued before it. The caller
+    // waits without a deadline (the device is never abandoned), but reports where the teardown
+    // is every few seconds so a stuck shutdown can be localized from the log.
+    ps2x_setGsDeviceTeardownStage("queued behind earlier GS commands");
+    auto teardown = [this]()
+    {
+        ps2x_setGsDeviceTeardownStage("started on the GS worker");
+        std::lock_guard<std::mutex> lifetime(m_backendLifetimeMutex);
+        m_device.reset();
+        ps2x_setGsDeviceTeardownStage("device destroyed");
+    };
+    if (!deferToWorker())
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+        teardown();
+        m_deviceActive = false;
+        return;
+    }
+    static const int reportSeconds = []
+    {
+        const char *e = std::getenv("PS2X_GS_SHUTDOWN_REPORT_S");
+        const int v = e ? std::atoi(e) : 5;
+        return v > 0 ? v : 5;
+    }();
+    AsyncQueue::Command cmd{AsyncQueue::Call, {}, {}};
+    cmd.fn = [this, &teardown]()
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+        teardown();
+    };
+    m_async->push(std::move(cmd));
+    {
+        std::unique_lock<std::mutex> lock(m_async->mutex);
+        const uint64_t target = m_async->submitted;
+        const auto start = std::chrono::steady_clock::now();
+        while (!m_async->done.wait_for(lock, std::chrono::seconds(reportSeconds),
+                                       [&] { return m_async->processed >= target; }))
+        {
+            const double waited = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+            std::fprintf(stderr,
+                         "[gs-vk] shutdown still waiting after %.0f s: stage '%s'; %zu GS commands queued, "
+                         "%llu of %llu processed\n",
+                         waited, ps2x_gsDeviceTeardownStage(), m_async->queue.size(),
+                         static_cast<unsigned long long>(m_async->processed), static_cast<unsigned long long>(target));
+            std::fflush(stderr);
+        }
+    }
+    m_deviceActive = false;
+}
+
+std::string GS::gifDeviceStatsReport()
+{
+    std::string out;
+    if (m_async)
+    {
+        const uint64_t waits = m_async->producerWaits.exchange(0);
+        const uint64_t ns = m_async->producerWaitNs.exchange(0);
+        char line[160];
+        std::snprintf(line, sizeof(line), "  gs queue: producer waits %llu (%.1f ms)\n",
+                      static_cast<unsigned long long>(waits), ns / 1e6);
+        out += line;
+    }
+    {
+        uint64_t b[kFrameBuckets];
+        for (int i = 0; i < kFrameBuckets; ++i)
+            b[i] = g_frameIntervalBuckets[i].exchange(0, std::memory_order_relaxed);
+        const uint64_t n = g_frameIntervalCount.exchange(0), sum = g_frameIntervalSumUs.exchange(0),
+                       mx = g_frameIntervalMaxUs.exchange(0);
+        char line[256];
+        std::snprintf(line, sizeof(line),
+                      "  frame intervals: n %llu mean %.1f ms max %.1f ms | <20 %llu, 20-30 %llu, 30-40 %llu, 40-50 %llu, "
+                      "50-70 %llu, 70-100 %llu, >=100 %llu\n",
+                      (unsigned long long)n, n ? sum / 1000.0 / n : 0.0, mx / 1000.0, (unsigned long long)b[0],
+                      (unsigned long long)b[1], (unsigned long long)b[2], (unsigned long long)b[3], (unsigned long long)b[4],
+                      (unsigned long long)b[5], (unsigned long long)b[6]);
+        out += line;
+    }
+    // Device statistics are atomics (any thread); the lifetime mutex keeps the device alive.
+    std::lock_guard<std::mutex> lifetime(m_backendLifetimeMutex);
+    if (m_device)
+        out += m_device->StatsReport();
+    return out;
+}
