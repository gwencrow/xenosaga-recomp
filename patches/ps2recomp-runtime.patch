diff --git a/ps2xRuntime/include/runtime/gs/gs_capture.h b/ps2xRuntime/include/runtime/gs/gs_capture.h
new file mode 100644
index 0000000..b998075
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_capture.h
@@ -0,0 +1,175 @@
+#pragma once
+// Bounded, opt-in capture of everything the raw-GIF GS device consumes ("XGSR" format).
+//
+// What is recorded: the device's inputs in the order the GS worker applied them (GIF data per path,
+// HLE register writes, presentation requests with the 15 sampled display registers and CSR, GS
+// resets, local->host FIFO reads, single-pixel VRAM access, VRAM snapshots), plus keyframes (device
+// VRAM + renderer register/GIF-path state), renderer warnings at the point they were raised, hashes
+// of published frames and markers. All of it is produced on the GS worker thread, which is the only
+// consumer of the device, so one sequence number orders every event type.
+//
+// Bounding: records go into one preallocated ring (PS2X_GS_CAPTURE_MB, 64..4096 MiB). Old records
+// are evicted; a dump starts at the oldest keyframe still in the ring. Recording is a memcpy; the
+// only file I/O happens when a dump is requested (shutdown, stall watchdog, renderer warning), on a
+// background thread for asynchronous requests. Disabled unless PS2X_GS_CAPTURE_MB is set.
+//
+// File layout (little-endian): FileHeader, records (RecordHeader + payload padded to 8 bytes) in
+// sequence order, an End record, then the CRC-32 (IEEE) of all preceding bytes. The payload
+// of each record type is listed with xgsr::Rec below; ps2xTest/a05/xgsr_replay.h is a reader.
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace xgsr
+{
+constexpr uint32_t kMagic = 0x52534758u; // bytes "XGSR"
+constexpr uint32_t kVersion = 1u;
+
+enum class Rec : uint8_t
+{
+    Keyframe = 1,     // KeyframeHeader + register state + 3 GIF paths + 4 MiB VRAM
+    Gif = 2,          // path in RecordHeader.path (1..3); payload = accepted qwords
+    Register = 3,     // u8 addr, u8[7] pad, u64 value
+    Present = 4,      // u64 privLo[15], u64 csr
+    Reset = 5,        // none
+    FifoRead = 6,     // u32 requested, u32 returned, then the returned bytes
+    VramRead = 7,     // u32 psm, base, bw, x, y, result
+    VramWrite = 8,    // u32 psm, base, bw, x, y, value
+    VramSnapshot = 9, // none
+    Warning = 10,     // text
+    FrameHash = 11,   // u64 present index, u32 width, u32 height, u64 FNV-1a of the RGBA scanout
+    Mark = 12,        // text
+    End = 13,         // text (dump reason)
+    Integrity = 14    // u32 path, u32 kind, u64 detail0, u64 detail1, text
+};
+
+#pragma pack(push, 1)
+struct FileHeader
+{
+    uint32_t magic = kMagic;
+    uint32_t version = kVersion;
+    uint32_t headerBytes = sizeof(FileHeader);
+    uint32_t recordHeaderBytes = 24;
+    uint32_t samples = 1;
+    uint32_t keyframeInterval = 0;
+    uint32_t registerStateBytes = 0; // renderer ABI of keyframe payloads
+    uint32_t gifPathBytes = 0;
+    uint64_t ringBytes = 0;
+    uint64_t firstSeq = 0;
+    uint64_t lastSeq = 0;
+    uint64_t recordCount = 0;
+    uint64_t evictedRecords = 0;   // records that left the ring before this dump
+    uint64_t droppedRecords = 0;   // records not recorded (frozen during an earlier dump / oversize)
+    uint32_t forceProgressive = 1;
+    uint32_t reserved0 = 0;
+    char device[96] = {};
+    char build[64] = {};
+    char reason[64] = {};
+};
+struct RecordHeader
+{
+    uint8_t type = 0;
+    uint8_t path = 0;
+    uint16_t flags = 0;
+    uint32_t bytes = 0;  // payload bytes (unpadded)
+    uint64_t seq = 0;
+    uint64_t present = 0; // presents recorded before this record
+};
+struct KeyframeHeader
+{
+    uint32_t registerStateBytes = 0;
+    uint32_t gifPathBytes = 0;
+    uint32_t vramBytes = 0;
+    uint32_t flags = 0; // bit0: a GIF path was not at a tag boundary
+    uint64_t privLo[15] = {};
+    uint64_t csr = 0;
+};
+#pragma pack(pop)
+static_assert(sizeof(RecordHeader) == 24, "XGSR record header is 24 bytes");
+
+uint32_t crc32(const void *data, size_t bytes, uint32_t crc = 0);
+uint64_t fnv1a64(const void *data, size_t bytes);
+
+struct CaptureConfig
+{
+    uint64_t ringBytes = 0;          // 0 = capture off
+    uint32_t keyframeInterval = 120; // presents between keyframes
+    std::string dir = ".";
+    bool dumpOnWarning = true;       // renderer LOGW/LOGE and GIF integrity events request a dump
+    uint32_t warningDumpDelay = 60;  // presents recorded after the trigger before the dump
+    uint32_t maxDumps = 3;
+    // PS2X_GS_CAPTURE_MB, PS2X_GS_CAPTURE_DIR, PS2X_GS_CAPTURE_KEYFRAME, PS2X_GS_CAPTURE_ON_WARNING,
+    // PS2X_GS_CAPTURE_DELAY, PS2X_GS_CAPTURE_MAX_DUMPS
+    static CaptureConfig fromEnvironment();
+};
+
+class Recorder
+{
+public:
+    Recorder(const CaptureConfig &cfg, const FileHeader &templ);
+    ~Recorder();
+    Recorder(const Recorder &) = delete;
+    Recorder &operator=(const Recorder &) = delete;
+
+    bool enabled() const { return m_enabled; }
+
+    // GS worker: append one record (two optional payload parts). No-op while a dump is being written.
+    void record(Rec type, uint8_t path, const void *a, uint32_t aBytes, const void *b = nullptr, uint32_t bBytes = 0,
+                uint16_t flags = 0);
+    void recordText(Rec type, const std::string &text);
+    // GS worker: a Present record was appended; advances the present counter.
+    void notePresent() { m_present.fetch_add(1, std::memory_order_relaxed); }
+    uint64_t presentIndex() const { return m_present.load(std::memory_order_relaxed); }
+    // GS worker: true when the next present boundary should carry a keyframe.
+    bool keyframeDue() const;
+    // GS worker: called at each present boundary (after the keyframe, if any): starts delayed dumps.
+    void onPresentBoundary();
+
+    // Any thread: ask for a dump after `delayPresents` more presents (worker-driven, async write).
+    bool requestDump(const std::string &reason, uint32_t delayPresents);
+    // Any thread, synchronous: write what the ring holds now (stall watchdog, shutdown). Returns the
+    // file path, or "" if capture is off / nothing to write / the dump budget is exhausted.
+    std::string dumpNow(const std::string &reason);
+    // One heartbeat line.
+    std::string status() const;
+
+private:
+    struct Ref
+    {
+        size_t offset;
+        size_t size;
+        uint64_t seq;
+        Rec type;
+    };
+    void evictFront();
+    std::string writeFrozen(const std::string &reason); // caller has frozen the ring
+    void finishDump();
+
+    const CaptureConfig m_cfg;
+    FileHeader m_template;
+    bool m_enabled = false;
+    mutable std::mutex m_mutex;
+    std::vector<uint8_t> m_ring;
+    size_t m_head = 0;
+    std::deque<Ref> m_refs;
+    std::deque<uint64_t> m_keyframes; // seq of keyframes still in the ring
+    uint64_t m_nextSeq = 1;
+    uint64_t m_evicted = 0, m_dropped = 0, m_bytesRecorded = 0;
+    std::atomic<uint64_t> m_present{0};
+    uint64_t m_lastKeyframePresent = 0;
+    bool m_haveKeyframe = false;
+    bool m_frozen = false;
+    // delayed dump request
+    std::string m_pendingReason;
+    uint64_t m_pendingAt = 0;
+    bool m_pending = false;
+    uint32_t m_dumps = 0;
+    std::thread m_writer;
+    std::string m_lastPath;
+};
+} // namespace xgsr
diff --git a/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h b/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
index 2421f9e..6f3aaf4 100644
--- a/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
+++ b/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
@@ -1,16 +1,20 @@
