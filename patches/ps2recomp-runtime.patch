+            {
+                double s = 0;
+                for (int u = 0; u < 8; ++u)
+                    s += in[y * 8 + u] * basis[x * 8 + u];
+                tmp[y * 8 + x] = s;
+            }
+        for (int x = 0; x < 8; ++x)
+            for (int y = 0; y < 8; ++y)
