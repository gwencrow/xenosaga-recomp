+# the .gcda profiles copied next to their object files. Same results (it only
+# changes code layout, inlining and branch order); ~11% faster VU1.
+option(PS2X_PGO_GENERATE "Instrument the hot VU1/VIF1/GS sources for PGO" OFF)
+option(PS2X_PGO_USE "Build the hot VU1/VIF1/GS sources with PGO profiles" OFF)
+if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND (PS2X_PGO_GENERATE OR PS2X_PGO_USE))
+    set(PS2X_PGO_SOURCES
+        src/lib/vu/ps2_vu1_core.cpp src/lib/vu/ps2_vu1_upper.cpp src/lib/vu/ps2_vu1_lower.cpp
+        src/lib/ps2_vif1_interpreter.cpp src/lib/ps2_memory.cpp
+        src/lib/gs/gs_frontend.cpp src/lib/gs/gs_cpu_backend.cpp src/lib/gs/ps2_gs_memory.cpp src/lib/gs/ps2_gif_arbiter.cpp)
+    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/runner/xenosaga_vu1_blocks.cpp")
+        list(APPEND PS2X_PGO_SOURCES src/runner/xenosaga_vu1_blocks.cpp)
+    endif()
+    if(PS2X_PGO_GENERATE)
+        # Single (non-atomic) counters: a little noise across threads, which
+        # -fprofile-correction absorbs, instead of slowing the game down.
+        set_property(SOURCE ${PS2X_PGO_SOURCES} APPEND PROPERTY COMPILE_OPTIONS "-fprofile-generate")
+        # Only the port's heartbeat file needs to know (it dumps the profile).
+        if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/runner/xenosaga_debug.cpp")
+            set_property(SOURCE src/runner/xenosaga_debug.cpp APPEND PROPERTY COMPILE_DEFINITIONS PS2X_PGO_GENERATE=1)
+        endif()
+        foreach(PS2X_PGO_TARGET ps2EntryRunner vu1_replay gs_replay vu0_test)
+            if(TARGET ${PS2X_PGO_TARGET})
+                target_link_options(${PS2X_PGO_TARGET} PRIVATE "-fprofile-generate")
+            endif()
+        endforeach()
+    else()
+        set_property(SOURCE ${PS2X_PGO_SOURCES} APPEND PROPERTY COMPILE_OPTIONS
+                     "-fprofile-use;-fprofile-partial-training;-fprofile-correction;-Wno-missing-profile;-Wno-coverage-mismatch")
+    endif()
+endif()
