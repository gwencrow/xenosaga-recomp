diff --git a/ps2xRuntime/include/runtime/gs/gs_device.h b/ps2xRuntime/include/runtime/gs/gs_device.h
new file mode 100644
index 0000000..0ccfafc
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_device.h
@@ -0,0 +1,79 @@
+#pragma once
+// Raw-GIF GS device seam.
+//
+// A GSGifDevice consumes the GIF stream exactly as the GIF accepted it (per path, in arbitration
+// order) instead of the frontend's decoded primitives. It is the alternative to the legacy
+// frontend + GSRasterBackend pair: while a device is installed the legacy frontend does not
+// parse GIF data and no raster backend side effects run (no duplicated CSR/VRAM updates).
+//
+// Threading and ownership: every call is made on the GS async worker thread (GS::runOnWorker),
+// which owns the device and every graphics API object it creates. The EE and window threads only
+// enqueue work; reads of results (local->host FIFO, VRAM, presentation) are stream ordered.
+//
+// Guest-visible state ownership:
+//  - CSR SIGNAL/FINISH bits and SIGLBLID live in PS2Memory::GSRegisters; the device sets them from
+//    the GIF stream on the worker, exactly where the legacy frontend did.
+//  - CSR FIELD, VBlank, IMR and the display registers stay owned by the EE side (scheduler/MMIO);
+//    the device receives a stream-ordered snapshot of the display registers in each Present.
+//  - GS local memory is owned by the device (GPU-resident); the runtime's 4 MiB host copy is NOT
+//    updated while a device is installed.
+#include "runtime/gs/gs_types.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct GSRegisters;
+
+// Teardown stage reporting. A device's destructor names each stage as it enters it, so
+// GS::shutdownGifDevice can report where a slow or stuck teardown is (bounded diagnostic wait).
+// The name must be a string literal (static storage). Readable from any thread.
+#define PS2X_GS_DEVICE_TEARDOWN_STAGES 1
+void ps2x_setGsDeviceTeardownStage(const char *stage);
+const char *ps2x_gsDeviceTeardownStage();
+
+class GSGifDevice
+{
+public:
+    virtual ~GSGifDevice() = default;
+
+    virtual const char *Name() const = 0;
+
+    // GIF data accepted from `path`, in order. Any multiple of 16 bytes; GIF tag, PACKED/REGLIST
+    // and IMAGE state continue across calls per path.
+    virtual void GifTransfer(GifPathId path, const uint8_t *data, uint32_t sizeBytes) = 0;
+    // A+D style register write that did not arrive as GIF data (HLE kernel stubs).
+    virtual void WriteRegister(uint8_t addr, uint64_t value) = 0;
+
+    // Local->host transfer data started by an earlier TRXDIR=1 write. Returns bytes written.
+    virtual uint32_t ReadLocalToHost(uint8_t *dst, uint32_t maxBytes) = 0;
+
+    // Scan out the frame described by the request (display registers sampled in stream order).
+    virtual PresentationFrame Present(const GSPresentationRequest &request) = 0;
+
+    // Guest-visible single pixel access (rare; synchronizes the affected page only).
+    virtual uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) = 0;
+    virtual void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) = 0;
+    // Full 4 MiB copy: diagnostics and backend hand-off only (expensive).
+    virtual void SnapshotVram(std::vector<uint8_t> &out) = 0;
+
+    // Worker idle: submit batched GPU work without waiting (device decides whether to).
+    virtual void IdleFlush() = 0;
+    // GS reset (CSR RESET / runtime reset): drawing context state only; VRAM is kept.
+    virtual void Reset() = 0;
+    // One-line-per-item statistics since the last call (heartbeat).
+    virtual std::string StatsReport() = 0;
+
+    // ---- diagnostics (defaults: not supported) ----
+    // Any thread: write the capture ring now; returns the file path or "" (capture off / nothing).
+    virtual std::string CaptureDump(const std::string &reason) { (void)reason; return {}; }
+    // GS worker (replay): restore a capture keyframe (VRAM + renderer register/GIF-path state).
+    virtual bool RestoreKeyframe(const uint8_t *payload, size_t bytes, std::string &error)
+    {
+        (void)payload;
+        (void)bytes;
+        error = "keyframes are not supported by this device";
+        return false;
+    }
+};
