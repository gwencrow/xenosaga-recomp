+
+namespace
+{
+    // Frame, Z and texture ranges a primitive may touch (Z only if tested or
+    // written; texture only if mapped).
+    struct PrimRanges
+    {
+        uint32_t flo = 0, fhi = 0, ftag = 0;
+        bool z = false;
+        uint32_t zlo = 0, zhi = 0, ztag = 0;
+        bool tex = false;
+        uint32_t tlo = 0, thi = 0;
+    };
+
+    // Pages holding rows y0..y1 of a frame/Z buffer (FBP/ZBP are whole
+    // pages): page rows are 32 (32-bit) or 64 (16-bit) pixels high and fbw*64
+    // pixels wide, so start at y0/64 and end after y1/32 to cover both.
+    void rowsRange(uint32_t baseBytes, uint32_t widthPixels, uint32_t y0, uint32_t y1, uint32_t &lo, uint32_t &hi)
+    {
+        const uint32_t pagesWide = std::max(1u, (widthPixels + 63u) / 64u);
+        const uint32_t base = baseBytes & ~(kPage - 1u);
+        lo = base + (y0 / 64u) * pagesWide * kPage;
+        hi = base + (y1 / 32u + 1u) * pagesWide * kPage;
+    }
+
+    PrimRanges primRanges(const GSPrimitiveBatch &batch)
+    {
+        PrimRanges r;
+        const GSContext &ctx = batch.state.context;
+        // Rows the primitive can touch: its vertices' y extent (as the draw
+        // loops compute it), clamped to the scissor.
+        const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+        float minY = 1.0e30f, maxY = -1.0e30f;
+        const uint32_t count = std::max<uint32_t>(1u, std::min<uint32_t>(batch.vertexCount, 3u));
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            minY = std::min(minY, batch.vertices[i].y - ofy);
+            maxY = std::max(maxY, batch.vertices[i].y - ofy);
+        }
+        const int sy0 = static_cast<int>(ctx.scissor.y0), sy1 = static_cast<int>(ctx.scissor.y1);
+        const int y0 = std::max(sy0, std::min(sy1, static_cast<int>(std::floor(minY)) - 1));
+        const int y1 = std::max(sy0, std::min(sy1, static_cast<int>(std::ceil(maxY)) + 1));
+        const uint32_t width = std::max<uint32_t>(ctx.frame.fbw, 1u) * 64u;
+        rowsRange(GSInternal::framePageBaseToBlock(ctx.frame.fbp) * 256u, width, static_cast<uint32_t>(y0),
+                  static_cast<uint32_t>(y1), r.flo, r.fhi);
+        r.ftag = (ctx.frame.fbp << 12) ^ (ctx.frame.fbw << 6) ^ ctx.frame.psm;
+        const uint32_t ztest = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+        r.z = !ctx.zbuf.zmask || ztest >= 2u;
+        if (r.z)
+        {
+            rowsRange(GSInternal::framePageBaseToBlock(ctx.zbuf.zbp) * 256u, width, static_cast<uint32_t>(y0),
+                      static_cast<uint32_t>(y1), r.zlo, r.zhi);
+            r.ztag = 0x80000000u ^ (ctx.zbuf.zbp << 12) ^ (ctx.frame.fbw << 6) ^ ctx.zbuf.psm;
+        }
+        r.tex = batch.state.prim.tme;
+        if (r.tex)
+        {
+            // Page geometry of the texture's format (T8: 128x64, T4: 128x128,
+            // 16-bit: 64x64, everything else incl. T8H/T4HL/T4HH: 64x32).
+            const GSTex0Reg &tex = ctx.tex0;
+            uint32_t pageW = 64u, pageH = 32u;
+            switch (tex.psm)
+            {
+            case GS_PSM_T8:
+                pageW = 128u;
+                pageH = 64u;
+                break;
+            case GS_PSM_T4:
+                pageW = 128u;
+                pageH = 128u;
+                break;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+            case GS_PSM_Z16:
+            case GS_PSM_Z16S:
+                pageH = 64u;
+                break;
+            default:
+                break;
+            }
+            const uint32_t bufferWidth = std::max<uint32_t>(tex.tbw, 1u) * 64u;
+            const uint32_t stride = (bufferWidth + pageW - 1u) / pageW;
+            const uint32_t pagesHigh = ((1u << tex.th) + pageH - 1u) / pageH;
+            // Wider than the buffer: the extra columns can reach further pages.
+            const uint32_t extraWide = (1u << tex.tw) > bufferWidth ? ((1u << tex.tw) + pageW - 1u) / pageW : 0u;
+            // Not starting on a page boundary: the layout spills into one more.
+            const uint32_t spill = ((tex.tbp0 * 256u) & (kPage - 1u)) != 0u ? 1u : 0u;
+            r.tlo = (tex.tbp0 * 256u) & ~(kPage - 1u);
+            r.thi = r.tlo + (pagesHigh * stride + extraWide + spill) * kPage;
+        }
+        return r;
+    }
+
+    // Samples memory it draws into, or its Z buffer overlaps its frame
+    // buffer: pixels of different rows can share memory, so the primitive's
+    // own row order matters.
+    bool needsOrderedDraw(const PrimRanges &r)
+    {
+        if (r.z && overlaps(r.zlo, r.zhi, r.flo, r.fhi))
+            return true;
+        return r.tex && (overlaps(r.tlo, r.thi, r.flo, r.fhi) || (r.z && overlaps(r.tlo, r.thi, r.zlo, r.zhi)));
+    }
+
+    // Texel coordinates a sprite pixel may read with nonzero weight along one
+    // axis (same maths as DrawSprite + SampleTexture), lowest first.
+    void spriteTexelRange(const GSDrawState &state, float texF, int texSize, int &lo, int &hi)
+    {
+        float coord;
+        if (state.prim.fst)
+        {
+            const int fixed = clampInt(static_cast<int>((texF * 16.0f) + 0.5f), 0, 0xFFFF);
+            coord = static_cast<float>(static_cast<uint16_t>(fixed)) / 16.0f;
+        }
+        else
+        {
+            coord = (texF / static_cast<float>(texSize)) * (1.0f / fabsQ(1.0f)) * static_cast<float>(texSize);
+        }
+        if (!state.linearFilter)
+        {
+            lo = hi = static_cast<int>(coord);
+            return;
+        }
+        const float sample = coord - 0.5f;
+        lo = static_cast<int>(std::floor(sample));
+        hi = (sample - static_cast<float>(lo)) > 0.0f ? lo + 1 : lo;
+    }
+
+    // A sprite that samples its own frame buffer (same address, width and
+    // format) but only ever reads pixels at or after the one being drawn, in
+    // top-to-bottom, left-to-right order: drawn alone it always sees the
+    // values from before the sprite, so it can be drawn from a VRAM copy on
+    // any number of threads. (Xenosaga's full-screen shift/blur passes.)
+    bool isForwardFeedbackSprite(const GSPrimitiveBatch &batch, const PrimRanges &r)
+    {
+        const GSDrawState &state = batch.state;
+        const GSContext &ctx = state.context;
+        const GSTex0Reg &tex = ctx.tex0;
+        if (state.prim.type != GS_PRIM_SPRITE || !state.prim.tme || batch.vertexCount < 2u)
+            return false;
+        if (r.z && (overlaps(r.zlo, r.zhi, r.flo, r.fhi) || overlaps(r.tlo, r.thi, r.zlo, r.zhi)))
+            return false;
+        if ((tex.psm != GS_PSM_CT32 && tex.psm != GS_PSM_CT24) || tex.psm != ctx.frame.psm ||
+            tex.tbw != ctx.frame.fbw || tex.tbp0 != GSInternal::framePageBaseToBlock(ctx.frame.fbp))
+            return false;
+        // Coordinates must stay inside the texture, so REPEAT/CLAMP leave them alone.
+        const uint8_t wrapU = static_cast<uint8_t>(ctx.clamp & 0x3u);
+        const uint8_t wrapV = static_cast<uint8_t>((ctx.clamp >> 2) & 0x3u);
+        if (wrapU > 1u || wrapV > 1u)
+            return false;
+
+        // Same rectangle and texture setup as DrawSprite.
+        const GSVertex &v0 = batch.vertices[0];
+        const GSVertex &v1 = batch.vertices[1];
+        const int ofx = ctx.xyoffset.ofx >> 4;
+        const int ofy = ctx.xyoffset.ofy >> 4;
+        int x0 = static_cast<int>(v0.x) - ofx, y0 = static_cast<int>(v0.y) - ofy;
+        int x1 = static_cast<int>(v1.x) - ofx, y1 = static_cast<int>(v1.y) - ofy;
+        if (x0 > x1)
+            std::swap(x0, x1);
+        if (y0 > y1)
+            std::swap(y0, y1);
+        const int spanX = std::max(1, x1 - x0);
+        const int spanY = std::max(1, y1 - y0);
+        if (x0 + spanX - 1 < ctx.scissor.x0 || x0 > ctx.scissor.x1 || y0 + spanY - 1 < ctx.scissor.y0 || y0 > ctx.scissor.y1)
+            return true; // draws nothing
+        const int drawX0 = clampInt(x0, ctx.scissor.x0, ctx.scissor.x1);
+        const int drawY0 = clampInt(y0, ctx.scissor.y0, ctx.scissor.y1);
+        const int drawX1 = clampInt(x0 + spanX - 1, ctx.scissor.x0, ctx.scissor.x1);
+        const int drawY1 = clampInt(y0 + spanY - 1, ctx.scissor.y0, ctx.scissor.y1);
+        const int texW = state.textureWidth;
+        const int texH = state.textureHeight;
+        float u0f, v0f, u1f, v1f;
+        if (state.prim.fst)
+        {
+            u0f = static_cast<float>(v0.u >> 4);
+            v0f = static_cast<float>(v0.v >> 4);
+            u1f = static_cast<float>(v1.u >> 4);
+            v1f = static_cast<float>(v1.v >> 4);
+        }
+        else
+        {
+            const float q0 = fabsQ(v0.q);
+            const float q1 = fabsQ(v1.q);
+            u0f = (v0.s / q0) * static_cast<float>(texW);
+            v0f = (v0.t / q0) * static_cast<float>(texH);
+            u1f = (v1.s / q1) * static_cast<float>(texW);
+            v1f = (v1.t / q1) * static_cast<float>(texH);
+        }
+        const float spriteW = static_cast<float>(spanX);
+        const float spriteH = static_cast<float>(spanY);
+
+        bool needColumns = false; // some row reads its own row
+        for (int y = drawY0; y <= drawY1; ++y)
+        {
+            const float ty = (static_cast<float>(y - y0) + 0.5f) / spriteH;
+            int lo, hi;
+            spriteTexelRange(state, v0f + (v1f - v0f) * ty, texH, lo, hi);
+            if (lo < y || hi >= texH)
+                return false;
+            needColumns |= lo == y;
+        }
+        for (int x = drawX0; x <= drawX1; ++x)
+        {
+            const float tx = (static_cast<float>(x - x0) + 0.5f) / spriteW;
+            int lo, hi;
+            spriteTexelRange(state, u0f + (u1f - u0f) * tx, texW, lo, hi);
+            if (lo < 0 || hi >= texW || (needColumns && lo < x))
+                return false;
+        }
+        return true;
+    }
+}
