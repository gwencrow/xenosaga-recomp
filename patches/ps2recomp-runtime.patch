+
+    // ---- native programs (generated by port/tools/vu1prog.py)
+    //
+    // A native program runs a whole VU1 call (or the part of it the generator
+    // knows) with sequential semantics: every result lands at once and MAC /
+    // status / CLIP / Q / P commit immediately. That equals the cycle-accurate
+    // interpreter whenever every read sees the newest value, which the
+    // generator proves for each flag/Q/P read (writer at least its latency in
+    // pairs earlier on every path). Arithmetic is the interpreter's own: the
+    // vectorised fast paths above, else the generic path with its pipeline
+    // entries committed on the spot. Entered only with empty pipelines.
+
+    static PS2X_VU1_INLINE VU1State &st(Vu &vu) { return vu.m_state; }
+
+    // Commit everything queued by a generic instruction right now.
+    static inline void commitAllNow(Vu &vu)
+    {
+        const uint64_t saved = vu.m_cycle;
+        vu.m_cycle = ~0ull >> 2;
+        vu.commitFlagsUpTo(vu.m_cycle);
+        vu.commitReadyPipelines();
+        vu.commitFlagsUpTo(vu.m_cycle);
+        vu.m_cycle = saved;
+        vu.m_nextCommit = 0;
+    }
+
+    // Lazy MAC/status for native programs (see nFlush).
+    struct LazyFlags
+    {
+        int zeros = 0;
+        int signs = 0;
+        uint32_t sticky = 0;
+        bool pending = false;
+    };
+
+    // MAC/status as commitFlagsUpTo applies an FMAC entry.
+    static PS2X_VU1_INLINE void commitFmacFlags(Vu &vu, int zeros, int signs, uint32_t extraSticky)
+    {
+        using namespace vu1fast;
+        vu.m_state.mac = static_cast<uint32_t>(kReverse4[zeros]) | (static_cast<uint32_t>(kReverse4[signs]) << 4);
+        const uint32_t current = (zeros ? 0x1u : 0u) | (signs ? 0x2u : 0u);
+        vu.m_state.status = (vu.m_state.status & 0xFF0u) | current | ((current | extraSticky) << 6);
+    }
+
+    // fmac() with the flag entry committed at once (same checks, same maths).
+    // Clean (native programs, proved by port/tools/vu1prog.py): bit 0 = fs,
+    // bit 1 = ft (or its broadcast lane), bit 2 = ACC hold only normal
+    // numbers or zeros in the lanes this op uses, so normalisation is a
+    // no-op there and is skipped.
+    template <uint32_t I, uint32_t Clean = 0u>
+    static PS2X_VU1_INLINE bool fmacNow(Vu &vu, vu1fast::FastOp fop, bool toAcc, LazyFlags *lazy = nullptr)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr uint8_t d = dest(I);
+        constexpr uint8_t fsr = fs(I);
+        constexpr uint8_t ftr = ft(I);
+        if constexpr (d == 0u)
+            return true;
+        const bool productSum = fop.kind == FastMadd || fop.kind == FastMsub;
+        int minExp = 1;
+        if (productSum)
+        {
+            uint32_t qBits, iBits;
+            std::memcpy(&qBits, &vu.m_state.q, 4);
+            std::memcpy(&iBits, &vu.m_state.i, 4);
+            const uint32_t operandExp = std::max(std::max(maxExponent4(vu.m_state.vf[fsr]), maxExponent4(vu.m_state.vf[ftr])),
+                                                 std::max((qBits >> 23) & 0xFFu, (iBits >> 23) & 0xFFu));
+            if (operandExp >= 190u)
+                return false;
+            minExp = 26;
+        }
+        const __m128 vs = (Clean & 1u) ? _mm_loadu_ps(vu.m_state.vf[fsr]) : normalize4(_mm_loadu_ps(vu.m_state.vf[fsr]));
+        __m128 x;
+        switch (fop.src)
+        {
+        case SrcBc:
+            x = _mm_set1_ps((Clean & 2u) ? vu.m_state.vf[ftr][op & 3u] : vu.normalizeOperand(vu.m_state.vf[ftr][op & 3u]));
+            break;
+        case SrcQ:
+            x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.q));
+            break;
+        case SrcI:
+            x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.i));
+            break;
+        default:
+            x = (Clean & 2u) ? _mm_loadu_ps(vu.m_state.vf[ftr]) : normalize4(_mm_loadu_ps(vu.m_state.vf[ftr]));
+            break;
+        }
+        constexpr int laneMask = kReverse4[d];
+        const int zeroOperand = (fop.kind == FastMul || productSum) ? ((zeroLanes(vs) | zeroLanes(x)) & laneMask) : 0;
+        __m128 result;
+        int productSigns = 0;
+        int productZeros = 0;
+        switch (fop.kind)
+        {
+        case FastAdd:
+            result = _mm_add_ps(vs, x);
+            break;
+        case FastSub:
+            result = _mm_sub_ps(vs, x);
+            break;
+        case FastMul:
+            result = _mm_mul_ps(vs, x);
+            break;
+        default:
+        {
+            const __m128 product = _mm_mul_ps(vs, x);
+            if (unsafeLanes(product, 1) & laneMask & ~zeroOperand)
+                return false;
+            productSigns = _mm_movemask_ps(product) & laneMask;
+            productZeros = zeroOperand;
+            const __m128 acc = (Clean & 4u) ? _mm_loadu_ps(vu.m_state.acc) : normalize4(_mm_loadu_ps(vu.m_state.acc));
+            result = fop.kind == FastMadd ? _mm_add_ps(acc, product) : _mm_sub_ps(acc, product);
+            break;
+        }
+        }
+        const int zeros = zeroLanes(result) & laneMask;
+        int unsafe = unsafeLanes(result, minExp) & laneMask;
+        if (fop.kind == FastAdd || fop.kind == FastSub)
+            unsafe &= ~zeros;
+        else if (fop.kind == FastMul)
+            unsafe &= ~(zeros & zeroOperand);
+        else
+        {
+            const __m128i exp = _mm_srli_epi32(_mm_and_si128(_mm_castps_si128(result), _mm_set1_epi32(0x7F800000)), 23);
+            const int denormal = _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(exp, _mm_setzero_si128()))) & ~zeros;
+            unsafe &= ~(zeroOperand & ~denormal);
+        }
+        if (unsafe)
+            return false;
+        const int signs = _mm_movemask_ps(result) & laneMask;
+        const uint32_t extraSticky = (productSigns ? 0x2u : 0u) | (productZeros ? 0x1u : 0u);
+        if (lazy)
+        {
+            lazy->zeros = zeros;
+            lazy->signs = signs;
+            lazy->sticky |= (zeros ? 0x1u : 0u) | (signs ? 0x2u : 0u) | extraSticky;
+            lazy->pending = true;
+        }
+        else
+            commitFmacFlags(vu, zeros, signs, extraSticky);
+        storeLanes(toAcc ? vu.m_state.acc : vu.m_state.vf[fd(I)], result, laneMask);
+        return true;
+    }
+
+    // One upper instruction, flags committed at once.
+    template <uint32_t I>
+    static PS2X_VU1_INLINE void nUpper(Vu &vu)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr bool toAcc = op >= 0x3Cu;
+        constexpr uint32_t special = (I & 3u) | ((I >> 4) & 0x7Cu);
+        if constexpr (toAcc && (special == 0x2Fu || special == 0x30u))
+        {
+            vu.m_currentUpperInstruction = I; // NOP
+        }
+        else if constexpr (toAcc && special == 0x1Fu) // CLIP, as execUpperGeneric + queueClip
+        {
+            vu.m_currentUpperInstruction = I;
+            uint32_t wBits;
+            std::memcpy(&wBits, &vu.m_state.vf[ft(I)][3], 4);
+            const int32_t limit = (wBits & 0x7F800000u) != 0u ? static_cast<int32_t>(wBits & 0x7FFFFFFFu) : 0x007FFFFF;
+            uint32_t flags = 0u;
+            for (int c = 0; c < 3; ++c)
+            {
+                uint32_t bits;
+                std::memcpy(&bits, &vu.m_state.vf[fs(I)][c], 4);
+                if (static_cast<int32_t>(bits) > limit)
+                    flags |= 1u << (2 * c);
+                if (static_cast<int32_t>(bits ^ 0x80000000u) > limit)
+                    flags |= 2u << (2 * c);
+            }
+            vu.m_workingClip = ((vu.m_workingClip << 6) | flags) & 0xFFFFFFu;
+            vu.m_state.clip = vu.m_workingClip;
+        }
+        else
+        {
+            if (simple(vu, I, op, toAcc, special))
+                return;
+            constexpr FastOp fop = kFastOps[toAcc ? special : op];
+            if constexpr (fop.kind != FastNone)
+            {
+                if (fmacNow<I>(vu, fop, toAcc))
+                    return;
+            }
+            vu.execUpperGeneric(I);
+            commitAllNow(vu);
+        }
+    }
+
+    // Any lower instruction through the interpreter, committed at once.
+    template <uint32_t L>
+    static inline void nLowerGeneric(Vu &vu, uint8_t *data, uint32_t dataSize)
+    {
+        vu.execLower(L, data, dataSize, *vu.m_activeGs, vu.m_activeMemory, 0u);
+        commitAllNow(vu);
+    }
+
+    // XGKICK: the whole packet goes out now (the interpreter copies it over
+    // the next cycles; the generator only allows kicks with no VU memory
+    // store before the program ends).
+    static inline void nKick(Vu &vu, int32_t vi)
+    {
+        if (vu.m_xgkick.active)
+            vu.progressXgkickCycles(~0u >> 2);
+        vu.startXgkick(static_cast<uint32_t>(static_cast<uint16_t>(vi)));
+        while (vu.m_xgkick.active)
+            vu.progressXgkickCycles(~0u >> 2);
+    }
+
+    // Leave native code at pc: the interpreter continues from there.
+    static PS2X_VU1_INLINE bool nHandoff(Vu &vu, uint32_t pc, uint64_t pairs)
+    {
+        vu.m_state.pc = pc;
+        vu.m_cycle += pairs;
+        vu.m_state.cycles = vu.m_cycle;
+        return false;
+    }
+
+    // Program ended (E-bit pair and its delay pair done); pc = next pair.
+    static PS2X_VU1_INLINE bool nEnd(Vu &vu, uint32_t pc, uint64_t pairs)
+    {
+        vu.m_state.pc = pc;
+        vu.m_cycle += pairs;
+        vu.m_state.cycles = vu.m_cycle;
+        return true;
+    }
+
+    // Lazy MAC/status for native programs: a fast FMAC op keeps its zero and
+    // sign lanes here and ORs in its sticky bits; nFlush writes MAC and status
+    // exactly as committing the ops one after another would (MAC and the low
+    // status bits are the last op's, the sticky bits accumulate). Generated
+    // code flushes before anything that reads or writes them and at exits.
+    static PS2X_VU1_INLINE void nFlush(Vu &vu, LazyFlags &lf)
+    {
+        using namespace vu1fast;
+        if (!lf.pending)
+            return;
+        lf.pending = false;
+        vu.m_state.mac = static_cast<uint32_t>(kReverse4[lf.zeros]) | (static_cast<uint32_t>(kReverse4[lf.signs]) << 4);
+        const uint32_t current = (lf.zeros ? 0x1u : 0u) | (lf.signs ? 0x2u : 0u);
+        vu.m_state.status = (vu.m_state.status & 0xFF0u) | current | (lf.sticky << 6);
+        lf.sticky = 0;
+    }
+
+    // nUpper with lazy flags (see LazyFlags).
+    template <uint32_t I, uint32_t Clean = 0u>
+    static PS2X_VU1_INLINE void nUpperL(Vu &vu, LazyFlags &lf)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr bool toAcc = op >= 0x3Cu;
+        constexpr uint32_t special = (I & 3u) | ((I >> 4) & 0x7Cu);
+        if constexpr ((toAcc && (special == 0x2Fu || special == 0x30u)) || (toAcc && special == 0x1Fu))
+        {
+            nUpper<I>(vu); // NOP, CLIP: no MAC/status
+        }
+        else
+        {
+            if (simple(vu, I, op, toAcc, special))
+                return;
+            constexpr FastOp fop = kFastOps[toAcc ? special : op];
+            if constexpr (fop.kind != FastNone)
+            {
+                if (fmacNow<I, Clean>(vu, fop, toAcc, &lf))
+                    return;
+            }
+            nFlush(vu, lf);
+            vu.execUpperGeneric(I);
+            commitAllNow(vu);
+        }
+    }
+
+    static PS2X_VU1_INLINE bool nHandoffL(Vu &vu, LazyFlags &lf, uint32_t pc, uint64_t pairs)
+    {
+        nFlush(vu, lf);
+        return nHandoff(vu, pc, pairs);
+    }
+
+    static PS2X_VU1_INLINE bool nEndL(Vu &vu, LazyFlags &lf, uint32_t pc, uint64_t pairs)
+    {
+        nFlush(vu, lf);
+        return nEnd(vu, pc, pairs);
+    }
+
+
+    // ---- Register form (native programs keep VF registers and ACC in locals;
+    // see port/tools/vu1prog.py). Same checks, maths and flags as fmacNow /
+    // simple / nUpper's CLIP, on values instead of VU state. ----
+
+    PS2X_VU1_INLINE static uint32_t maxExponentV(__m128 v)
+    {
+        __m128i e = _mm_and_si128(_mm_castps_si128(v), _mm_set1_epi32(0x7F800000));
+        e = _mm_max_epu32(e, _mm_shuffle_epi32(e, 0x4E));
+        e = _mm_max_epu32(e, _mm_shuffle_epi32(e, 0xB1));
+        return static_cast<uint32_t>(_mm_cvtsi128_si32(e)) >> 23;
+    }
+
+    template <int Lane>
+    PS2X_VU1_INLINE static __m128 splat(__m128 v)
+    {
+        return _mm_shuffle_ps(v, v, Lane * 0x55);
+    }
+
+    template <uint32_t I, uint32_t Clean>
+    static PS2X_VU1_INLINE bool fmacR(Vu &vu, vu1fast::FastOp fop, bool toAcc, __m128 vsIn, __m128 vtIn, __m128 &acc,
+                                      __m128 &dst, LazyFlags &lf)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr uint8_t d = dest(I);
+        if constexpr (d == 0u)
+            return true;
+        const bool productSum = fop.kind == FastMadd || fop.kind == FastMsub;
+        int minExp = 1;
+        if (productSum)
+        {
+            uint32_t qBits, iBits;
+            std::memcpy(&qBits, &vu.m_state.q, 4);
+            std::memcpy(&iBits, &vu.m_state.i, 4);
+            const uint32_t operandExp = std::max(std::max(maxExponentV(vsIn), maxExponentV(vtIn)),
+                                                 std::max((qBits >> 23) & 0xFFu, (iBits >> 23) & 0xFFu));
+            if (operandExp >= 190u)
+                return false;
+            minExp = 26;
+        }
+        const __m128 vs = (Clean & 1u) ? vsIn : normalize4(vsIn);
+        __m128 x;
+        switch (fop.src)
+        {
+        case SrcBc:
+            x = splat<static_cast<int>(op & 3u)>(vtIn);
+            if (!(Clean & 2u))
+                x = normalize4(x);
+            break;
+        case SrcQ:
+            x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.q));
+            break;
+        case SrcI:
+            x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.i));
+            break;
+        default:
+            x = (Clean & 2u) ? vtIn : normalize4(vtIn);
+            break;
+        }
+        constexpr int laneMask = kReverse4[d];
+        const int zeroOperand = (fop.kind == FastMul || productSum) ? ((zeroLanes(vs) | zeroLanes(x)) & laneMask) : 0;
+        __m128 result;
+        int productSigns = 0;
+        int productZeros = 0;
+        switch (fop.kind)
+        {
+        case FastAdd:
+            result = _mm_add_ps(vs, x);
+            break;
+        case FastSub:
+            result = _mm_sub_ps(vs, x);
+            break;
+        case FastMul:
+            result = _mm_mul_ps(vs, x);
+            break;
+        default:
+        {
+            const __m128 product = _mm_mul_ps(vs, x);
+            if (unsafeLanes(product, 1) & laneMask & ~zeroOperand)
+                return false;
+            productSigns = _mm_movemask_ps(product) & laneMask;
+            productZeros = zeroOperand;
+            const __m128 a = (Clean & 4u) ? acc : normalize4(acc);
+            result = fop.kind == FastMadd ? _mm_add_ps(a, product) : _mm_sub_ps(a, product);
+            break;
+        }
+        }
+        const int zeros = zeroLanes(result) & laneMask;
+        int unsafe = unsafeLanes(result, minExp) & laneMask;
+        if (fop.kind == FastAdd || fop.kind == FastSub)
+            unsafe &= ~zeros;
+        else if (fop.kind == FastMul)
+            unsafe &= ~(zeros & zeroOperand);
+        else
+        {
+            const __m128i exp = _mm_srli_epi32(_mm_and_si128(_mm_castps_si128(result), _mm_set1_epi32(0x7F800000)), 23);
+            const int denormal = _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(exp, _mm_setzero_si128()))) & ~zeros;
+            unsafe &= ~(zeroOperand & ~denormal);
+        }
+        if (unsafe)
+            return false;
+        const int signs = _mm_movemask_ps(result) & laneMask;
+        lf.zeros = zeros;
+        lf.signs = signs;
+        lf.sticky |= (zeros ? 0x1u : 0u) | (signs ? 0x2u : 0u) | (productSigns ? 0x2u : 0u) | (productZeros ? 0x1u : 0u);
+        lf.pending = true;
+        (void)toAcc;
+        dst = _mm_blend_ps(dst, result, laneMask);
+        return true;
+    }
+
+    // MAX/MINI/ITOF/FTOI/ABS on values (as simple()); false = not one of them.
+    template <uint32_t I>
+    static PS2X_VU1_INLINE bool simpleR(Vu &vu, __m128 vsIn, __m128 vtIn, __m128 &dst)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr bool special4 = op >= 0x3Cu;
+        constexpr uint32_t special = (I & 3u) | ((I >> 4) & 0x7Cu);
+        constexpr int laneMask = kReverse4[dest(I)];
+        if constexpr (!special4)
+        {
+            constexpr bool isMax = (op >= 0x10u && op <= 0x13u) || op == 0x1Du || op == 0x2Bu;
+            constexpr bool isMin = (op >= 0x14u && op <= 0x17u) || op == 0x1Fu || op == 0x2Fu;
+            if constexpr (!isMax && !isMin)
+                return false;
+            else
+            {
+                vu.m_currentUpperInstruction = I;
+                const __m128 vs = normalize4(vsIn);
+                __m128 x;
+                if constexpr (op <= 0x17u)
+                    x = normalize4(splat<static_cast<int>(op & 3u)>(vtIn));
+                else if constexpr (op == 0x1Du || op == 0x1Fu)
+                    x = _mm_set1_ps(vu.normalizeOperand(vu.m_state.i));
+                else
+                    x = normalize4(vtIn);
+                dst = _mm_blend_ps(dst, isMax ? _mm_max_ps(vs, x) : _mm_min_ps(vs, x), laneMask);
+                return true;
+            }
+        }
+        else if constexpr (special >= 0x10u && special <= 0x13u) // ITOF
+        {
+            vu.m_currentUpperInstruction = I;
+            __m128 value = _mm_cvtepi32_ps(_mm_castps_si128(vsIn));
+            if constexpr (special != 0x10u)
+                value = _mm_div_ps(value, _mm_set1_ps(kIntScale[special & 3u]));
+            dst = _mm_blend_ps(dst, value, laneMask);
+            return true;
+        }
+        else if constexpr (special >= 0x14u && special <= 0x17u) // FTOI
+        {
+            vu.m_currentUpperInstruction = I;
+            alignas(16) float in[4];
+            _mm_store_ps(in, vsIn);
+            alignas(16) int32_t out[4];
+            for (int c = 0; c < 4; ++c)
+                out[c] = vuFloatToInt(vu.normalizeOperand(in[c]), kIntScale[special & 3u]);
+            dst = _mm_blend_ps(dst, _mm_castsi128_ps(_mm_load_si128(reinterpret_cast<const __m128i *>(out))), laneMask);
+            return true;
+        }
+        else if constexpr (special == 0x1Du) // ABS
+        {
+            vu.m_currentUpperInstruction = I;
+            dst = _mm_blend_ps(dst, _mm_andnot_ps(_mm_set1_ps(-0.0f), normalize4(vsIn)), laneMask);
+            return true;
+        }
+        else
+            return false;
+    }
+
+    // CLIP on values (as nUpper's CLIP).
+    template <uint32_t I>
+    static PS2X_VU1_INLINE void clipR(Vu &vu, __m128 vs, __m128 vt)
+    {
+        vu.m_currentUpperInstruction = I;
+        alignas(16) uint32_t sb[4], tb[4];
+        _mm_store_ps(reinterpret_cast<float *>(sb), vs);
+        _mm_store_ps(reinterpret_cast<float *>(tb), vt);
+        const uint32_t wBits = tb[3];
+        const int32_t limit = (wBits & 0x7F800000u) != 0u ? static_cast<int32_t>(wBits & 0x7FFFFFFFu) : 0x007FFFFF;
+        uint32_t flags = 0u;
+        for (int c = 0; c < 3; ++c)
+        {
+            if (static_cast<int32_t>(sb[c]) > limit)
+                flags |= 1u << (2 * c);
+            if (static_cast<int32_t>(sb[c] ^ 0x80000000u) > limit)
+                flags |= 2u << (2 * c);
+        }
+        vu.m_workingClip = ((vu.m_workingClip << 6) | flags) & 0xFFFFFFu;
+        vu.m_state.clip = vu.m_workingClip;
+    }
+
+    // Anything else, or a fast op that must take the exact path: the
+    // registers it touches go to VU state, the interpreter runs it, and the
+    // destination and ACC come back.
+    // Values in, values out: no local's address leaves the generated function,
+    // so the compiler can keep the VF registers in CPU registers.
+    struct SlowOut
+    {
+        __m128 acc, dst;
+    };
+    template <uint32_t I>
+    static __attribute__((noinline, cold)) SlowOut upperSlowR(Vu &vu, LazyFlags lf, __m128 vs, __m128 vt, __m128 acc,
+                                                             __m128 dst, int dstReg)
+    {
+        using namespace vu1fast;
+        nFlush(vu, lf);
+        _mm_storeu_ps(vu.m_state.vf[fs(I)], vs);
+        _mm_storeu_ps(vu.m_state.vf[ft(I)], vt);
+        _mm_storeu_ps(vu.m_state.acc, acc);
+        if (dstReg > 0)
+            _mm_storeu_ps(vu.m_state.vf[dstReg], dst);
+        vu.execUpperGeneric(I);
+        commitAllNow(vu);
+        SlowOut out;
+        out.acc = _mm_loadu_ps(vu.m_state.acc);
+        out.dst = out.acc; // ACC forms: dst is ACC
+        if (dstReg > 0)
+            out.dst = _mm_loadu_ps(vu.m_state.vf[dstReg]);
+        else if (dstReg == 0)
+        {
+            vu.m_state.vf[0][0] = vu.m_state.vf[0][1] = vu.m_state.vf[0][2] = 0.0f; // vf0 is constant
+            vu.m_state.vf[0][3] = 1.0f;
+        }
+        return out;
+    }
+
+    // One upper instruction on locals. dst is the register it writes (ACC
+    // for the ACC forms; any scratch when it writes nothing); dstReg its VF
+    // number (-1 = ACC or none), for the slow path.
+    template <uint32_t I, uint32_t Clean, int DstReg>
+    static PS2X_VU1_INLINE void nUpperR(Vu &vu, LazyFlags &lf, __m128 vs, __m128 vt, __m128 &acc, __m128 &dst)
+    {
+        using namespace vu1fast;
+        constexpr uint32_t op = I & 0x3Fu;
+        constexpr bool toAcc = op >= 0x3Cu;
+        constexpr uint32_t special = (I & 3u) | ((I >> 4) & 0x7Cu);
+        if constexpr (toAcc && (special == 0x2Fu || special == 0x30u))
+        {
+            vu.m_currentUpperInstruction = I; // NOP
+        }
+        else if constexpr (toAcc && special == 0x1Fu)
+        {
+            clipR<I>(vu, vs, vt);
+        }
+        else
+        {
+            if (simpleR<I>(vu, vs, vt, dst))
+                return;
+            constexpr FastOp fop = kFastOps[toAcc ? special : op];
+            if constexpr (fop.kind != FastNone)
+            {
+                vu.m_currentUpperInstruction = I;
+                if (fmacR<I, Clean>(vu, fop, toAcc, vs, vt, acc, dst, lf))
+                    return;
+            }
+            const SlowOut out = upperSlowR<I>(vu, lf, vs, vt, acc, dst, DstReg);
+            lf.pending = false; // flushed there
+            lf.sticky = 0u;
+            acc = out.acc;
+            dst = out.dst;
+        }
+    }
+
+};
+
+// Registry of native programs, keyed by the entry pc and a hash of exactly
+// the code pairs the program was compiled from (vu1native::codeHash over its
+// ranges, mirrored in vu1prog.py), so leftover microcode elsewhere in VU1
+// memory does not matter.
+namespace vu1native
+{
+    // Returns true when the program ended; false = continue in the
+    // interpreter at state().pc.
+    using ProgramFn = bool (*)(VU1Interpreter &vu, uint8_t *data, uint32_t dataSize, uint64_t maxPairs);
+    struct ProgramEntry
+    {
+        uint64_t codeHash;       // codeHash over ranges
+        uint32_t pc;             // entry pc
+        const uint16_t *ranges;  // [start, end) byte pairs
+        uint32_t rangeCount;
+        ProgramFn fn;            // sequential code, for diagnostic replay
+        bool scheduled = false; // use the shared scheduler over the hashed ranges
+    };
+    void registerPrograms(const ProgramEntry *entries, size_t count);
+    size_t programCount();
+    // PS2X_VU1_PROGRAMS=1 opts the offline replayer into scheduled regions.
+    void setEnabled(bool on);
+    bool enabled();
+
+    inline uint64_t codeHash(const uint8_t *code, const uint16_t *ranges, uint32_t rangeCount)
+    {
+        uint64_t h = 0x243F6A8885A308D3ull;
+        for (uint32_t r = 0; r < rangeCount; ++r)
+            for (uint32_t i = ranges[2 * r]; i + 8u <= ranges[2 * r + 1]; i += 8u)
+            {
+                uint64_t w;
+                std::memcpy(&w, code + i, 8);
+                h ^= w;
+                h = ((h << 29) | (h >> 35)) * 0x9E3779B97F4A7C15ull;
+            }
+        return h;
+    }
+}
+
+#endif
