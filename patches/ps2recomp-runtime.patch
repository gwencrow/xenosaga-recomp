+        };
+        const auto r = runScript(rig, g_fixtures / "scaling-v2", t);
+        compareWithReference(r, g_ref / "v2-native", "v2-native-split-variant" + std::to_string(variant));
+    }
+
+    std::printf("[ingress] REGLIST continuation\n");
+    {
+        // Minimal scene: CT32 frame at 0, 64 wide, then a REGLIST sprite (PRIM, RGBAQ, XYZ2, XYZ2).
+        auto setup = adPacket({{0x4C, (0ull) | (1ull << 16)},                 // FRAME_1 fbp 0 fbw 1 (64)
+                               {0x40, (63ull << 16) | (63ull << 48)},         // SCISSOR_1 0..63
+                               {0x18, 0},                                     // XYOFFSET_1
+                               {0x47, 0},                                     // TEST_1 off
+                               {0x4E, 1ull << 32}});                          // ZBUF_1 ZMSK
+        std::vector<uint8_t> reglist;
+        put64(reglist, gifTag(1, true, 1, 4));
+        put64(reglist, 0x0 | (0x1 << 4) | (0x5 << 8) | (0x5 << 12)); // PRIM RGBAQ XYZ2 XYZ2
+        put64(reglist, 6);                                            // PRIM sprite
+        put64(reglist, 0x80FF4020ull);                                // RGBAQ
+        put64(reglist, (4ull << 4) | ((4ull << 4) << 16));            // XYZ2 (4,4)
+        put64(reglist, (40ull << 4) | ((30ull << 4) << 16));          // XYZ2 (40,30)
+        auto finish = adPacket({{0x61, 0}});
+        std::vector<uint8_t> whole, split;
+        {
+            Rig rig(1);
+            rig.gif(2, setup);
+            rig.gif(2, reglist);
+            rig.gif(2, finish);
+            whole = rig.vramSnapshot();
+        }
+        {
+            Rig rig(1);
+            rig.gif(2, setup);
+            rig.gif(2, std::vector<uint8_t>(reglist.begin(), reglist.begin() + 32)); // tag + PRIM/RGBAQ
+            rig.gif(0, nop());
+            rig.gif(2, std::vector<uint8_t>(reglist.begin() + 32, reglist.end()));   // XYZ2 XYZ2
+            rig.gif(2, finish);
+            split = rig.vramSnapshot();
+        }
+        uint32_t px = 0;
+        if (whole.size() >= 64 * 4 * 64)
+        {
+            // CT32 page layout: pixel (10,10) is inside the sprite; read via the runtime helpers.
+            std::vector<uint8_t> copy = whole;
+            px = GSMem::ReadCT32(copy.data(), 0, 1, 10, 10);
+        }
+        check(px == 0x80FF4020u, "REGLIST sprite drawn (pixel 0x" + [&] { char b[16]; std::snprintf(b, 16, "%08x", px); return std::string(b); }() + ")");
+        check(!whole.empty() && whole == split, "REGLIST split across transfers with PATH1 interleaved == unsplit");
+    }
+
+    std::printf("[csr] SIGNAL / LABEL / FINISH in stream order across paths\n");
+    {
+        Rig rig(1);
+        rig.gif(2, adPacket({{0x60, 1ull | (0xFFFFFFFFull << 32)}})); // SIGNAL id 1 (PATH3)
+        rig.gif(0, adPacket({{0x60, 2ull | (0xFFFFFFFFull << 32)}})); // SIGNAL id 2 (PATH1, later)
+        rig.gif(1, adPacket({{0x62, 0x55ull | (0xFFull << 32)}}));    // LABEL low byte 0x55 (PATH2)
+        rig.gs.sync();
+        check((rig.regs.siglblid & 0xFFFFFFFFull) == 2, "SIGLBLID.SIGID follows submission order (2)");
+        check((rig.regs.siglblid >> 32) == 0x55, "SIGLBLID.LBLID masked update (0x55)");
+        check((rig.regs.csr.load() & 0x1) != 0, "CSR.SIGNAL set");
+        check((rig.regs.csr.load() & 0x2) == 0, "CSR.FINISH not set before any FINISH");
+        rig.gs.writeRegister(0x61, 0); // HLE register write route
+        rig.gs.sync();
+        check((rig.regs.csr.load() & 0x2) != 0, "FINISH via GS::writeRegister sets CSR.FINISH");
+    }
+
+    std::printf("[vram] guest pixel access and local->host ordering\n");
+    {
+        Rig rig(1);
+        rig.gs.WriteVram(0, 0x100, 1, 5, 7, 0x12345678u);
+        check(rig.gs.ReadVram(0, 0x100, 1, 5, 7) == 0x12345678u, "WriteVram/ReadVram round trip through the device");
+        const auto snap = rig.vramSnapshot();
+        std::vector<uint8_t> copy = snap;
+        check(snap.size() == PS2_GS_VRAM_SIZE && GSMem::ReadCT32(copy.data(), 0x100, 1, 5, 7) == 0x12345678u,
+              "VRAM snapshot sees the device-side write");
+        check(rig.gs.droppedClearCount() == 0, "no HLE clears skipped in this scenario");
+    }
+
+    std::printf("[present] cadence: identical vsyncs skipped, frame kept; new drawing produces a new frame\n");
+    {
+        Rig rig(1);
+        const auto r = runScript(rig, g_fixtures / "scaling-v2");
+        rig.gs.gifDeviceStatsReport(); // reset counters
+        std::vector<uint8_t> before, after;
+        uint32_t w = 0, h = 0, w2 = 0, h2 = 0;
+        rig.gs.copyLatchedHiresFrame(before, w, h);
+        for (int i = 0; i < 10; ++i)
+        {
+            rig.gs.latchHostPresentationFrame();
+            rig.gs.sync();
+        }
+        const std::string stats = rig.gs.gifDeviceStatsReport();
+        const auto at = stats.find("skipped ");
+        const int skipped = at == std::string::npos ? -1 : std::atoi(stats.c_str() + at + 8);
+        check(skipped >= 9, "identical scanouts skipped (" + std::to_string(skipped) + " of 10)");
+        check(rig.gs.copyLatchedHiresFrame(after, w2, h2) && after == before && !before.empty(),
+              "the latched frame is kept unchanged while skipping");
+        // Draw: a REGLIST sprite into the displayed buffer changes the next scanout.
+        std::vector<uint8_t> sprite;
+        put64(sprite, gifTag(1, true, 1, 4));
+        put64(sprite, 0x0 | (0x1 << 4) | (0x5 << 8) | (0x5 << 12));
+        put64(sprite, 6);
+        put64(sprite, 0x80123456ull);
+        put64(sprite, (0ull << 4) | ((0ull << 4) << 16));
+        put64(sprite, (64ull << 4) | ((64ull << 4) << 16));
+        // FRAME_1 = the displayed buffer (DISPFB1.FBP, 64 pixels wide).
+        rig.gif(2, adPacket({{0x4C, (rig.regs.dispfb1 & 0x1FFull) | (1ull << 16)}, {0x40, (63ull << 16) | (63ull << 48)},
+                             {0x18, 0}, {0x47, 0}, {0x4E, 1ull << 32}}));
+        rig.gif(2, sprite);
+        std::vector<uint8_t> drawn;
+        const uint64_t v[6] = {rig.regs.pmode, rig.regs.smode1, rig.regs.smode2, rig.regs.dispfb1, rig.regs.display1,
+                               rig.regs.bgcolor};
+        // No VRAM access or sync here on purpose: the scanout itself must include the open batch.
+        const bool got = rig.scanout(v, drawn, w2, h2);
+        size_t diffs = 0;
+        for (size_t i = 0; i < std::min(drawn.size(), before.size()); ++i)
+            diffs += drawn[i] != before[i];
+        std::printf("  diag: got=%d size %zu vs %zu, %zu differing bytes\n", int(got), drawn.size(), before.size(), diffs);
+        std::printf("%s", rig.gs.gifDeviceStatsReport().c_str());
+        check(got && drawn != before, "a draw after the skipped vsyncs yields a new frame");
+        (void)r;
+    }
+
+    std::printf("[lifetime] repeated install/shutdown and destruction with a device installed\n");
+    {
+        std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0);
+        GSRegisters regs{};
+        GS gs;
+        gs.init(vram.data(), uint32_t(vram.size()), &regs);
+        gs.setAsync(true);
+        bool allOk = true;
+        for (int i = 0; i < 3; ++i)
+        {
+            std::string err;
+            PgsDeviceConfig cfg{};
+            cfg.privRegs = &regs;
+            cfg.validation = g_validation;
+            const bool ok = gs.installGifDevice([&](std::string &e) { return ps2x_createPgsDevice(cfg, e, nullptr); }, err);
+            allOk = allOk && ok && gs.hasGifDevice();
+            auto head = readFile(g_fixtures / "split" / "image-head.bin");
+            gs.processGIFPacket(GifPathId::Path3, head.data(), uint32_t(head.size())); // incomplete IMAGE
+            gs.shutdownGifDevice();
+            allOk = allOk && !gs.hasGifDevice();
+        }
+        check(allOk, "3 install/shutdown cycles, each with an incomplete IMAGE transfer pending");
+        std::string err;
+        PgsDeviceConfig cfg{};
+        cfg.privRegs = &regs;
+        check(gs.installGifDevice([&](std::string &e) { return ps2x_createPgsDevice(cfg, e, nullptr); }, err),
+              "re-install before destruction");
+        // GS destructor -> setAsync(false) -> shutdownGifDevice on the worker.
+    }
+    check(true, "GS destroyed with a device installed (no hang)");
+
+    std::printf("SUMMARY: %d checks, %d failures%s\n", g_checks, g_failures, g_validation ? " (validation layer on)" : "");
+    std::printf("VK RUNTIME TESTS: %s\n", g_failures ? "FAIL" : "PASS");
+    return g_failures ? 1 : 0;
+}
diff --git a/ps2xTest/a04/a04_rig.h b/ps2xTest/a04/a04_rig.h
new file mode 100644
index 0000000..78d6a09
--- /dev/null
+++ b/ps2xTest/a04/a04_rig.h
@@ -0,0 +1,390 @@
+// Test rig: a real PS2Runtime (memory, GIF DMA channel, arbiter, GS frontend, async worker)
+// with the paraLLEl-GS Vulkan device installed the way PS2Runtime::initialize installs it, driven
+// through the HLE kernel stubs the game binary is bound to (sceGsResetGraph 0x209410,
+// sceGsGetGParam 0x2095a0, sceGsPutDispEnv 0x209888, SetGsCrt 0x200120) and guest MMIO writes.
+//
+// Compiles against a runtime without teardown stages too (negative control): those APIs are guarded by
+// PS2X_GS_DEVICE_TEARDOWN_STAGES.
+#pragma once
+
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "ps2_stubs.h"
+#include "ps2_syscalls.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/gs_pgs_device.h"
+#include "runtime/ps2_memory.h"
+
+#include "context.hpp" // Granite (validation canary only)
+
+#include <chrono>
+#include <cstdio>
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace a04
+{
+inline int g_failures = 0, g_checks = 0;
+
+inline void check(bool ok, const std::string &what)
+{
+    ++g_checks;
+    if (!ok)
+        ++g_failures;
+    std::printf("  %s: %s\n", ok ? "ok" : "FAIL", what.c_str());
+    std::fflush(stdout);
+}
+
+inline void info(const std::string &what)
+{
+    std::printf("  info: %s\n", what.c_str());
+    std::fflush(stdout);
+}
+
+// ---- GS register encodings (GS User's Manual field layout; same as paraLLEl-GS gs_registers.hpp) ----
+constexpr uint32_t kGsPmode = 0x12000000u, kGsSmode1 = 0x12000010u, kGsSmode2 = 0x12000020u;
+constexpr uint32_t kGsDispfb1 = 0x12000070u, kGsDisplay1 = 0x12000080u, kGsDispfb2 = 0x12000090u,
+                   kGsDisplay2 = 0x120000A0u;
+constexpr uint32_t kGsExtbuf = 0x120000B0u, kGsExtdata = 0x120000C0u, kGsExtwrite = 0x120000D0u;
+
+inline uint64_t makeDispfb(uint32_t fbp, uint32_t fbw, uint32_t psm)
+{
+    return uint64_t(fbp & 0x1FF) | (uint64_t(fbw & 0x3F) << 9) | (uint64_t(psm & 0x1F) << 15);
+}
+inline uint64_t makeDisplay(uint32_t dx, uint32_t dy, uint32_t magh, uint32_t magv, uint32_t dw, uint32_t dh)
+{
+    return uint64_t(dx & 0xFFF) | (uint64_t(dy & 0x7FF) << 12) | (uint64_t(magh & 0xF) << 23) |
+           (uint64_t(magv & 0x3) << 27) | (uint64_t(dw & 0xFFF) << 32) | (uint64_t(dh & 0x7FF) << 44);
+}
+inline uint32_t smode1Cmod(uint64_t v) { return uint32_t(v >> 13) & 3u; }
+inline uint32_t smode1Lc(uint64_t v) { return uint32_t(v >> 3) & 0x7Fu; }
+
+// libgraph sceGsGParam as served by sceGsGetGParam.
+struct GParam
+{
+    int16_t interlace = 0, omode = 0, ffmode = 0, version = 0;
+};
+
+// The DispEnv that libgraph sceGsSetDefDispEnv (0x209618) builds, decoded from the retail
+// instructions (disassembly of the retail function): PMODE 0x66; SMODE2 = 2 when not
+// interlaced, else 3 (frame) / 1 (field); DISPFB FBW=(w+63)/64, PSM; DISPLAY MAGH=(w+2559)/w-1,
+// DW=(MAGH+1)*w-1, NTSC DX=636+dx DY=(interlaced?50:25)+dy, PAL DX=656+dx DY=(interlaced?72:36)+dy,
+// DH = h-1 (2h-1 in interlaced frame mode). The function itself is recompiled game code (not
+// linkable here); the test reproduces its output so the HLE stubs downstream see the same input.
+struct DispEnv
+{
+    uint64_t pmode = 0, smode2 = 0, dispfb = 0, display = 0, bgcolor = 0;
+};
+
+inline DispEnv libgraphDefDispEnv(const GParam &gp, uint32_t psm, uint32_t w, uint32_t h, uint32_t dx, uint32_t dy)
+{
+    DispEnv e;
+    e.pmode = 0x66;
+    e.smode2 = gp.interlace == 0 ? 2u : (gp.ffmode != 0 ? 3u : 1u);
+    e.dispfb = makeDispfb(0, (w + 63) / 64, psm);
+    const uint32_t mag = (w + 2559u) / w;
+    const uint32_t dh = (gp.interlace == 1 && gp.ffmode != 0) ? 2 * h - 1 : h - 1;
+    if (gp.omode == 2)
+        e.display = makeDisplay(636 + dx, (gp.interlace == 1 ? 50 : 25) + dy, mag - 1, 0, mag * w - 1, dh);
+    else if (gp.omode == 3)
+        e.display = makeDisplay(656 + dx, (gp.interlace == 1 ? 72 : 36) + dy, mag - 1, 0, mag * w - 1, dh);
+    return e;
+}
+
+// Device statistics accumulated from GS::gifDeviceStatsReport() (each call resets the device's).
+struct Totals
+{
+    unsigned long long presents = 0, empty = 0, skipped = 0, readbacks = 0, published = 0, unsupported = 0;
+    unsigned long long outW = 0, outH = 0;
+    std::string videoMode;
+
+    void absorb(const std::string &report)
+    {
+        size_t at = report.find("gs-vk present ");
+        if (at != std::string::npos)
+        {
+            unsigned long long p = 0, e = 0, s = 0, r = 0, w = 0, pub = 0, ow = 0, oh = 0;
+            double v = 0, rw = 0, cv = 0;
+            if (std::sscanf(report.c_str() + at,
+                            "gs-vk present %llu (vsync %lf ms, empty %llu, skipped %llu), readback submit %llu wait %llu "
+                            "(%lf ms), published %llu (convert %lf ms), out %llux%llu",
+                            &p, &v, &e, &s, &r, &w, &rw, &pub, &cv, &ow, &oh) == 11)
+            {
+                presents += p;
+                empty += e;
+                skipped += s;
+                readbacks += r;
+                published += pub;
+                outW = ow;
+                outH = oh;
+            }
+        }
+        at = report.find("unsupported-mode scanouts ");
+        if (at != std::string::npos)
+        {
+            unsigned long long u = 0;
+            if (std::sscanf(report.c_str() + at, "unsupported-mode scanouts %llu", &u) == 1)
+                unsupported += u;
+        }
+        at = report.find("gs-vk video mode ");
+        if (at != std::string::npos)
+        {
+            const size_t from = at + std::strlen("gs-vk video mode ");
+            const size_t to = report.find(" (SMODE1", from);
+            videoMode = report.substr(from, to == std::string::npos ? std::string::npos : to - from);
+        }
+    }
+};
+
+struct Frame
+{
+    std::vector<uint8_t> rgba;
+    uint32_t w = 0, h = 0;
+    bool ok = false;
+
+    // RGB at a position given as a fraction of the picture.
+    void at(double fx, double fy, int out[3]) const
+    {
+        const uint32_t x = std::min<uint32_t>(w - 1, uint32_t(fx * w)), y = std::min<uint32_t>(h - 1, uint32_t(fy * h));
+        const uint8_t *p = rgba.data() + (size_t(y) * w + x) * 4u;
+        out[0] = p[0];
+        out[1] = p[1];
+        out[2] = p[2];
+    }
+    bool near(double fx, double fy, int r, int g, int b, int tol = 3) const
+    {
+        if (!ok || w == 0 || h == 0)
+            return false;
+        int c[3];
+        at(fx, fy, c);
+        return std::abs(c[0] - r) <= tol && std::abs(c[1] - g) <= tol && std::abs(c[2] - b) <= tol;
+    }
+    std::string describe(double fx, double fy) const
+    {
+        if (!ok || w == 0 || h == 0)
+            return "no frame";
+        int c[3];
+        at(fx, fy, c);
+        char buf[64];
+        std::snprintf(buf, sizeof(buf), "(%d,%d,%d)", c[0], c[1], c[2]);
+        return buf;
+    }
+};
+
+struct Color
+{
+    uint8_t r, g, b;
+};
+
+// The configuration PS2Runtime::initialize builds for renderer = vulkan (ps2_runtime.cpp).
+inline PgsDeviceConfig runtimeDeviceConfig(PS2Runtime &rt, int samples, bool progressive, bool validation,
+                                           bool idleFlush = false)
+{
+    PgsDeviceConfig cfg{};
+    cfg.samples = samples;
+    cfg.validation = validation;
+    cfg.forceProgressive = progressive;
+    cfg.idleFlush = idleFlush;
+    cfg.gpuTimestamps = false;
+    cfg.initialVram = rt.memory().getGSVRAM();
+    cfg.vramSize = static_cast<uint32_t>(PS2_GS_VRAM_SIZE);
+    cfg.privRegs = &rt.memory().gs();
+    return cfg;
+}
+
+class RuntimeRig
+{
+public:
+    std::unique_ptr<PS2Runtime> rt = std::make_unique<PS2Runtime>();
+    PgsDeviceInfo info;
+    std::string error;
+    bool ok = false;
+    Totals totals;
+
+    static constexpr uint32_t kPacketAddr = 0x00E00000u; // GIF DMA source (guest RAM, unused by the rig otherwise)
+    static constexpr uint32_t kEnvAddr = 0x00F00000u;    // guest DispEnv
+
+    explicit RuntimeRig(int samples, bool progressive = true, bool validation = false, bool install = true,
+                        bool idleFlush = false)
+    {
+        if (!rt->memory().initialize() || !rt->syncCoreSubsystems())
+        {
+            error = "runtime memory/core initialization failed";
+            return;
+        }
+        if (install)
+            ok = installDevice(samples, progressive, validation, idleFlush);
+        else
+            ok = true;
+    }
+
+    bool installDevice(int samples, bool progressive, bool validation, bool idleFlush = false)
+    {
+        const PgsDeviceConfig cfg = runtimeDeviceConfig(*rt, samples, progressive, validation, idleFlush);
+        rt->gs().setAsync(true);
+        const bool installed = rt->gs().installGifDevice(
+            [&](std::string &e) { return ps2x_createPgsDevice(cfg, e, &info); }, error);
+        if (installed)
+            rt->memory().setRawGifIngress(true);
+        return installed;
+    }
+
+    uint8_t *rdram() { return rt->memory().getRDRAM(); }
+    GSRegisters &regs() { return rt->memory().gs(); }
+
+    // ---- HLE kernel stubs, exactly as the recompiled game calls them ----
+    void resetGraph(uint32_t mode, uint32_t interlace, uint32_t omode, uint32_t ffmode)
+    {
+        R5900Context ctx{};
+        SET_GPR_U32(&ctx, 4, mode);
+        SET_GPR_U32(&ctx, 5, interlace);
+        SET_GPR_U32(&ctx, 6, omode);
+        SET_GPR_U32(&ctx, 7, ffmode);
+        ps2_stubs::sceGsResetGraph(rdram(), &ctx, rt.get());
+    }
+
+    GParam gparam()
+    {
+        R5900Context ctx{};
+        ps2_stubs::sceGsGetGParam(rdram(), &ctx, rt.get());
+        R5900Context *c = &ctx;
+        const uint32_t addr = GPR_U32(c, 2);
+        GParam gp;
+        const uint8_t *src = nullptr;
+        if (addr >= PS2_SCRATCHPAD_BASE && addr < PS2_SCRATCHPAD_BASE + PS2_SCRATCHPAD_SIZE)
+            src = rt->memory().getScratchpad() + (addr - PS2_SCRATCHPAD_BASE);
+        else if (addr < PS2_RAM_SIZE)
+            src = rdram() + addr;
+        if (src)
+            std::memcpy(&gp, src, sizeof(gp));
+        return gp;
+    }
+
+    void putDispEnv(const DispEnv &e)
+    {
+        std::memcpy(rdram() + kEnvAddr, &e, sizeof(e));
+        R5900Context ctx{};
+        SET_GPR_U32(&ctx, 4, kEnvAddr);
+        ps2_stubs::sceGsPutDispEnv(rdram(), &ctx, rt.get());
+    }
+
+    void mmio(uint32_t addr, uint64_t value) { rt->memory().write64(addr, value); }
+
+    // GIF DMA (channel 2, normal mode) of whole qwords, the path the HLE stubs and the game use.
+    void gifDma(const std::vector<uint64_t> &qwords)
+    {
+        std::memcpy(rdram() + kPacketAddr, qwords.data(), qwords.size() * 8u);
+        auto &mem = rt->memory();
+        mem.writeIORegister(0x1000A010u, kPacketAddr);
+        mem.writeIORegister(0x1000A020u, uint32_t(qwords.size() / 2u));
+        mem.writeIORegister(0x1000A000u, 0x101u);
+        mem.processPendingTransfers();
+    }
+
+    // Four solid quadrants into a PSMCT32 buffer at page `fbp`, width w (FBW w/64), height h.
+    void drawQuadrants(uint32_t fbp, uint32_t w, uint32_t h, const Color q[4])
+    {
+        std::vector<uint64_t> p;
+        auto ad = [&](uint8_t reg, uint64_t v) { p.push_back(v); p.push_back(reg); };
+        const uint32_t nloop = 7 + 4 * 3;
+        p.push_back(uint64_t(nloop) | (1ull << 15) | (1ull << 60)); // A+D, EOP, NREG 1
+        p.push_back(0xE);
+        ad(0x4C, uint64_t(fbp & 0x1FF) | (uint64_t((w / 64) & 0x3F) << 16));          // FRAME_1, PSMCT32
+        ad(0x40, (uint64_t(w - 1) << 16) | (uint64_t(h - 1) << 48));                    // SCISSOR_1
+        ad(0x18, 0);                                                                    // XYOFFSET_1
+        ad(0x4E, (1ull << 24) | (1ull << 32));                                          // ZBUF_1 Z24, ZMSK
+        ad(0x47, 0x30000);                                                              // TEST_1 ZTE, ZTST always
+        ad(0x1A, 1);                                                                    // PRMODECONT
+        ad(0x00, 6);                                                                    // PRIM sprite
+        const uint32_t hx = w / 2, hy = h / 2;
+        const uint32_t rect[4][4] = {{0, 0, hx, hy}, {hx, 0, w, hy}, {0, hy, hx, h}, {hx, hy, w, h}};
+        for (int i = 0; i < 4; ++i)
+        {
+            ad(0x01, uint64_t(q[i].r) | (uint64_t(q[i].g) << 8) | (uint64_t(q[i].b) << 16) | (0x80ull << 24) |
+                         (uint64_t(0x3F800000u) << 32));
+            ad(0x05, uint64_t(rect[i][0] << 4) | (uint64_t(rect[i][1] << 4) << 16));
+            ad(0x05, uint64_t(rect[i][2] << 4) | (uint64_t(rect[i][3] << 4) << 16));
+        }
+        gifDma(p);
+    }
+
+    // The window thread's presentation call (UploadFrame -> latchHostPresentationFrame), repeated
+    // until the readback ring (1-2 presents behind) has delivered a frame produced after this call.
+    Frame present(int count = 8)
+    {
+        for (int i = 0; i < count; ++i)
+        {
+            rt->gs().latchHostPresentationFrame();
+            rt->gs().sync();
+            std::this_thread::sleep_for(std::chrono::milliseconds(15));
+        }
+        Frame f;
+        f.ok = rt->gs().copyLatchedHiresFrame(f.rgba, f.w, f.h);
+        totals.absorb(rt->gs().gifDeviceStatsReport());
+        return f;
+    }
+
+    // The native host frame used by screenshots / thumbnails / the legacy upload path. The runtime
+    // repacks it from its 640-pixel internal stride to tightly packed w x h RGBA.
+    Frame hostFrame()
+    {
+        Frame f;
+        uint32_t w = 0, h = 0;
+        f.ok = rt->gs().copyLatchedHostPresentationFrame(f.rgba, w, h);
+        f.w = w;
+        f.h = h;
+        f.ok = f.ok && w && h && f.rgba.size() == size_t(w) * h * 4u;
+        return f;
+    }
+
+    void shutdown()
+    {
+        if (rt->gs().hasGifDevice())
+            rt->gs().shutdownGifDevice();
+    }
+};
+
+// --validation: make the loader log the layer insertion (evidence the layer really ran) and run one
+// deliberate invalid call first (zero-size buffer, VUID-VkBufferCreateInfo-size-00912) so the log
+// proves the layer reports errors in this process configuration (negative control).
+inline void validationEvidenceAndCanary()
+{
+#ifdef _WIN32
+    _putenv_s("VK_LOADER_DEBUG", "layer");
+    _putenv_s("VK_INSTANCE_LAYERS", "VK_LAYER_KHRONOS_validation");
+#else
+    setenv("VK_LOADER_DEBUG", "layer", 1);
+    setenv("VK_INSTANCE_LAYERS", "VK_LAYER_KHRONOS_validation", 1);
+#endif
+    if (!Vulkan::Context::init_loader(nullptr))
+        return;
+    Vulkan::Context ctx;
+    ctx.set_num_thread_indices(1);
+    if (!ctx.init_instance_and_device(nullptr, 0, nullptr, 0, Vulkan::CONTEXT_CREATION_ENABLE_PUSH_DESCRIPTOR_BIT))
+        return;
+    VkBufferCreateInfo bi = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    bi.size = 0;
+    bi.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    std::printf("[canary] creating a zero-size buffer (expected validation error)\n");
+    if (ctx.get_device_table().vkCreateBuffer(ctx.get_device(), &bi, nullptr, &buffer) == VK_SUCCESS && buffer)
+        ctx.get_device_table().vkDestroyBuffer(ctx.get_device(), buffer, nullptr);
+    std::printf("[canary] done\n");
+    std::fflush(stdout);
+}
+
+inline std::string teardownStage()
+{
+#ifdef PS2X_GS_DEVICE_TEARDOWN_STAGES
+    return ps2x_gsDeviceTeardownStage();
+#else
+    return "(A03 runtime: no stage reporting)";
+#endif
+}
+} // namespace a04
diff --git a/ps2xTest/a04/vk_display_tests.cpp b/ps2xTest/a04/vk_display_tests.cpp
new file mode 100644
index 0000000..a485fec
--- /dev/null
+++ b/ps2xTest/a04/vk_display_tests.cpp
@@ -0,0 +1,392 @@
+// Display-path tests: the retail Xenosaga display initialization through the runtime's real
+// integration path (HLE stubs -> PS2Memory/GSRegisters -> GS frontend presentation request ->
+// GS worker -> paraLLEl-GS device -> readback ring -> GS::copyLatched*Frame).
+//
+// Retail order (SLUS_204.69, decomp reference OpokXeno/xsg-i-decomp 5c0dc1cc src/main/xgl_render.c):
+//   xglRenderInit:        sceGsResetGraph(0, 1, 2, 0)                  [HLE stub, retail tail-calls SetGsCrt]
+//   xglRenderDispEnvInit: sceGsSetDefDispEnv(&DispEnv, PSMCT32, 512, 448, 0, 0); en2 = amod = 0
+//   xglRenderDispOn:      PMODE.EN2 = 1
+//   per frame xglRenderDispEnvMove (scan-line interpolation mode 1): DISPFB.FBP = shown buffer,
+//     en1 = en2, ALP = 0x80, circuit-1 DY = DY - 1; sceGsPutDispEnv(&DispEnv) [HLE stub];
+//     MMIO 0x12000070/0x12000080 (DISPFB1/DISPLAY1), EXTBUF/EXTDATA/EXTWRITE.
+// Hardware evidence (RTX 4090 gameplay heartbeat): PMODE 0x8027, DISPFB 0x1070/0x10e0,
+// DISPLAY1 0x1bf9ff0203127c, DISPLAY2 0x1bf9ff0203227c.
+//
+// usage: a04_vk_display_tests [--validation] [--modes native,2x,x8,x16] [--quick]
+#include "a04_rig.h"
+
+#include <set>
+#include <sstream>
+
+using namespace a04;
+
+namespace
+{
+bool g_validation = false;
+
+const Color kQuadA[4] = {{0xFF, 0x00, 0x00}, {0x00, 0xFF, 0x00}, {0x00, 0x00, 0xFF}, {0x80, 0x40, 0x20}};
+const Color kQuadB[4] = {{0x00, 0xFF, 0xFF}, {0xFF, 0x00, 0xFF}, {0xFF, 0xFF, 0x00}, {0x20, 0x40, 0x80}};
+constexpr uint32_t kFbA = 0x70, kFbB = 0xE0; // Xenosaga's 512-wide color buffers (DISPFB 0x1070 / 0x10e0)
+constexpr uint64_t kHwPmode = 0x8027, kHwDisplay1 = 0x1bf9ff0203127cull, kHwDisplay2 = 0x1bf9ff0203227cull;
+
+bool showsQuadrants(const Frame &f, const Color q[4])
+{
+    return f.near(0.25, 0.25, q[0].r, q[0].g, q[0].b) && f.near(0.75, 0.25, q[1].r, q[1].g, q[1].b) &&
+           f.near(0.25, 0.75, q[2].r, q[2].g, q[2].b) && f.near(0.75, 0.75, q[3].r, q[3].g, q[3].b);
+}
+
+std::string frameInfo(const Frame &f)
+{
+    std::ostringstream s;
+    s << (f.ok ? "" : "no frame ") << f.w << "x" << f.h << " TL " << f.describe(0.25, 0.25) << " TR "
+      << f.describe(0.75, 0.25) << " BL " << f.describe(0.25, 0.75) << " BR " << f.describe(0.75, 0.75);
+    return s.str();
+}
+
+int samplesFor(const std::string &mode)
+{
+    return mode == "native" ? 1 : mode == "2x" ? 4 : mode == "x8" ? 8 : 16;
+}
+
+// Xenosaga's display environment for one frame, as xglRenderDispEnvMove leaves the registers.
+struct XglDisplay
+{
+    DispEnv env; // after DispEnvInit/DispOn and the per-frame mode-1 edits
+    uint64_t display1 = 0;
+
+    static XglDisplay fromGParam(const GParam &gp, uint32_t w = 512, uint32_t h = 448)
+    {
+        XglDisplay d;
+        d.env = libgraphDefDispEnv(gp, 0 /*PSMCT32*/, w, h, 0, 0);
+        d.env.pmode &= ~uint64_t(0x2 | 0x40); // xglRenderDispEnvInit: en2 = 0, amod = 0
+        d.env.pmode |= 0x2;                   // xglRenderDispOn: en2 = 1
+        d.env.pmode |= 0x1;                   // mode 1: en1 = en2
+        d.env.pmode = (d.env.pmode & ~0xFF00ull) | (0x80ull << 8); // ALP = 0x80
+        const uint32_t dy = uint32_t(d.env.display >> 12) & 0x7FF;
+        d.display1 = (d.env.display & ~(0x7FFull << 12)) | (uint64_t((dy - 1) & 0x7FF) << 12);
+        return d;
+    }
+
+    void apply(RuntimeRig &rig, uint32_t fbp) const
+    {
+        DispEnv e = env;
+        e.dispfb = (e.dispfb & ~0x1FFull) | fbp;
+        rig.putDispEnv(e);
+        rig.mmio(kGsDispfb1, e.dispfb);
+        rig.mmio(kGsDisplay1, display1);
+        rig.mmio(kGsExtbuf, 0);
+        rig.mmio(kGsExtdata, 0);
+        rig.mmio(kGsExtwrite, 0);
+    }
+};
+
+// ---------------------------------------------------------------------------------------------
+// [retail] The original order, a frame flip sequence, reset/reinit and the defect negative control.
+void testRetailSequence(const std::string &mode, bool full)
+{
+    std::printf("[retail %s]\n", mode.c_str());
+    RuntimeRig rig(samplesFor(mode), true, g_validation);
+    check(rig.ok, "device installed (" + rig.error + ") on '" + rig.info.deviceName + "' effective samples " +
+                      std::to_string(rig.info.samplesEffective));
+    if (!rig.ok)
+        return;
+
+    // Presentation before the guest has set up any display: nothing to publish.
+    Frame pre = rig.present(3);
+    check(rig.totals.published == 0, "no frame published before display initialization");
+
+    // xglRenderInit
+    rig.resetGraph(0, 1, 2, 0);
+    const GParam gp = rig.gparam();
+    check(gp.interlace == 1 && gp.omode == 2 && gp.ffmode == 0, "sceGsGetGParam after sceGsResetGraph(0,1,2,0) = {1,2,0}");
+    const uint64_t s1 = rig.regs().smode1;
+    char buf[160];
+    std::snprintf(buf, sizeof(buf), "SMODE1 after sceGsResetGraph(0,1,2,0) selects NTSC analog (CMOD 2, LC 32): 0x%llx",
+                  (unsigned long long)s1);
+    check(smode1Cmod(s1) == 2 && smode1Lc(s1) == 32, buf);
+    check(rig.regs().smode2 == 1, "SMODE2 after sceGsResetGraph = INT 1, FFMD 0");
+
+    const XglDisplay xd = XglDisplay::fromGParam(gp);
+    check(xd.env.pmode == kHwPmode, "PMODE after xgl init/on/mode-1 edits equals the hardware value 0x8027");
+    check(xd.display1 == kHwDisplay1 && xd.env.display == kHwDisplay2,
+          "DISPLAY1/DISPLAY2 equal the hardware values (DY 49 / 50, MAGH 4, DW 2559, DH 447)");
+
+    // Frame 1: draw into A, show A.
+    rig.drawQuadrants(kFbA, 512, 448, kQuadA);
+    xd.apply(rig, kFbA);
+    check(rig.regs().pmode == kHwPmode && rig.regs().dispfb1 == 0x1070 && rig.regs().dispfb2 == 0x1070 &&
+              rig.regs().display1 == kHwDisplay1 && rig.regs().display2 == kHwDisplay2,
+          "privileged registers after sceGsPutDispEnv + MMIO match the hardware heartbeat");
+    const unsigned long long pubBefore = rig.totals.published;
+    Frame a = rig.present();
+    info("frame A: " + frameInfo(a) + "; video mode '" + rig.totals.videoMode + "'");
+    check(a.ok && a.w > 0 && a.h > 0, "nonzero scanout dimensions after display initialization");
+    check(rig.totals.readbacks > 0, "readback submitted");
+    check(rig.totals.published > pubBefore, "frame published after a valid display state is established");
+    check(showsQuadrants(a, kQuadA), "frame A content (4 quadrants) reaches GS::copyLatchedHiresFrame");
+    if (mode == "native")
+    {
+        check(a.w == 512 && a.h == 448, "native scanout is 512x448 (DW 2559 / MAGH 4, DH 447)");
+        Frame host = rig.hostFrame();
+        check(showsQuadrants(host, kQuadA), "frame A content in the native host frame (screenshots, thumbnails)");
+    }
+    else
+        check(a.w == 1024 && a.h == 896, "2x scanout is 1024x896");
+
+    if (!full)
+    {
+        rig.shutdown();
+        return;
+    }
+
+    // DISPFB switching: the game alternates 0x1070 / 0x10e0.
+    rig.drawQuadrants(kFbB, 512, 448, kQuadB);
+    xd.apply(rig, kFbB);
+    Frame b = rig.present();
+    check(showsQuadrants(b, kQuadB), "DISPFB 0x10e0: frame B shown (" + frameInfo(b) + ")");
+    bool flipOk = true;
+    for (int i = 0; i < 4; ++i)
+    {
+        const bool toA = (i % 2) == 0;
+        xd.apply(rig, toA ? kFbA : kFbB);
+        Frame f = rig.present();
+        flipOk = flipOk && showsQuadrants(f, toA ? kQuadA : kQuadB);
+    }
+    check(flipOk, "4 further DISPFB flips each show the selected buffer");
+
+    // Defect negative control: SMODE1 back to the value the runtime left before the SetGsCrt fix (0).
+    const unsigned long long pub0 = rig.totals.published, empty0 = rig.totals.empty, uns0 = rig.totals.unsupported;
+    const uint64_t saved = rig.regs().smode1;
+    rig.mmio(kGsSmode1, 0);
+    rig.drawQuadrants(kFbA, 512, 448, kQuadB); // new content, must not appear
+    rig.present();
+    check(rig.totals.published == pub0, "negative control: SMODE1 = 0 publishes no new frame");
+    check(rig.totals.empty > empty0, "negative control: SMODE1 = 0 scanouts are empty (the A03 hardware symptom)");
+#ifdef PS2X_GS_DEVICE_TEARDOWN_STAGES
+    check(rig.totals.unsupported > uns0, "negative control: device reports the scanouts as unsupported-mode");
+#endif
+    rig.mmio(kGsSmode1, saved);
+    Frame back = rig.present();
+    check(showsQuadrants(back, kQuadB), "restoring SMODE1 publishes the new content again");
+
+    // Reset and reinitialization: per-frame flush-mode reset and a second full init (the log shows
+    // xglRenderInit twice: InitializeSystem and xglRenderEntry).
+    rig.resetGraph(1, 0, 0, 0);
+    rig.drawQuadrants(kFbA, 512, 448, kQuadA);
+    xd.apply(rig, kFbA);
+    Frame r1 = rig.present();
+    check(showsQuadrants(r1, kQuadA), "sceGsResetGraph(1,...) keeps the video mode; frames continue");
+    rig.resetGraph(0, 1, 2, 0);
+    check(smode1Cmod(rig.regs().smode1) == 2 && rig.regs().smode2 == 1, "second sceGsResetGraph(0,1,2,0) re-establishes NTSC");
+    rig.drawQuadrants(kFbB, 512, 448, kQuadB);
+    xd.apply(rig, kFbB);
+    Frame r2 = rig.present();
+    check(showsQuadrants(r2, kQuadB), "frames continue after reinitialization");
+    rig.shutdown();
+    check(!rig.rt->gs().hasGifDevice(), "device shut down");
+}
+
+// ---------------------------------------------------------------------------------------------
+// [circuits] PMODE circuit enables and the circuit merge.
+void testCircuits()
+{
+    std::printf("[circuits]\n");
+    RuntimeRig rig(1, true, g_validation);
+    check(rig.ok, "device installed");
+    if (!rig.ok)
+        return;
+    rig.resetGraph(0, 1, 2, 0);
+    const XglDisplay xd = XglDisplay::fromGParam(rig.gparam());
+    const Color red[4] = {{200, 0, 0}, {200, 0, 0}, {200, 0, 0}, {200, 0, 0}};
+    const Color blue[4] = {{0, 0, 200}, {0, 0, 200}, {0, 0, 200}, {0, 0, 200}};
+    rig.drawQuadrants(kFbA, 512, 448, red);
+    rig.drawQuadrants(kFbB, 512, 448, blue);
+
+    auto setup = [&](uint64_t pmode, uint32_t fb1, uint32_t fb2)
+    {
+        DispEnv e = xd.env;
+        e.pmode = pmode;
+        e.dispfb = (e.dispfb & ~0x1FFull) | fb2;
+        rig.putDispEnv(e); // both circuits from the env (HLE), then circuit 1 by MMIO
+        rig.mmio(kGsDispfb1, (e.dispfb & ~0x1FFull) | fb1);
+        rig.mmio(kGsDisplay1, e.display);
+        return rig.present();
+    };
+    // CRTMD 1, MMOD 1 (ALP), ALP as given.
+    Frame c1 = setup(0x1 | 0x4 | 0x20 | (0xFFull << 8), kFbA, kFbB);
+    check(c1.near(0.5, 0.5, 200, 0, 0), "EN1 only: circuit 1 (buffer A) shown " + frameInfo(c1));
+    Frame c2 = setup(0x2 | 0x4 | 0x20 | (0xFFull << 8), kFbA, kFbB);
+    check(c2.near(0.5, 0.5, 0, 0, 200), "EN2 only: circuit 2 (buffer B) shown " + frameInfo(c2));
+    Frame both = setup(0x3 | 0x4 | 0x20 | (0x80ull << 8), kFbA, kFbB);
+    int c[3] = {0, 0, 0};
+    if (both.ok)
+        both.at(0.5, 0.5, c);
+    check(both.ok && std::abs(c[0] - 100) <= 4 && c[1] <= 4 && std::abs(c[2] - 100) <= 4,
+          "EN1+EN2, ALP 0x80: circuits merged ~50/50 " + frameInfo(both));
+    Frame none = setup(0x4 | 0x20 | (0x80ull << 8), kFbA, kFbB);
+    info("EN1=EN2=0: " + frameInfo(none) + " (background only)");
+    rig.shutdown();
+}
+
+// ---------------------------------------------------------------------------------------------
+// [modes] Video-mode interpretation through sceGsResetGraph / SetGsCrt and direct SMODE writes.
+void testVideoModes()
+{
+    std::printf("[modes]\n");
+    struct Case
+    {
+        const char *name;
+        uint32_t interlace, omode, ffmode, h;
+        bool expectFrame;
+    } cases[] = {
+        {"NTSC interlaced field (Xenosaga)", 1, 2, 0, 448, true},
+        {"NTSC interlaced frame", 1, 2, 1, 224, true},
+        {"NTSC non-interlaced", 0, 2, 0, 224, true},
+        {"PAL interlaced field", 1, 3, 0, 512, true},
+    };
+    for (const auto &cs : cases)
+    {
+        for (bool progressive : {true, false})
+        {
+            RuntimeRig rig(1, progressive, g_validation);
+            if (!rig.ok)
+            {
+                check(false, std::string(cs.name) + ": device install");
+                continue;
+            }
+            rig.resetGraph(0, cs.interlace, cs.omode, cs.ffmode);
+            const GParam gp = rig.gparam();
+            DispEnv e = libgraphDefDispEnv(gp, 0, 512, cs.h, 0, 0);
+            e.pmode = 0x1 | 0x4 | 0x20 | (0xFFull << 8); // circuit 1 only
+            e.dispfb |= kFbA;
+            const uint32_t bufH = (cs.interlace == 1 && cs.ffmode != 0) ? 2 * cs.h : cs.h;
+            rig.drawQuadrants(kFbA, 512, bufH, kQuadA);
+            rig.putDispEnv(e);
+            uint64_t field = 0;
+            Frame f;
+            bool all = true;
+            // Both field parities (CSR.FIELD) for interlaced scanout.
+            for (int phase = 0; phase < (progressive ? 1 : 2); ++phase)
+            {
+                field = phase ? (1ull << 13) : 0;
+                rig.regs().csr.store((rig.regs().csr.load() & ~(1ull << 13)) | field);
+                f = rig.present();
+                if (cs.interlace == 1 && cs.ffmode != 0)
+                {
+                    // FRAME mode (FFMD 1): the vertical mapping paraLLEl-GS applies is not established by
+                    // any evidence here (Xenosaga uses FIELD mode). Only the unambiguous part is checked:
+                    // a picture whose first lines come from the top of the buffer. Bottom half: info only.
+                    all = all && f.ok && f.w == 512 && f.h > 0 && f.near(0.25, 0.1, kQuadA[0].r, kQuadA[0].g, kQuadA[0].b) &&
+                          f.near(0.75, 0.1, kQuadA[1].r, kQuadA[1].g, kQuadA[1].b);
+                    info(std::string("UNVERIFIED frame-mode vertical mapping: bottom half shows ") + f.describe(0.25, 0.75) +
+                         " / " + f.describe(0.75, 0.75));
+                }
+                else
+                    all = all && f.ok && f.w > 0 && f.h > 0 && showsQuadrants(f, kQuadA);
+            }
+            std::string label = std::string(cs.name) + (progressive ? " progressive" : " field scanout") + ": SMODE1 CMOD " +
+                                std::to_string(smode1Cmod(rig.regs().smode1)) + " SMODE2 " +
+                                std::to_string(rig.regs().smode2) + ", " + frameInfo(f) + " mode '" + rig.totals.videoMode +
+                                "'";
+            check(all == cs.expectFrame, label);
+            rig.shutdown();
+        }
+    }
+
+    // Direct SMODE1 values: what the renderer accepts (paraLLEl-GS table) and what it rejects.
+    struct Raw
+    {
+        const char *name;
+        uint64_t smode1, smode2;
+        bool supported;
+    } raws[] = {
+        {"SMODE1 0 (A03 state), interlaced", 0, 1, false},
+        {"SMODE1 0, non-interlaced", 0, 0, false},
+        {"NTSC BIOS value", 0x740814504ull, 1, true},
+        {"NTSC BIOS value with SINT (PLL start)", 0x740834504ull, 1, true},
+        {"PAL", 0x740816504ull, 1, true},
+        {"CMOD 0 LC 32 non-interlaced (480p)", 0x740800504ull & ~(3ull << 13), 0, true},
+    };
+    RuntimeRig rig(1, true, g_validation);
+    if (!rig.ok)
+        return;
+    rig.resetGraph(0, 1, 2, 0);
+    const XglDisplay xd = XglDisplay::fromGParam(rig.gparam());
+    rig.drawQuadrants(kFbA, 512, 448, kQuadA);
+    xd.apply(rig, kFbA);
+    for (const auto &r : raws)
+    {
+        const unsigned long long pub0 = rig.totals.published;
+        rig.mmio(kGsSmode1, r.smode1);
+        rig.mmio(kGsSmode2, r.smode2);
+        rig.drawQuadrants(kFbA, 512, 448, kQuadA); // dirty: force a scanout
+        rig.present();
+        const bool got = rig.totals.published > pub0;
+        check(got == r.supported, std::string(r.name) + (r.supported ? " -> frame" : " -> no frame (unsupported)") +
+                                      ", device mode '" + rig.totals.videoMode + "'");
+    }
+    rig.shutdown();
+}
+
+// ---------------------------------------------------------------------------------------------
+// [setgscrt] The syscall itself (bound at 0x200120) and modes it does not model.
+void testSetGsCrt()
+{
+    std::printf("[setgscrt]\n");
+    RuntimeRig rig(1, true, g_validation, /*install*/ false);
+    auto call = [&](uint32_t inter, uint32_t omode, uint32_t ff)
+    {
+        R5900Context ctx{};
+        SET_GPR_U32(&ctx, 4, inter);
+        SET_GPR_U32(&ctx, 5, omode);
+        SET_GPR_U32(&ctx, 6, ff);
+        ps2_syscalls::SetGsCrt(rig.rdram(), &ctx, rig.rt.get());
+        R5900Context *c = &ctx;
+        return GPR_U32(c, 2);
+    };
+    rig.regs().smode1 = 0;
+    check(call(1, 2, 0) == 0 && smode1Cmod(rig.regs().smode1) == 2 && smode1Lc(rig.regs().smode1) == 32 &&
+              rig.regs().smode2 == 1,
+          "SetGsCrt(1, NTSC, field): SMODE1 NTSC, SMODE2 1");
+    check(call(1, 3, 1) == 0 && smode1Cmod(rig.regs().smode1) == 3 && rig.regs().smode2 == 3,
+          "SetGsCrt(1, PAL, frame): SMODE1 PAL, SMODE2 3");
+    const uint64_t before = rig.regs().smode1;
+    call(0, 0x1A, 0); // VESA 640x480@60: not modelled
+    check(rig.regs().smode1 == before, "SetGsCrt(VESA 0x1A): SMODE1 not invented (left unchanged)");
+}
+} // namespace
+
+int main(int argc, char **argv)
+{
+    std::vector<std::string> modes = {"native", "2x", "x8", "x16"};
+    bool quick = false;
+    for (int i = 1; i < argc; ++i)
+    {
+        const std::string a = argv[i];
+        if (a == "--validation")
+            g_validation = true;
+        else if (a == "--quick")
+            quick = true;
+        else if (a == "--modes" && i + 1 < argc)
+        {
+            modes.clear();
+            std::stringstream list(argv[++i]);
+            for (std::string m; std::getline(list, m, ',');)
+                modes.push_back(m);
+        }
+    }
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    if (g_validation)
+        validationEvidenceAndCanary();
+    for (const auto &m : modes)
+        testRetailSequence(m, m == "native");
+    if (!quick)
+    {
+        testCircuits();
+        testVideoModes();
+        testSetGsCrt();
+    }
+    std::printf("SUMMARY: %d checks, %d failures\n", g_checks, g_failures);
+    std::printf("A04 VK DISPLAY TESTS: %s\n", g_failures ? "FAIL" : "PASS");
+    return g_failures ? 1 : 0;
+}
