+uint32_t Ps2Ipu::readCtrl() const
+{
+    const uint32_t ifc = static_cast<uint32_t>(std::min<size_t>(m_in.size(), 8u));
+    const uint32_t ofc = static_cast<uint32_t>(std::min<size_t>(outputQwords(), 8u));
+    return m_ctrl | ifc | (ofc << 4);
+}
+
+uint32_t Ps2Ipu::readBp() const
+{
+    // BP = bit position in the quadword being read; FP + IFC = quadwords
+    // fetched but not consumed (games rewind their DMA address by that much).
+    const uint32_t count = static_cast<uint32_t>(std::min<size_t>(m_in.size(), 17u));
+    const uint32_t fp = std::min<uint32_t>(count, 2u);
+    const uint32_t ifc = count - fp;
+    const uint32_t bp = m_in.empty() ? m_pendingBp : m_bitPos;
+    return (bp & 0x7Fu) | ((ifc & 0xFu) << 8) | (fp << 16);
+}
+
+uint32_t Ps2Ipu::readTop()
+{
+    return peekBits(32);
+}
+
+bool Ps2Ipu::popOutput(uint8_t qword[16])
+{
+    if (m_outRead + 16u > m_out.size())
+        return false;
+    std::memcpy(qword, m_out.data() + m_outRead, 16u);
+    m_outRead += 16u;
+    if (m_outRead == m_out.size())
+    {
+        m_out.clear();
+        m_outRead = 0;
+    }
+    return true;
+}
+
+void Ps2Ipu::writeCmd(uint32_t value)
+{
+    const uint32_t code = value >> 28;
+    m_starved = false;
+    // PS2X_IPU_LOG=<n>: print the first n commands with the state after them.
+    static int logBudget = [] { const char *e = std::getenv("PS2X_IPU_LOG"); return e ? std::atoi(e) : 0; }();
+    struct LogAfter
+    {
+        Ps2Ipu &ipu;
+        uint32_t value;
+        int &budget;
+        ~LogAfter()
+        {
+            if (budget > 0)
+            {
+                --budget;
+                std::printf("[ipu] cmd 0x%08x -> result 0x%08x ctrl 0x%08x bp 0x%05x out %zu qw in %zu qw%s\n", value,
+                            ipu.m_cmdResult, ipu.readCtrl(), ipu.readBp(), ipu.outputQwords(), ipu.m_in.size(),
+                            ipu.m_starved ? " STARVED" : "");
+                std::fflush(stdout);
+            }
+        }
+    } logAfter{*this, value, logBudget};
+    switch (code)
+    {
+    case 0x0: // BCLR
+        m_in.clear();
+        m_bitPos = 0;
+        m_pendingBp = value & 0x7Fu;
+        m_cmdResult = 0;
+        break;
+    case 0x1: // IDEC
+        idec(value);
+        m_cmdResult = 0;
+        break;
+    case 0x4: // FDEC
+        skipBits(value & 0x3Fu);
+        m_cmdResult = peekBits(32);
+        break;
+    case 0x9: // SETTH
+        m_th0 = value & 0x1FFu;
+        m_th1 = (value >> 16) & 0x1FFu;
+        m_cmdResult = 0;
+        break;
+    case 0x5: // SETIQ: games load the default matrices; not read from the input here
+    case 0x6: // SETVQ
+        m_cmdResult = 0;
+        break;
+    default: // BDEC, VDEC, CSC, PACK: not used by IPU movies
+    {
+        static int warned = 0;
+        if (warned++ < 8)
+            std::printf("[ipu] unsupported command 0x%08x\n", value);
+        m_cmdResult = 0;
+        break;
+    }
+    }
+}
+
+int Ps2Ipu::decodeDcSize(bool luma)
+{
+    const uint32_t bits = peekBits(10);
+    const uint16_t *codes = luma ? kDcLumCode : kDcChromaCode;
+    const uint8_t *lens = luma ? kDcLumBits : kDcChromaBits;
+    for (int size = 0; size < 12; ++size)
+        if ((bits >> (10u - lens[size])) == codes[size])
+        {
+            skipBits(lens[size]);
+            return size;
+        }
+    return -1;
+}
+
+int Ps2Ipu::decodeMbai()
+{
+    int increment = 0;
+    for (;;)
+    {
+        const uint16_t e = lutMbai().lut[peekBits(16)];
+        if (e == 0)
+            return -1;
+        const int index = (e >> 5) - 1;
+        skipBits(e & 31u);
+        if (index == 33) // escape
+        {
+            increment += 33;
+            continue;
+        }
+        if (index == 34) // stuffing
+            continue;
+        return increment + index + 1;
+    }
+}
+
+bool Ps2Ipu::decodeIntraBlock(int component, int16_t coeffs[64], bool mpeg2, bool altScan, bool vlcB15,
+                              int quantScale, int dcMultiplier)
+{
+    std::memset(coeffs, 0, 64 * sizeof(int16_t));
+    const int size = decodeDcSize(component == 0);
+    if (size < 0)
+        return false;
+    int diff = 0;
+    if (size != 0)
+    {
+        diff = static_cast<int>(getBits(static_cast<uint32_t>(size)));
+        if (diff < (1 << (size - 1)))
+            diff -= (1 << size) - 1;
+    }
+    m_dcPred[component] += diff;
+    int sum = m_dcPred[component] * dcMultiplier;
+    coeffs[0] = static_cast<int16_t>(std::clamp(sum, -2048, 2047));
+    sum = coeffs[0];
+    const uint8_t *scan = altScan ? kAlternate : kZigzag;
+    const VlcLut &lut = (mpeg2 && vlcB15) ? lutB15() : lutB14();
+    int idx = 1;
+    for (;;)
+    {
+        const uint16_t e = lut.lut[peekBits(16)];
+        if (e == 0)
+            return false;
+        const int entry = (e >> 5) - 1;
+        skipBits(e & 31u);
+        if (entry == kEob)
+            break;
+        int run, level;
+        if (entry == kEscape)
+        {
+            run = static_cast<int>(getBits(6));
+            if (mpeg2)
+            {
+                level = static_cast<int>(getBits(12));
+                if (level & 0x800)
+                    level -= 0x1000;
+            }
+            else
+            {
+                level = static_cast<int>(getBits(8));
+                if (level == 0x80)
+                    level = static_cast<int>(getBits(8)) - 256;
+                else if (level == 0)
+                    level = static_cast<int>(getBits(8));
+                else if (level > 0x80)
+                    level -= 256;
+            }
+        }
+        else
+        {
+            run = kRun[entry];
+            level = kLevel[entry];
+            if (getBits(1))
+                level = -level;
+        }
+        idx += run;
+        if (idx > 63)
+            return false;
+        const int pos = scan[idx];
+        int val = (level * quantScale * kDefaultIntra[pos] * 2) / 32;
+        if (!mpeg2 && val != 0 && (val & 1) == 0)
+            val += val > 0 ? -1 : 1; // MPEG-1 oddification
+        val = std::clamp(val, -2048, 2047);
+        coeffs[pos] = static_cast<int16_t>(val);
+        sum += val;
+        ++idx;
+    }
+    if (mpeg2 && (sum & 1) == 0) // mismatch control
+        coeffs[63] = static_cast<int16_t>(coeffs[63] ^ 1);
+    return true;
+}
+
+void Ps2Ipu::idec(uint32_t cmd)
+{
+    skipBits(cmd & 0x3Fu);
+    const bool dtd = (cmd >> 24) & 1u;
+    const bool rgb16 = (cmd >> 27) & 1u;
+    int quantCode = static_cast<int>((cmd >> 16) & 0x1Fu);
+    const int idp = static_cast<int>((m_ctrl >> 16) & 3u);
+    const bool altScan = (m_ctrl >> 20) & 1u;
+    const bool vlcB15 = (m_ctrl >> 21) & 1u;
+    const bool nonLinear = (m_ctrl >> 22) & 1u;
+    const bool mpeg1 = (m_ctrl >> 23) & 1u;
+    const bool mpeg2 = !mpeg1;
+    const int dcMultiplier = mpeg2 ? (8 >> idp) : 8;
+    for (int &p : m_dcPred)
+        p = 128 << (mpeg2 ? idp : 0);
+    m_ctrl &= ~0x0000C000u; // SCD, ECD
+
+    uint8_t y[256], cb[64], cr[64];
+    int16_t coeffs[64];
+    int pixels[64];
+    for (;;)
+    {
+        // macroblock_type for I pictures: 1 = intra, 01 = intra + quant
+        bool quant;
+        if (peekBits(1))
+        {
+            skipBits(1);
+            quant = false;
+        }
+        else if (peekBits(2) == 1u)
+        {
+            skipBits(2);
+            quant = true;
+        }
+        else
+        {
+            m_ctrl |= 0x4000u; // ECD
+            break;
+        }
+        const bool fieldDct = dtd ? getBits(1) != 0u : false;
+        if (quant)
+            quantCode = static_cast<int>(getBits(5));
+        const int quantScale = nonLinear && mpeg2 ? kNonLinearQ[quantCode] : quantCode * 2;
+
+        bool ok = true;
+        for (int b = 0; b < 6 && ok; ++b)
+        {
+            const int component = b < 4 ? 0 : b - 3;
+            ok = decodeIntraBlock(component, coeffs, mpeg2, altScan, vlcB15, quantScale, dcMultiplier);
+            if (!ok)
+                break;
+            idct8x8(coeffs, pixels);
+            if (b < 4)
+            {
+                const int bx = (b & 1) * 8;
+                for (int r = 0; r < 8; ++r)
+                {
+                    const int row = fieldDct ? ((b >> 1) + r * 2) : ((b >> 1) * 8 + r);
+                    for (int c = 0; c < 8; ++c)
+                        y[row * 16 + bx + c] = clamp8(pixels[r * 8 + c]);
+                }
+            }
+            else
+            {
+                uint8_t *dst = b == 4 ? cb : cr;
+                for (int i = 0; i < 64; ++i)
+                    dst[i] = clamp8(pixels[i]);
+            }
+        }
+        if (!ok)
+        {
+            m_ctrl |= 0x4000u; // ECD
+            break;
+        }
+
+        // CSC (YCbCr -> RGB, PS2 IPU coefficients) and alpha thresholds.
+        const size_t at = m_out.size();
+        m_out.resize(at + (rgb16 ? 512u : 1024u));
+        uint8_t *dst = m_out.data() + at;
+        for (int py = 0; py < 16; ++py)
+            for (int px = 0; px < 16; ++px)
+            {
+                const int lum = (static_cast<int>(y[py * 16 + px]) - 16) * 0x95;
+                const int u = static_cast<int>(cb[(py >> 1) * 8 + (px >> 1)]) - 128;
+                const int v = static_cast<int>(cr[(py >> 1) * 8 + (px >> 1)]) - 128;
+                const uint8_t r = clamp8((lum + 0xCC * v + 64) >> 7);
+                const uint8_t g = clamp8((lum - 0x68 * v - 0x32 * u + 64) >> 7);
+                const uint8_t bl = clamp8((lum + 0x102 * u + 64) >> 7);
+                uint8_t a = 0x80;
+                if (r < m_th0 && g < m_th0 && bl < m_th0)
+                    a = 0;
+                else if (r < m_th1 && g < m_th1 && bl < m_th1)
+                    a = 0x40;
+                if (rgb16)
+                {
+                    const uint16_t p = static_cast<uint16_t>((r >> 3) | ((g >> 3) << 5) | ((bl >> 3) << 10) | (a ? 0x8000u : 0u));
+                    std::memcpy(dst + (py * 16 + px) * 2, &p, 2);
+                }
+                else
+                {
+                    uint8_t *p = dst + (py * 16 + px) * 4;
+                    p[0] = r;
+                    p[1] = g;
+                    p[2] = bl;
+                    p[3] = a;
+                }
+            }
+
+        // A start code (eight zero bits at a macroblock boundary) ends IDEC.
+        if (peekBits(8) == 0u)
+        {
+            alignByte();
+            m_ctrl |= 0x8000u; // SCD
+            break;
+        }
+        const int increment = decodeMbai();
+        if (increment < 0)
+        {
+            m_ctrl |= 0x4000u;
+            break;
+        }
+        if (increment > 1)
+            for (int &p : m_dcPred)
+                p = 128 << (mpeg2 ? idp : 0);
+        if (m_starved)
+            break;
+    }
+}
