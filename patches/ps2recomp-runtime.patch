+    // geometry (64x32 pixels, the largest per pixel), rows 0..rows-1.
+    void bufferRange(uint32_t baseBytes, uint32_t widthPixels, uint32_t rows, uint32_t &lo, uint32_t &hi)
+    {
+        const uint32_t pagesWide = std::max(1u, (widthPixels + 63u) / 64u);
+        const uint32_t pagesHigh = std::max(1u, (rows + 31u) / 32u);
+        lo = baseBytes & ~(kPage - 1u);
+        hi = lo + (pagesWide * pagesHigh + 1u) * kPage;
+    }
+
+    bool overlaps(uint32_t lo, uint32_t hi, uint32_t lo2, uint32_t hi2)
+    {
+        // VRAM wraps at 4 MB; ranges are kept unwrapped, so compare both ways.
+        const auto hit = [](uint32_t a, uint32_t b, uint32_t c, uint32_t d) { return a < d && c < b; };
+        return hit(lo, hi, lo2, hi2) || hit(lo + kVramBytes, hi + kVramBytes, lo2, hi2) ||
+               hit(lo, hi, lo2 + kVramBytes, hi2 + kVramBytes);
+    }
+
+}
