+    void DrainUnlocked();
+    void DrawPendingBand(uint32_t band);
+    bool QueueConflicts(const GSPrimitiveBatch &batch) const;
+    void AddRanges(const GSPrimitiveBatch &batch);
+    uint32_t m_bandCount = 1;
+    std::vector<PendingPrimitive> m_pending;
+    std::vector<std::array<uint16_t, 512>> m_clutSnapshots;
+    bool m_clutDirty = true;
+    std::vector<MemRange> m_writes;
