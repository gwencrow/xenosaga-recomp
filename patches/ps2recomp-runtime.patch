+bool GS::installGifDevice(const std::function<std::unique_ptr<GSGifDevice>(std::string &error)> &create,
+                          std::string &error)
+{
+    if (!m_async)
+    {
+        error = "the raw-GIF device needs the asynchronous GS worker (PS2X_GS_ASYNC must not be 0)";
+        return false;
+    }
+    if (m_deviceActive)
+    {
+        error = "a GS device is already installed";
+        return false;
+    }
+    bool ok = false;
+    runOnWorker([&]()
+                {
+        if (m_backend)
+            m_backend->Flush();
+        std::unique_ptr<GSGifDevice> device = create(error);
+        if (device)
+        {
+            std::lock_guard<std::mutex> lifetime(m_backendLifetimeMutex);
+            m_device = std::move(device);
+            ok = true;
+        } });
+    m_deviceActive = ok;
+    return ok;
+}
