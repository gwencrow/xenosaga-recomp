+};
+
+uint64_t take(std::atomic<uint64_t> &v) { return v.exchange(0, std::memory_order_relaxed); }
+
+// Diagnostics: the video-mode table of paraLLEl-GS GSRenderer::vsync (gs_renderer.cpp), which
+// selects the CRTC timing from SMODE1.CMOD/LC and SMODE2.INT and scans out nothing ("Unknown video
+// format") when no entry matches. Mirrored here only to name the mode in the log; nullptr = no match.
+const char *pgsVideoModeName(uint64_t smode1, uint64_t smode2)
+{
+    const uint32_t lc = static_cast<uint32_t>(smode1 >> 3) & 0x7Fu;
+    const uint32_t cmod = static_cast<uint32_t>(smode1 >> 13) & 0x3u;
+    const bool interlaced = (smode2 & 1u) != 0u;
+    if ((cmod == 2u || (cmod == 0u && !interlaced)) && lc == 32u)
+        return cmod == 2u ? "NTSC" : "NTSC progressive (480p)";
+    if (cmod == 3u && lc == 32u)
+        return "PAL";
+    if (cmod == 0u && lc == 22u)
+        return interlaced ? "HDTV 1080i" : "HDTV 720p";
+    if (cmod == 0u && lc == 15u)
+        return "VGA 640x480";
+    if (lc == 29u)
+        return "undocumented 640x480 (LC 29)";
+    return nullptr;
+}
+
+// SIGNAL/FINISH/LABEL from the GIF stream, in stream order, on the worker. Writes the same
+// PS2Memory::GSRegisters fields the legacy frontend wrote (gs_frontend.cpp GS_REG_SIGNAL..LABEL).
+struct SignalAdapter final : SignalInterface
+{
+    GSRegisters *regs = nullptr;
+    Stats *stats = nullptr;
+
+    bool on_signal(uint64_t payload) override
+    {
+        stats->signals.fetch_add(1, std::memory_order_relaxed);
+        if (regs)
+        {
+            const uint32_t id = static_cast<uint32_t>(payload), mask = static_cast<uint32_t>(payload >> 32);
+            uint32_t lo = static_cast<uint32_t>(regs->siglblid);
+            lo = (lo & ~mask) | (id & mask);
+            regs->siglblid = (regs->siglblid & 0xFFFFFFFF00000000ull) | lo;
+            regs->csr.fetch_or(0x1);
+        }
+        return false;
+    }
+    bool on_finish(uint64_t) override
+    {
+        stats->finishes.fetch_add(1, std::memory_order_relaxed);
+        if (regs)
+            regs->csr.fetch_or(0x2);
+        return false; // CSR is a CPU-side event; GPU results are only observable through readbacks
+    }
+    bool on_label(uint64_t payload) override
+    {
+        stats->labels.fetch_add(1, std::memory_order_relaxed);
+        if (regs)
+        {
+            const uint32_t id = static_cast<uint32_t>(payload), mask = static_cast<uint32_t>(payload >> 32);
+            uint32_t hi = static_cast<uint32_t>(regs->siglblid >> 32);
+            hi = (hi & ~mask) | (id & mask);
+            regs->siglblid = (static_cast<uint64_t>(hi) << 32) | (regs->siglblid & 0xFFFFFFFFull);
+        }
+        return false;
+    }
+};
+
+using ReadFn = uint32_t (*)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t);
+using WriteFn = void (*)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
+
+void pixelFuncs(uint32_t psm, ReadFn &r, WriteFn &w)
+{
+    using namespace GSMem;
+    switch (psm & 0x3Fu)
+    {
+    case 0x00: r = ReadCT32; w = WriteCT32; break;
+    case 0x01: r = ReadCT24; w = WriteCT24; break;
+    case 0x02: r = ReadCT16; w = WriteCT16; break;
+    case 0x0A: r = ReadCT16S; w = WriteCT16S; break;
+    case 0x13: r = ReadP8; w = WriteP8; break;
+    case 0x14: r = ReadP4; w = WriteP4; break;
+    case 0x1B: r = ReadP8H; w = WriteP8H; break;
+    case 0x24: r = ReadP4HL; w = WriteP4HL; break;
+    case 0x2C: r = ReadP4HH; w = WriteP4HH; break;
+    case 0x30: r = ReadZ32; w = WriteZ32; break;
+    case 0x31: r = ReadZ24; w = WriteZ24; break;
+    case 0x32: r = ReadZ16; w = WriteZ16; break;
+    case 0x3A: r = ReadZ16S; w = WriteZ16S; break;
+    default: r = ReadNull; w = WriteNull; break;
+    }
+}
+
+class PgsGsDevice final : public GSGifDevice
+{
+public:
+    ~PgsGsDevice() override
+    {
+        // Worker thread (GS::shutdownGifDevice / setAsync(false)).
+        // Teardown order: the renderer must give back every command buffer it has requested before
+        // Granite's Device::wait_idle(), which first waits (DRAIN_FRAME_LOCK, no timeout) until no
+        // requested-but-unsubmitted command buffer exists. GIF drawing after the last present leaves
+        // such command buffers open in GSRenderer, so waiting for the device first never returns
+        // (observed as a hang after "[gs-vk] shutting down the Vulkan GS device"). Order:
+        //   readback fences -> renderer flush (submits everything) -> renderer destruction
+        //   (flush_submit, compile threads, timeline waiter) -> wait_idle -> readback buffers ->
+        //   Granite device -> Vulkan context.
+        const bool wasInitialized = static_cast<bool>(m_context);
+        const auto t0 = Clock::now();
+        if (m_capture && m_capture->enabled() && m_gs)
+        {
+            stage("capture dump");
+            static const bool onExit = []
+            {
+                const char *e = std::getenv("PS2X_GS_CAPTURE_ON_EXIT");
+                return !(e && e[0] == '0');
+            }();
+            if (onExit)
+                m_capture->dumpNow("shutdown");
+        }
+        Util::set_thread_logging_interface(nullptr);
+        if (wasInitialized)
+            stage("readback fences");
+        for (auto &slot : m_ring)
+            if (slot.fence)
+                slot.fence->wait();
+        if (m_gs)
+        {
+            stage("renderer flush");
+            m_gs->flush();
+            stage("renderer destroy");
+            m_gs.reset();
+        }
+        if (m_device)
+        {
+            stage("device wait idle");
+            m_device->wait_idle();
+        }
+        if (wasInitialized)
+            stage("readback buffers");
+        for (auto &slot : m_ring)
+        {
+            slot.fence.reset();
+            slot.buffer.reset();
+        }
+        if (m_device)
+        {
+            stage("Granite device destroy");
+            m_device.reset();
+        }
+        if (wasInitialized)
+        {
+            stage("Vulkan context destroy");
+            m_context.reset();
+            stage("complete");
+            std::fprintf(stderr, "[gs-vk] device shut down in %.1f ms (frames published %llu)\n", nsSince(t0) / 1e6,
+                         static_cast<unsigned long long>(m_totalPublished));
+            std::fflush(stderr);
+        }
+    }
+
+    bool init(const PgsDeviceConfig &cfg, std::string &error, PgsDeviceInfo &info)
+    {
+        m_cfg = cfg;
+        if (cfg.validation)
+            setEnv("VK_INSTANCE_LAYERS", "VK_LAYER_KHRONOS_validation");
+        reportLoaderEnvironment();
+        // TEST ONLY deterministic failure injection. Every stage after the first fails with the
+        // objects created so far still alive, so the normal destructor path must clean them up.
+        auto inject = [&](const char *stageName) -> bool
+        {
+            if (cfg.faultInject != stageName)
+                return false;
+            error = std::string("FAULT INJECTION (test only): initialization failed at stage '") + stageName + "'";
+            std::fprintf(stderr, "[gs-vk] %s\n", error.c_str());
+            return true;
+        };
+        if (inject("loader"))
+            return false;
+        if (!Vulkan::Context::init_loader(nullptr))
+        {
+            error = "Vulkan loader (vulkan-1) not available";
+            return false;
+        }
+        m_context = std::make_unique<Vulkan::Context>();
+        m_context->set_num_thread_indices(1);
+        if (inject("instance"))
+            return false;
+        if (!m_context->init_instance_and_device(nullptr, 0, nullptr, 0,
+                                                 Vulkan::CONTEXT_CREATION_ENABLE_PUSH_DESCRIPTOR_BIT))
+        {
+            error = "Vulkan instance/device creation failed (no Vulkan driver or no suitable Vulkan 1.1+ device)";
+            return false;
+        }
+        m_device = std::make_unique<Vulkan::Device>();
+        m_device->set_context(*m_context);
+        if (inject("device"))
+            return false;
+        m_device->init_frame_contexts(4);
+        const auto &props = m_device->get_gpu_properties();
+        info.deviceName = props.deviceName;
+        char drv[96];
+        std::snprintf(drv, sizeof(drv), "vendor 0x%04x device 0x%04x driver 0x%08x api %u.%u.%u", props.vendorID,
+                      props.deviceID, props.driverVersion, VK_API_VERSION_MAJOR(props.apiVersion),
+                      VK_API_VERSION_MINOR(props.apiVersion), VK_API_VERSION_PATCH(props.apiVersion));
+        info.driverInfo = drv;
+
+        // Effective sample count is established BEFORE any GS resource is allocated (standalone tests:
+        // requesting more samples than the subgroup sizes allow allocated unusable resources).
+        int dmax = 4;
+        if (m_device->supports_subgroup_size_log2(true, 3, 6))
+            dmax = 8;
+        if (m_device->supports_subgroup_size_log2(true, 4, 6))
+            dmax = 16;
+        int requested = cfg.samples;
+        if (requested != 1 && requested != 4 && requested != 8 && requested != 16)
+            requested = 1;
+        info.samplesRequested = requested;
+        info.samplesDeviceMax = dmax;
+        info.samplesEffective = std::min(requested, dmax);
+        m_samples = info.samplesEffective;
+
+        m_gs = std::make_unique<GSInterface>();
+        GSOptions opts{};
+        opts.super_sampling = toSuperSampling(m_samples);
+        opts.ordered_super_sampling = true;
+        opts.super_sampled_textures = cfg.superSampledTextures;
+        if (!m_gs->init(m_device.get(), opts))
+        {
+            error = "paraLLEl-GS GSInterface::init failed";
+            m_gs.reset();
+            return false;
+        }
+        m_signal.regs = cfg.privRegs;
+        m_signal.stats = &m_stats;
+        m_gs->set_signal_interface(&m_signal);
+        DebugMode dbg{};
+        dbg.deterministic_timeline_query = false; // live play: no per-flush CPU/GPU waits
+        dbg.timestamps = cfg.gpuTimestamps;
+        m_gs->set_debug_mode(dbg);
+
+        // Seed device VRAM with the runtime's host copy (normally all zero at boot).
+        void *dst = m_gs->map_vram_write(0, kVramSize);
+        if (cfg.initialVram && cfg.vramSize >= kVramSize)
+            std::memcpy(dst, cfg.initialVram, kVramSize);
+        else
+            std::memset(dst, 0, kVramSize);
+        m_gs->end_vram_write(0, kVramSize);
+        m_gs->flush();
+        if (inject("renderer"))
+            return false;
+
+        // Renderer warnings into the heartbeat counters and the capture stream (this thread is
+        // the only one calling into the GSInterface).
+        m_logHook.dev = this;
+        Util::set_thread_logging_interface(&m_logHook);
+        if (cfg.capture.ringBytes)
+        {
+            xgsr::FileHeader h;
+            h.samples = uint32_t(m_samples);
+            h.registerStateBytes = uint32_t(sizeof(RegisterState));
+            h.gifPathBytes = uint32_t(sizeof(GIFPath));
+            h.forceProgressive = cfg.forceProgressive ? 1u : 0u;
+            std::snprintf(h.device, sizeof(h.device), "%s", info.deviceName.c_str());
+            std::snprintf(h.build, sizeof(h.build), "ps2x A05 %s %s", __DATE__, __TIME__);
+            m_capture = std::make_unique<xgsr::Recorder>(cfg.capture, h);
+            if (m_capture->enabled())
+                takeKeyframe(); // the session start: seeded VRAM, reset register state
+        }
+        return true;
+    }
+
+    std::string CaptureDump(const std::string &reason) override
+    {
+        return m_capture ? m_capture->dumpNow(reason) : std::string();
+    }
+
+    bool RestoreKeyframe(const uint8_t *payload, size_t bytes, std::string &error) override
+    {
+        xgsr::KeyframeHeader kh;
+        if (bytes < sizeof(kh))
+        {
+            error = "keyframe too small";
+            return false;
+        }
+        std::memcpy(&kh, payload, sizeof(kh));
+        const size_t need = sizeof(kh) + kh.registerStateBytes + 3u * kh.gifPathBytes + kh.vramBytes;
+        if (kh.registerStateBytes != sizeof(RegisterState) || kh.gifPathBytes != sizeof(GIFPath) ||
+            kh.vramBytes != kVramSize || bytes < need)
+        {
+            error = "keyframe layout does not match this renderer build (register state " +
+                    std::to_string(kh.registerStateBytes) + " vs " + std::to_string(sizeof(RegisterState)) + ")";
+            return false;
+        }
+        const uint8_t *p = payload + sizeof(kh);
+        m_gs->reset_context_state();
+        RegisterState regs;
+        std::memcpy(&regs, p, sizeof(regs));
+        p += sizeof(regs);
+        // The CLUT buffer contents are renderer-internal and not in the keyframe: force CLD 2/3 reloads.
+        regs.cached_cbp[0] = regs.cached_cbp[1] = 0xFFFFFFFFu;
+        m_gs->get_register_state() = regs;
+        for (uint32_t i = 0; i < 3; ++i, p += sizeof(GIFPath))
+            std::memcpy(&m_gs->get_gif_path(i), p, sizeof(GIFPath));
+        void *dst = m_gs->map_vram_write(0, kVramSize);
+        std::memcpy(dst, p, kVramSize);
+        m_gs->end_vram_write(0, kVramSize);
+        m_gs->clobber_register_state();
+        m_gs->flush();
+        m_dirty = true;
+        m_haveScanout = false;
+        return true;
+    }
+
+    const char *Name() const override { return "vulkan"; }
+
+    void GifTransfer(GifPathId path, const uint8_t *data, uint32_t sizeBytes) override
+    {
+        if (!data || sizeBytes < 16u)
+            return;
+        const uint32_t index = gifPathIndex(path);
+        if (index > 2u)
+            return;
+        // Only whole qwords exist on the GIF bus; a trailing partial qword cannot be accepted.
+        const uint32_t bytes = sizeBytes & ~15u;
+        if (m_capture)
+            m_capture->record(xgsr::Rec::Gif, uint8_t(index + 1u), data, bytes);
+        const auto t = Clock::now();
+        m_dirty = true;
+        ps2x_setGsDeviceActivity("gif_transfer", index + 1u, bytes);
+        m_gs->gif_transfer(index, data, bytes);
+        ps2x_setGsDeviceActivity("idle");
+        m_stats.gifNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+        m_stats.gifCalls[index].fetch_add(1, std::memory_order_relaxed);
+        m_stats.gifBytes[index].fetch_add(bytes, std::memory_order_relaxed);
+        checkPathIntegrity(index, data, bytes);
+    }
+
+    void WriteRegister(uint8_t addr, uint64_t value) override
+    {
+        m_stats.regWrites.fetch_add(1, std::memory_order_relaxed);
+        if (m_capture)
+        {
+            uint8_t rec[16] = {addr};
+            std::memcpy(rec + 8, &value, 8);
+            m_capture->record(xgsr::Rec::Register, 0, rec, 16);
+        }
+        m_dirty = true;
+        m_gs->write_register(static_cast<RegisterAddr>(addr), value);
+    }
+
+    uint32_t ReadLocalToHost(uint8_t *dst, uint32_t maxBytes) override
+    {
+        if (!dst || maxBytes == 0u)
+            return 0u;
+        const auto t = Clock::now();
+        // The TRXDIR=1 write already synchronized the source pages into the FIFO (paraLLEl-GS
+        // init_transfer); this only copies from it. Partial trailing qwords are read whole.
+        const uint32_t qwords = (maxBytes + 15u) / 16u;
+        if (m_fifoScratch.size() < size_t(qwords) * 16u)
+            m_fifoScratch.resize(size_t(qwords) * 16u);
+        ps2x_setGsDeviceActivity("read_transfer_fifo", maxBytes);
+        m_gs->read_transfer_fifo(m_fifoScratch.data(), qwords);
+        ps2x_setGsDeviceActivity("idle");
+        std::memcpy(dst, m_fifoScratch.data(), maxBytes);
+        if (m_capture)
+        {
+            const uint32_t hdr[2] = {maxBytes, maxBytes};
+            m_capture->record(xgsr::Rec::FifoRead, 0, hdr, 8, dst, maxBytes);
+        }
+        m_stats.fifoReads.fetch_add(1, std::memory_order_relaxed);
+        m_stats.fifoBytes.fetch_add(maxBytes, std::memory_order_relaxed);
+        m_stats.fifoNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+        return maxBytes;
+    }
+
+    PresentationFrame Present(const GSPresentationRequest &request) override
+    {
+        m_stats.presents.fetch_add(1, std::memory_order_relaxed);
+        const uint64_t presentIndex = m_presentIndex++;
+        if (m_capture)
+        {
+            m_capture->record(xgsr::Rec::Present, 0, request.privLo, sizeof(request.privLo), &request.csr, 8);
+            m_capture->notePresent();
+        }
+        ps2x_setGsDeviceActivity("present", presentIndex);
+        auto &priv = m_gs->get_priv_register_state();
+        for (unsigned i = 0; i < 15u; ++i)
+            priv.qwords_lo[i * 2u] = request.privLo[i];
+
+        VSyncInfo info{};
+        info.phase = static_cast<uint32_t>((request.csr >> 13u) & 1u); // CSR.FIELD at the sample
+        info.dst_layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        info.dst_stage = VK_PIPELINE_STAGE_2_COPY_BIT;
+        info.dst_access = VK_ACCESS_2_TRANSFER_READ_BIT;
+        info.force_progressive = m_cfg.forceProgressive || m_samples > 1;
+        info.anti_blur = true;
+        info.raw_circuit_scanout = true;
+        info.adapt_to_internal_horizontal_resolution = true;
+        info.high_resolution_scanout = m_samples >= 4;
+
+        // Nothing drawn or uploaded and the same display registers since the last scanout of a
+        // progressive picture: the scanout would be identical, so skip it (and its readback).
+        // Field parity is irrelevant here: vsync_can_skip() is only true for progressive scanout.
+        const bool sameDisplay = m_haveScanout && std::memcmp(request.privLo, m_lastPrivLo, sizeof(m_lastPrivLo)) == 0;
+        if (!m_dirty && sameDisplay && m_gs->vsync_can_skip(info))
+        {
+            m_stats.skippedScanouts.fetch_add(1, std::memory_order_relaxed);
+        }
+        else
+        {
+            const char *modeName = noteVideoMode(request.privLo[1], request.privLo[2]);
+            const auto tv = Clock::now();
+            // vsync() does not flush the open render pass itself: submit everything drawn so far
+            // first, or the scanout misses the last batch.
+            ps2x_setGsDeviceActivity("present flush+vsync", presentIndex);
+            m_gs->flush();
+            ScanoutResult res = m_gs->vsync(info);
+            m_stats.vsyncNs.fetch_add(nsSince(tv), std::memory_order_relaxed);
+            collectFlushStats();
+            m_dirty = false;
+            m_haveScanout = true;
+            std::memcpy(m_lastPrivLo, request.privLo, sizeof(m_lastPrivLo));
+            if (res.image)
+                queueReadback(*res.image, res.high_resolution_scanout, presentIndex);
+            else
+            {
+                m_stats.emptyScanouts.fetch_add(1, std::memory_order_relaxed);
+                if (!modeName)
+                    m_stats.unsupportedModeScanouts.fetch_add(1, std::memory_order_relaxed);
+            }
+        }
+        ps2x_setGsDeviceActivity("present readback harvest", presentIndex);
+        harvest(m_cfg.syncPresentation);
+        if (m_capture)
+        {
+            if (m_capture->keyframeDue())
+                takeKeyframe();
+            m_capture->onPresentBoundary();
+        }
+        ps2x_setGsDeviceActivity("idle");
+        // The presenter receives the newest completed frame (1-2 presents behind the GS stream):
+        // the GS worker never waits for the GPU in steady state. Unchanged -> no copy at all.
+        if (m_publishedSerial == m_returnedSerial)
+        {
+            PresentationFrame same;
+            same.unchanged = m_returnedSerial != 0;
+            return same;
+        }
+        m_returnedSerial = m_publishedSerial;
+        return std::move(m_published);
+    }
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) override
+    {
+        const auto t = Clock::now();
+        ReadFn r;
+        WriteFn w;
+        pixelFuncs(psm, r, w);
+        const uint32_t page = locatePage(w, base, bw, x, y);
+        ps2x_setGsDeviceActivity("map_vram_read (pixel)", page);
+        const uint8_t *p = static_cast<const uint8_t *>(m_gs->map_vram_read(page * kPageSize, kPageSize));
+        ps2x_setGsDeviceActivity("idle");
+        uint8_t *vram = const_cast<uint8_t *>(p) - page * kPageSize;
+        const uint32_t v = r(vram, base, bw, x, y);
+        if (m_capture)
+        {
+            const uint32_t rec[6] = {psm, base, bw, x, y, v};
+            m_capture->record(xgsr::Rec::VramRead, 0, rec, sizeof(rec));
+        }
+        m_stats.pixelReads.fetch_add(1, std::memory_order_relaxed);
+        m_stats.pixelNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+        return v;
+    }
+
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+    {
+        const auto t = Clock::now();
+        if (m_capture)
+        {
+            const uint32_t rec[6] = {psm, base, bw, x, y, value};
+            m_capture->record(xgsr::Rec::VramWrite, 0, rec, sizeof(rec));
+        }
+        ReadFn r;
+        WriteFn w;
+        pixelFuncs(psm, r, w);
+        const uint32_t page = locatePage(w, base, bw, x, y);
+        uint8_t *p = static_cast<uint8_t *>(m_gs->map_vram_write(page * kPageSize, kPageSize));
+        w(p - page * kPageSize, base, bw, x, y, value);
+        m_gs->end_vram_write(page * kPageSize, kPageSize);
+        m_dirty = true;
+        m_stats.pixelWrites.fetch_add(1, std::memory_order_relaxed);
+        m_stats.pixelNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+    }
+
+    void SnapshotVram(std::vector<uint8_t> &out) override
+    {
+        const auto t = Clock::now();
+        if (m_capture)
+            m_capture->record(xgsr::Rec::VramSnapshot, 0, nullptr, 0);
+        m_gs->flush();
+        const auto *p = static_cast<const uint8_t *>(m_gs->map_vram_read(0, kVramSize));
+        out.assign(p, p + kVramSize);
+        m_stats.vramSnapshots.fetch_add(1, std::memory_order_relaxed);
+        m_stats.vramSnapshotNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+    }
+
+    void IdleFlush() override
+    {
+        // Publish finished readbacks without waiting; optionally kick batched GPU work.
+        harvest(false);
+        if (!m_cfg.idleFlush)
+            return;
+        const auto t = Clock::now();
+        m_gs->flush();
+        m_stats.idleFlushes.fetch_add(1, std::memory_order_relaxed);
+        m_stats.idleFlushNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+    }
+
+    void Reset() override
+    {
+        // Drawing context state only; GS local memory survives a GS reset.
+        if (m_capture)
+            m_capture->record(xgsr::Rec::Reset, 0, nullptr, 0);
+        m_gs->reset_context_state();
+        m_dirty = true;
+    }
+
+    std::string StatsReport() override
+    {
+        char buf[768];
+        const uint64_t presents = take(m_stats.presents);
+        std::snprintf(buf, sizeof(buf),
+                      "  gs-vk X%d: gif p1 %llu/%lluKB p2 %llu/%lluKB p3 %llu/%lluKB in %.1f ms; regs %llu; "
+                      "signal %llu finish %llu label %llu\n"
+                      "  gs-vk present %llu (vsync %.1f ms, empty %llu, skipped %llu), readback submit %llu wait %llu (%.1f ms), "
+                      "published %llu (convert %.1f ms), out %llux%llu%s\n"
+                      "  gs-vk fifo %llu reads %lluKB (%.1f ms), pixel r/w %llu/%llu (%.1f ms), vram snapshots %llu "
+                      "(%.1f ms), idle flushes %llu (%.1f ms); prims %llu passes %llu copies %llu\n",
+                      m_samples, (unsigned long long)take(m_stats.gifCalls[0]),
+                      (unsigned long long)(take(m_stats.gifBytes[0]) >> 10), (unsigned long long)take(m_stats.gifCalls[1]),
+                      (unsigned long long)(take(m_stats.gifBytes[1]) >> 10), (unsigned long long)take(m_stats.gifCalls[2]),
+                      (unsigned long long)(take(m_stats.gifBytes[2]) >> 10), take(m_stats.gifNs) / 1e6,
+                      (unsigned long long)take(m_stats.regWrites), (unsigned long long)take(m_stats.signals),
+                      (unsigned long long)take(m_stats.finishes), (unsigned long long)take(m_stats.labels),
+                      (unsigned long long)presents, take(m_stats.vsyncNs) / 1e6,
+                      (unsigned long long)take(m_stats.emptyScanouts), (unsigned long long)take(m_stats.skippedScanouts),
+                      (unsigned long long)take(m_stats.readbackSubmits),
+                      (unsigned long long)take(m_stats.readbackWaits), take(m_stats.readbackWaitNs) / 1e6,
+                      (unsigned long long)take(m_stats.framesPublished), take(m_stats.convertNs) / 1e6,
+                      (unsigned long long)m_stats.lastWidth.load(), (unsigned long long)m_stats.lastHeight.load(),
+                      m_stats.lastHires.load() ? " hi-res" : "", (unsigned long long)take(m_stats.fifoReads),
+                      (unsigned long long)(take(m_stats.fifoBytes) >> 10), take(m_stats.fifoNs) / 1e6,
+                      (unsigned long long)take(m_stats.pixelReads), (unsigned long long)take(m_stats.pixelWrites),
+                      take(m_stats.pixelNs) / 1e6, (unsigned long long)take(m_stats.vramSnapshots),
+                      take(m_stats.vramSnapshotNs) / 1e6, (unsigned long long)take(m_stats.idleFlushes),
+                      take(m_stats.idleFlushNs) / 1e6, (unsigned long long)take(m_stats.primitives),
+                      (unsigned long long)take(m_stats.renderPasses), (unsigned long long)take(m_stats.copies));
+        std::string out = buf;
+        if (m_stats.modeKnown.load())
+        {
+            const uint64_t s1 = m_stats.modeSmode1.load(), s2 = m_stats.modeSmode2.load();
+            const char *name = pgsVideoModeName(s1, s2);
+            char line[256];
+            std::snprintf(line, sizeof(line),
+                          "  gs-vk video mode %s (SMODE1 0x%llx CMOD %u LC %u, SMODE2 0x%llx INT %u FFMD %u); "
+                          "unsupported-mode scanouts %llu\n",
+                          name ? name : "UNSUPPORTED", (unsigned long long)s1, unsigned(s1 >> 13) & 3u,
+                          unsigned(s1 >> 3) & 0x7Fu, (unsigned long long)s2, unsigned(s2 & 1u), unsigned(s2 >> 1) & 1u,
+                          (unsigned long long)take(m_stats.unsupportedModeScanouts));
+            out += line;
+        }
+        {
+            char line[256];
+            std::snprintf(line, sizeof(line),
+                          "  gs-vk totals: renderer errors %llu warnings %llu (compile stalls %llu); GIF integrity: PATH1 "
+                          "packets ending mid-packet %llu, PATH3 transfers ending mid-packet %llu\n",
+                          (unsigned long long)m_stats.rendererErrors.load(), (unsigned long long)m_stats.rendererWarnings.load(),
+                          (unsigned long long)m_stats.compileStalls.load(), (unsigned long long)m_stats.path1Desync.load(),
+                          (unsigned long long)m_stats.path3Open.load());
+            out += line;
+            if (m_capture)
+                out += m_capture->status();
+        }
+        if (m_cfg.gpuTimestamps)
+        {
+            // Accumulated GPU time per stage (ms, since start), read under the same relaxed rules.
+            std::string ts = m_timestampLine.load();
+            out += ts;
+        }
+        return out;
+    }
+
+private:
+    // ---- diagnostics ----
+    struct LogHook final : Util::LoggingInterface
+    {
+        PgsGsDevice *dev = nullptr;
+        bool log(const char *tag, const char *fmt, va_list va) override
+        {
+            char text[512];
+            std::vsnprintf(text, sizeof(text), fmt, va);
+            if (dev)
+                dev->onRendererLog(tag, text);
+            return false; // keep the normal stderr output
+        }
+    };
+
+    void onRendererLog(const char *tag, const char *text)
+    {
+        const bool error = tag && std::strstr(tag, "ERROR");
+        const bool warn = tag && std::strstr(tag, "WARN");
+        if (!error && !warn)
+            return;
+        const bool compileStall = std::strncmp(text, "Stalled compile", 15) == 0;
+        if (compileStall)
+            m_stats.compileStalls.fetch_add(1, std::memory_order_relaxed);
+        else if (error)
+            m_stats.rendererErrors.fetch_add(1, std::memory_order_relaxed);
+        else
+            m_stats.rendererWarnings.fetch_add(1, std::memory_order_relaxed);
+        if (!m_capture || compileStall)
+            return;
+        std::string t = std::string(tag) + text;
+        while (!t.empty() && (t.back() == '\n' || t.back() == '\r'))
+            t.pop_back();
+        m_capture->recordText(xgsr::Rec::Warning, t);
+        if (m_cfg.capture.dumpOnWarning)
+            m_capture->requestDump("renderer-warning", m_cfg.capture.warningDumpDelay);
+    }
+
+    // PATH1 data comes from XGKICK, which the runtime assembles up to the tag with EOP: after each
+    // transfer the path must be back at a tag boundary with EOP seen. Anything else means the PATH1
+    // stream reaching the renderer is not the GIF packet the VU sent (desynchronized). PATH3 transfers
+    // (GIF DMA) may legitimately end mid-packet; they are only counted.
+    void checkPathIntegrity(uint32_t index, const uint8_t *data, uint32_t bytes)
+    {
+        if (index != 0u && index != 2u)
+            return;
+        const GIFPath &p = m_gs->get_gif_path(index);
+        const bool boundary = p.loop == p.tag.NLOOP && p.reg == 0u;
+        if (index == 2u)
+        {
+            if (!boundary)
+                m_stats.path3Open.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        if (boundary && p.tag.EOP)
+            return;
+        const uint64_t n = m_stats.path1Desync.fetch_add(1, std::memory_order_relaxed) + 1;
+        uint64_t first = 0;
+        if (bytes >= 8)
+            std::memcpy(&first, data, 8);
+        char text[256];
+        std::snprintf(text, sizeof(text),
+                      "PATH1 transfer of %u bytes left the path mid-packet: tag NLOOP %u EOP %u FLG %u NREG %u, loop %u reg %u; "
+                      "first qword 0x%016llx (#%llu)",
+                      bytes, unsigned(p.tag.NLOOP), unsigned(p.tag.EOP), unsigned(p.tag.FLG), unsigned(p.tag.NREG), p.loop,
+                      p.reg, (unsigned long long)first, (unsigned long long)n);
+        if (n <= 20 || (n % 10000) == 0)
+            std::fprintf(stderr, "[gs-vk] GIF INTEGRITY: %s\n", text);
+        if (m_capture)
+        {
+            const uint32_t hdr[2] = {1u, 1u};
+            m_capture->record(xgsr::Rec::Integrity, 1, hdr, 8, text, uint32_t(std::strlen(text)));
+            if (m_cfg.capture.dumpOnWarning)
+                m_capture->requestDump("gif-integrity", m_cfg.capture.warningDumpDelay);
+        }
+    }
+
+    void takeKeyframe()
+    {
+        ps2x_setGsDeviceActivity("capture keyframe");
+        m_gs->flush();
+        xgsr::KeyframeHeader kh;
+        kh.registerStateBytes = sizeof(RegisterState);
+        kh.gifPathBytes = sizeof(GIFPath);
+        kh.vramBytes = kVramSize;
+        for (uint32_t i = 0; i < 3; ++i)
+        {
+            const GIFPath &p = m_gs->get_gif_path(i);
+            if (p.loop != p.tag.NLOOP || p.reg != 0u)
+                kh.flags |= 1u;
+        }
+        std::memcpy(kh.privLo, m_lastPrivLo, sizeof(kh.privLo));
+        std::vector<uint8_t> payload(sizeof(kh) + sizeof(RegisterState) + 3 * sizeof(GIFPath) + kVramSize);
+        uint8_t *p = payload.data();
+        std::memcpy(p, &kh, sizeof(kh));
+        p += sizeof(kh);
+        std::memcpy(p, &m_gs->get_register_state(), sizeof(RegisterState));
+        p += sizeof(RegisterState);
+        for (uint32_t i = 0; i < 3; ++i, p += sizeof(GIFPath))
+            std::memcpy(p, &m_gs->get_gif_path(i), sizeof(GIFPath));
+        const void *vram = m_gs->map_vram_read(0, kVramSize);
+        std::memcpy(p, vram, kVramSize);
+        m_capture->record(xgsr::Rec::Keyframe, 0, payload.data(), uint32_t(payload.size()), nullptr, 0,
+                          uint16_t(kh.flags));
+        ps2x_setGsDeviceActivity("idle");
+    }
+
+    // Logs the video mode the renderer is asked to scan out whenever SMODE1/SMODE2 change; returns
+    // its name, or nullptr when paraLLEl-GS has no timing for it (no picture is produced).
+    const char *noteVideoMode(uint64_t smode1, uint64_t smode2)
+    {
+        const char *name = pgsVideoModeName(smode1, smode2);
+        if (!m_stats.modeKnown.load() || smode1 != m_stats.modeSmode1.load() || smode2 != m_stats.modeSmode2.load())
+        {
+            m_stats.modeSmode1.store(smode1);
+            m_stats.modeSmode2.store(smode2);
+            m_stats.modeKnown.store(true);
+            if (name)
+                std::fprintf(stderr, "[gs-vk] video mode: %s (SMODE1 0x%llx, SMODE2 0x%llx INT %u FFMD %u)\n", name,
+                             (unsigned long long)smode1, (unsigned long long)smode2, unsigned(smode2 & 1u),
+                             unsigned(smode2 >> 1) & 1u);
+            else
+                std::fprintf(stderr,
+                             "[gs-vk] video mode: UNSUPPORTED (SMODE1 0x%llx CMOD %u LC %u, SMODE2 0x%llx): the renderer "
+                             "scans out nothing until the guest programs a supported CRT mode\n",
+                             (unsigned long long)smode1, unsigned(smode1 >> 13) & 3u, unsigned(smode1 >> 3) & 0x7Fu,
+                             (unsigned long long)smode2);
+        }
+        return name;
+    }
+
+    void stage(const char *name)
+    {
+        ps2x_setGsDeviceTeardownStage(name);
+        std::fprintf(stderr, "[gs-vk] shutdown stage: %s\n", name);
+        std::fflush(stderr);
+    }
+
+    struct Slot
+    {
+        Vulkan::BufferHandle buffer;
+        Vulkan::Fence fence;
+        uint32_t width = 0, height = 0;
+        bool hires = false;
+        uint64_t serial = 0;
+        uint64_t presentIndex = 0;
+        bool pending = false;
+    };
+
+    // Finds the 8 KiB page a pixel lives in by writing a marker into a private scratch copy of
+    // the address space (the runtime's swizzle tables, no device access). Rare calls only.
+    uint32_t locatePage(WriteFn w, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        if (m_probe.size() != kVramSize)
+            m_probe.assign(kVramSize, 0u);
+        w(m_probe.data(), base, bw, x, y, 0xFFFFFFFFu);
+        uint32_t page = 0;
+        const uint64_t *q = reinterpret_cast<const uint64_t *>(m_probe.data());
+        for (uint32_t i = 0; i < kVramSize / 8u; ++i)
+            if (q[i])
+            {
+                page = (i * 8u) / kPageSize;
+                std::memset(m_probe.data() + i * 8u, 0, 8u);
+                break;
+            }
+        return page;
+    }
+
+    void collectFlushStats()
+    {
+        FlushStats fs = m_gs->consume_flush_stats();
+        m_stats.primitives.fetch_add(fs.num_primitives, std::memory_order_relaxed);
+        m_stats.renderPasses.fetch_add(fs.num_render_passes, std::memory_order_relaxed);
+        m_stats.copies.fetch_add(fs.num_copies, std::memory_order_relaxed);
+        if (m_cfg.gpuTimestamps)
+        {
+            static const char *names[] = {"sync-h2v", "copy", "palette", "tex-upload", "setup", "binning",
+                                          "shading", "readback", "vsync"};
+            std::string line = "  gs-vk gpu ms (cumulative):";
+            char item[48];
+            for (int i = 0; i < int(TimestampType::Count); ++i)
+            {
+                std::snprintf(item, sizeof(item), " %s %.1f", names[i],
+                              1e3 * m_gs->get_accumulated_timestamps(TimestampType(i)));
+                line += item;
+            }
+            m_timestampLine.store(line + "\n");
+        }
+    }
+
+    void queueReadback(const Vulkan::Image &image, bool hires, uint64_t presentIndex)
+    {
+        const uint32_t w = image.get_width(), h = image.get_height();
+        Slot &slot = m_ring[m_ringNext];
+        m_ringNext = (m_ringNext + 1u) % m_ring.size();
+        if (slot.pending)
+        {
+            // Reusing the slot written three presents ago: normally complete long ago.
+            const auto t = Clock::now();
+            ps2x_setGsDeviceActivity("readback slot fence wait", slot.serial);
+            slot.fence->wait();
+            m_stats.readbackWaits.fetch_add(1, std::memory_order_relaxed);
+            m_stats.readbackWaitNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+            publish(slot);
+        }
+        const VkDeviceSize bytes = VkDeviceSize(w) * h * 4u;
+        if (!slot.buffer || slot.buffer->get_create_info().size < bytes)
+        {
+            Vulkan::BufferCreateInfo bi{};
+            bi.size = bytes;
+            bi.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+            bi.domain = Vulkan::BufferDomain::CachedHost;
+            slot.buffer = m_device->create_buffer(bi);
+        }
+        slot.presentIndex = presentIndex;
+        slot.width = w;
+        slot.height = h;
+        slot.hires = hires;
+        slot.serial = ++m_serial;
+        auto cmd = m_device->request_command_buffer();
+        cmd->copy_image_to_buffer(*slot.buffer, image, 0, {}, {w, h, 1}, 0, 0, {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1});
+        cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_2_HOST_BIT,
+                     VK_ACCESS_2_HOST_READ_BIT);
+        slot.fence.reset();
+        m_device->submit(cmd, &slot.fence);
+        slot.pending = true;
+        m_stats.readbackSubmits.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    // Publishes the newest completed readback. Never blocks unless `wait` is set.
+    void harvest(bool wait)
+    {
+        Slot *best = nullptr;
+        for (auto &slot : m_ring)
+        {
+            if (!slot.pending)
+                continue;
+            if (!wait && !slot.fence->wait_timeout(0))
+                continue;
+            if (wait)
+                slot.fence->wait();
+            if (!best || slot.serial > best->serial)
+                best = &slot;
+        }
+        if (!best)
+            return;
+        // Older completed slots are superseded by the newest one.
+        for (auto &slot : m_ring)
+            if (slot.pending && &slot != best && slot.serial < best->serial && slot.fence->wait_timeout(0))
+                slot.pending = false;
+        publish(*best);
+    }
+
+    void publish(Slot &slot)
+    {
+        slot.pending = false;
+        if (slot.serial <= m_publishedSerial)
+            return; // never go backwards
+        const auto t = Clock::now();
+        const uint32_t w = slot.width, h = slot.height;
+        const auto *px = static_cast<const uint8_t *>(m_device->map_host_buffer(*slot.buffer, Vulkan::MEMORY_ACCESS_READ_BIT));
+        PresentationFrame &f = m_published;
+        // Native-resolution picture in the presenter's 640-wide layout. A hi-res scanout is
+        // reduced by its integer factor (2x2 box) so screenshots/thumbnail paths keep working.
+        const uint32_t div = (w > kHostFrameWidth || slot.hires) ? 2u : 1u;
+        const uint32_t nw = std::min(kHostFrameWidth, w / div), nh = h / div;
+        f.pixels.assign(size_t(kHostFrameWidth) * nh * 4u, 0u);
+        for (uint32_t y = 0; y < nh; ++y)
+        {
+            uint8_t *dst = f.pixels.data() + size_t(y) * kHostFrameWidth * 4u;
+            for (uint32_t x = 0; x < nw; ++x)
+            {
+                uint32_t acc[3] = {0, 0, 0};
+                for (uint32_t dy = 0; dy < div; ++dy)
+                    for (uint32_t dx = 0; dx < div; ++dx)
+                    {
+                        const uint8_t *s = px + (size_t(y * div + dy) * w + (x * div + dx)) * 4u;
+                        acc[0] += s[0];
+                        acc[1] += s[1];
+                        acc[2] += s[2];
+                    }
+                const uint32_t n = div * div;
+                dst[x * 4u + 0u] = uint8_t((acc[0] + n / 2u) / n);
+                dst[x * 4u + 1u] = uint8_t((acc[1] + n / 2u) / n);
+                dst[x * 4u + 2u] = uint8_t((acc[2] + n / 2u) / n);
+                dst[x * 4u + 3u] = 0xFFu;
+            }
+        }
+        f.width = nw;
+        f.height = nh;
+        f.displayFbp = 0;
+        f.sourceFbp = 0;
+        f.usedPreferred = false;
+        // The scanout as produced (any size), opaque, tightly packed: what the window draws.
+        f.hiresPixels.resize(size_t(w) * h * 4u);
+        const uint32_t *in = reinterpret_cast<const uint32_t *>(px);
+        uint32_t *o = reinterpret_cast<uint32_t *>(f.hiresPixels.data());
+        for (size_t i = 0, n = size_t(w) * h; i < n; ++i)
+            o[i] = in[i] | 0xFF000000u;
+        f.hiresWidth = w;
+        f.hiresHeight = h;
+        m_device->unmap_host_buffer(*slot.buffer, Vulkan::MEMORY_ACCESS_READ_BIT);
+        if (m_capture)
+        {
+            // Same hash the replay tool computes from the frame Present returns (opaque RGBA scanout).
+            struct
+            {
+                uint64_t present;
+                uint32_t w, h;
+                uint64_t hash;
+            } rec{slot.presentIndex, w, h, xgsr::fnv1a64(f.hiresPixels.data(), f.hiresPixels.size())};
+            m_capture->record(xgsr::Rec::FrameHash, 0, &rec, sizeof(rec));
+        }
+        m_publishedSerial = slot.serial;
+        ++m_totalPublished;
+        m_stats.framesPublished.fetch_add(1, std::memory_order_relaxed);
+        m_stats.convertNs.fetch_add(nsSince(t), std::memory_order_relaxed);
+        m_stats.lastWidth.store(w);
+        m_stats.lastHeight.store(h);
+        m_stats.lastHires.store(slot.hires ? 1u : 0u);
+    }
+
+    PgsDeviceConfig m_cfg{};
+    std::unique_ptr<xgsr::Recorder> m_capture;
+    LogHook m_logHook;
+    uint64_t m_presentIndex = 0;
+    int m_samples = 1;
+    std::unique_ptr<Vulkan::Context> m_context;
+    std::unique_ptr<Vulkan::Device> m_device;
+    std::unique_ptr<GSInterface> m_gs;
+    SignalAdapter m_signal;
+    Stats m_stats;
+    std::array<Slot, 3> m_ring{};
+    uint32_t m_ringNext = 0;
+    uint64_t m_serial = 0, m_publishedSerial = 0, m_totalPublished = 0, m_returnedSerial = 0;
+    bool m_dirty = true, m_haveScanout = false;
+    uint64_t m_lastPrivLo[15]{};
+    PresentationFrame m_published;
+    std::vector<uint8_t> m_fifoScratch;
+    std::vector<uint8_t> m_probe;
+    struct AtomicLine
+    {
+        std::mutex m;
+        std::string s;
+        void store(std::string v) { std::lock_guard<std::mutex> l(m); s = std::move(v); }
+        std::string load() { std::lock_guard<std::mutex> l(m); return s; }
+    } m_timestampLine;
+};
+} // namespace
+
+std::unique_ptr<GSGifDevice> ps2x_createPgsDevice(const PgsDeviceConfig &config, std::string &error,
+                                                  PgsDeviceInfo *info)
+{
+    PgsDeviceInfo local;
+    PgsDeviceInfo &out = info ? *info : local;
+    auto device = std::make_unique<PgsGsDevice>();
+    try
+    {
+        if (!device->init(config, error, out))
+            return nullptr;
+    }
+    catch (const std::exception &e)
+    {
+        error = std::string("exception during Vulkan initialization: ") + e.what();
+        return nullptr;
+    }
+    return device;
+}
+
+bool ps2x_pgsAvailable()
+{
+    return true;
+}
+
+#else // !PS2X_HAS_PGS
+
+std::unique_ptr<GSGifDevice> ps2x_createPgsDevice(const PgsDeviceConfig &, std::string &error, PgsDeviceInfo *)
+{
+    error = "this build does not include the Vulkan renderer (PS2X_ENABLE_PGS=OFF)";
+    return nullptr;
+}
+
+bool ps2x_pgsAvailable()
+{
+    return false;
+}
+
+#endif
