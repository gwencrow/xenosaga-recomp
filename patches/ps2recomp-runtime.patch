 #include <array>
 #include <cstdint>
 #include <cstring>
@@ -183,12 +185,137 @@ namespace
         std::memcpy(&value, rdram + addr, sizeof(value));
         return value;
     }
+    constexpr uint32_t kServerEntry = 0x00101100u;
+    constexpr uint32_t kRpcEntry = 0x00101110u;
+    constexpr uint32_t kRpcResume = 0x00101120u;
+    constexpr uint32_t kServerQueue = 0x00021000u;
+    constexpr uint32_t kServerDescriptor = 0x00021100u;
+    constexpr uint32_t kServerBuffer = 0x00021200u;
+    constexpr uint32_t kClientDescriptor = 0x00021400u;
+    constexpr uint32_t kServerStackResult = 0x00021300u;
+    constexpr uint32_t kServerThreadStack = 0x00120000u;
+    constexpr uint32_t kArchiveSentinelSize = 0x4000u;
+
+    void testEeRpcServer(uint8_t *rdram, R5900Context *ctx, PS2Runtime *)
+    {
+        const uint32_t stack = getRegU32Result(*ctx, 29);
+        writeGuestU32(rdram, kServerStackResult, stack);
+        writeGuestU32(rdram, stack - sizeof(uint32_t), 0x12345678u);
+        setRegU32(*ctx, 2, kServerBuffer);
+        ctx->pc = 0u;
+    }
+
+    void serveEeRpcLoop(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (readGuestStruct<uint32_t>(rdram, kServerStackResult) != 0)
+            runtime->requestStop();
+        else
+            SifRpcLoop(rdram, ctx, runtime);
+    }
+
+    void serveEeRpcRequest(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        SifGetNextRequest(rdram, ctx, runtime);
+        setRegU32(*ctx, 4, getRegU32Result(*ctx, 2));
+        ctx->pc = kRpcResume;
+        SifExecRequest(rdram, ctx, runtime);
+    }
+
+    void serveEeRpcCompletion(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 4, kClientDescriptor);
+        setRegU32(*ctx, 5, 0x1234u);
+        SifBindRpc(rdram, ctx, runtime);
+
+        setRegU32(*ctx, 4, kClientDescriptor);
+        setRegU32(*ctx, 5, 1u);
+        setRegU32(*ctx, 11, kServerEntry);
+        ctx->pc = kRpcResume;
+        SifCallRpc(rdram, ctx, runtime);
+    }
+
+    enum class RpcPath { Loop, ExplicitRequest, Completion };
+
+    void checkEeRpcStack(TestCase &t, RpcPath path)
+    {
+        PS2Runtime runtime;
+        const bool initialized = runtime.memory().initialize();
+        t.IsTrue(initialized, "initialize guest RAM");
+        if (!initialized)
+            return;
+        ps2_stubs::resetSifState();
+        uint8_t *rdram = runtime.memory().getRDRAM();
+        uint8_t *archive = rdram + PS2_RAM_SIZE - kArchiveSentinelSize;
+        std::memset(archive, 0xA5, kArchiveSentinelSize);
+
+        runtime.registerFunction(kServerEntry, testEeRpcServer);
+        auto entry = serveEeRpcLoop;
+        if (path == RpcPath::ExplicitRequest)
+            entry = serveEeRpcRequest;
+        if (path == RpcPath::Completion)
+            entry = serveEeRpcCompletion;
+        runtime.registerFunction(kRpcEntry, entry);
+        runtime.registerFunction(kRpcResume, [](uint8_t *, R5900Context *, PS2Runtime *rt)
+                                 { rt->requestStop(); });
+        R5900Context context{};
+        setRegU32(context, 4, kServerDescriptor);
+        setRegU32(context, 5, 0x1234u);
+        setRegU32(context, 6, path == RpcPath::Completion ? 0u : kServerEntry);
+        setRegU32(context, 7, kServerBuffer);
+        setRegU32(context, 10, kServerQueue);
+        SifRegisterRpc(rdram, &context, &runtime);
+
+        if (path != RpcPath::Completion)
+        {
+            ps2x::iop::EeRpcCall call{};
+            call.sid = 0x1234u;
+            call.send = {0x42};
+            const bool queued = queueEeRpcFromIop(&runtime, std::move(call));
+            t.IsTrue(queued, "queue an IOP call to the guest server");
+            if (!queued)
+                return;
+        }
+        else
+        {
+            setRegU32(context, 6, 0u);
+            setRegU32(context, 7, 0u);
+            setRegU32(context, 10, 0u);
+        }
+
+        context.pc = kRpcEntry;
+        setRegU32(context, 4, kServerQueue);
+        setRegU32(context, 29, kServerThreadStack);
+        runtime.eeScheduler().reset(rdram, context);
+        runtime.eeScheduler().run();
+
+        const uint32_t stack = readGuestStruct<uint32_t>(rdram, kServerStackResult);
+        t.IsTrue(stack < kServerThreadStack && stack >= kServerThreadStack - 0x100u,
+                 "RPC invocation entered on the guest thread stack");
+        t.IsTrue(std::all_of(archive, archive + kArchiveSentinelSize,
+                             [](uint8_t b) { return b == 0xA5; }),
+                 "RPC invocation left the archive at the top of RDRAM intact");
+        if (path != RpcPath::Completion)
+            t.Equals(rdram[kServerBuffer], uint8_t{0x42}, "server received the request data");
+    }
+
 }
 
 void register_ps2_sif_rpc_tests()
 {
     MiniTest::Case("PS2SifRpc", [](TestCase &tc)
     {
+        tc.Run("SifRpcLoop uses the guest server thread stack", [](TestCase &t)
+        {
+            checkEeRpcStack(t, RpcPath::Loop);
+        });
+        tc.Run("SifExecRequest uses the guest caller stack", [](TestCase &t)
+        {
+            checkEeRpcStack(t, RpcPath::ExplicitRequest);
+        });
+        tc.Run("SifCallRpc completion uses the guest caller stack", [](TestCase &t)
+        {
+            checkEeRpcStack(t, RpcPath::Completion);
+        });
         tc.Run("SifInitRpc does not reset the running IOP", [](TestCase &t)
         {
             TestEnv env;
