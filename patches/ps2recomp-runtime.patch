+        const float dpi = static_cast<float>(GetRenderWidth()) / std::max(1, GetScreenWidth());
+        const int kx = std::max(1, static_cast<int>(std::ceil(dst.width * dpi / srcW)));
+        const int ky = std::max(1, static_cast<int>(std::ceil(dst.height * dpi / srcH)));
+        const int w = static_cast<int>(srcW) * kx;
+        const int h = static_cast<int>(srcH) * ky;
+        Presenter &p = g_presenter;
+        if (w != p.prescaleW || h != p.prescaleH)
+        {
+            if (p.prescaleW != 0)
+                UnloadRenderTexture(p.prescale);
+            p.prescale = LoadRenderTexture(w, h);
+            SetTextureFilter(p.prescale.texture, TEXTURE_FILTER_BILINEAR);
+            p.prescaleW = w;
+            p.prescaleH = h;
+        }
+        SetTextureFilter(frameTex, TEXTURE_FILTER_POINT);
+        BeginTextureMode(p.prescale);
+        ClearBackground(BLACK);
+        DrawTexturePro(frameTex, Rectangle{0.0f, 0.0f, srcW, srcH},
+                       Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)}, Vector2{0.0f, 0.0f}, 0.0f,
+                       WHITE);
+        EndTextureMode();
+    }
+
+    void drawGameFrame(Texture2D &frameTex, float srcW, float srcH, float shapeW, float shapeH)
+    {
+        const Rectangle dst = computeDestination(shapeW, shapeH);
+        if (!useSharpFilter())
+        {
+            SetTextureFilter(frameTex, g_hostSettings.filter == "smooth" ? TEXTURE_FILTER_BILINEAR : TEXTURE_FILTER_POINT);
+            DrawTexturePro(frameTex, Rectangle{0.0f, 0.0f, srcW, srcH}, dst, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+            return;
+        }
+        // Render textures are stored upside down.
+        const Presenter &p = g_presenter;
+        DrawTexturePro(p.prescale.texture,
+                       Rectangle{0.0f, 0.0f, static_cast<float>(p.prescaleW), -static_cast<float>(p.prescaleH)}, dst,
+                       Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+    }
+
+    void saveScreenshot()
+    {
+        rlDrawRenderBatchActive(); // the frame is still queued in raylib's batch
+        // Not LoadImageFromScreen: on scaled (high-DPI) desktops it reads past
+        // the real framebuffer and the picture comes out shifted into a corner.
+        Image shot{};
+        shot.width = GetRenderWidth();
+        shot.height = GetRenderHeight();
+        shot.mipmaps = 1;
+        shot.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+        shot.data = rlReadScreenPixels(shot.width, shot.height);
+        ImageFormat(&shot, PIXELFORMAT_UNCOMPRESSED_R8G8B8); // no transparency in the PNG
+        const std::string dir = std::string(GetApplicationDirectory()) + "screenshots";
+        if (!DirectoryExists(dir.c_str()))
+            MakeDirectory(dir.c_str());
+        const std::time_t now = std::time(nullptr);
+        char stamp[32];
+        std::strftime(stamp, sizeof(stamp), "%Y%m%d_%H%M%S", std::localtime(&now));
+        static int sequence = 0;
+        const std::string path = dir + "/xenosaga_" + stamp + "_" + std::to_string(sequence++) + ".png";
+        // Encoding a PNG takes a moment; do it off the presentation thread.
+        std::thread([shot, path]() mutable
+                    {
+            ExportImage(shot, path.c_str());
+            UnloadImage(shot); })
+            .detach();
+        showNotice("Screenshot saved");
+    }
+
+    // Change one key in settings.ini, keeping its comments and layout; a key
+    // the file doesn't have yet goes at the end of its section.
+    void saveSettingValue(const std::string &key, const std::string &value)
+    {
+        if (g_settingsPath.empty())
+            return;
+        std::vector<std::string> lines;
+        {
+            std::ifstream in(g_settingsPath);
+            std::string line;
+            while (std::getline(in, line))
+                lines.push_back(line);
+        }
+        bool done = false;
+        for (std::string &line : lines)
+        {
+            const std::string t = trimCopy(line);
+            if (t.empty() || t[0] == ';' || t[0] == '#' || t[0] == '[')
+                continue;
+            const auto eq = t.find('=');
+            if (eq != std::string::npos && trimCopy(t.substr(0, eq)) == key)
+            {
+                line = key + " = " + value;
+                done = true;
+                break;
+            }
+        }
+        if (!done)
+        {
+            const std::string section = (key == "volume" || key == "mute_when_unfocused") ? "[audio]"
+                                        : (key == "one_hit_kill" || key == "no_encounters") ? "[debug]"
+                                                                                             : "[display]";
+            bool hasSection = false;
+            for (const std::string &line : lines)
+                hasSection = hasSection || trimCopy(line) == section;
+            if (!hasSection)
+            {
+                lines.push_back("");
+                lines.push_back(section);
+                lines.push_back("; Testing aids, also in the F1 menu.");
+            }
+            size_t at = lines.size();
+            for (size_t i = 0; i < lines.size(); ++i)
+                if (trimCopy(lines[i]) == section)
+                {
+                    at = i + 1;
+                    while (at < lines.size() && !trimCopy(lines[at]).empty() && trimCopy(lines[at])[0] != '[')
+                        ++at;
+                    break;
+                }
+            lines.insert(lines.begin() + static_cast<std::ptrdiff_t>(at), key + " = " + value);
+        }
+        std::ofstream out(g_settingsPath, std::ios::trunc);
+        for (const std::string &line : lines)
+            out << line << "\n";
+        g_rawSettings[key] = value;
+    }
+
+    void setAspect(const std::string &aspect)
+    {
+        g_hostSettings.aspect = aspect;
+        g_widescreen.store(aspect == "16:9");
+        // Widescreen also draws more pixels across (GPU renderer).
+        ps2x_glSetResolution(g_hostSettings.upscale, aspect == "16:9");
+    }
+
+    void handleHostHotkeys()
+    {
+        HostSettings &s = g_hostSettings;
+        const bool alt = IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT);
+        if (IsKeyPressed(KEY_F11) || (alt && IsKeyPressed(KEY_ENTER)))
+        {
+            ToggleBorderlessWindowed();
+            showNotice(IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE) ? "Fullscreen" : "Windowed");
+        }
+        if (IsKeyPressed(KEY_F3))
+            s.showFps = !s.showFps;
+        if (IsKeyPressed(KEY_F4))
+        {
+            s.filter = s.filter == "sharp" ? "smooth" : (s.filter == "smooth" ? "pixel" : "sharp");
+            showNotice("Filter: " + s.filter);
+        }
+        if (IsKeyPressed(KEY_F5))
+        {
+            setAspect(s.aspect == "4:3" ? "16:9" : (s.aspect == "16:9" ? "stretch" : (s.aspect == "stretch" ? "native" : "4:3")));
+            showNotice("Picture: " + s.aspect);
+        }
+        if (IsKeyPressed(KEY_F12))
+            saveScreenshot();
+    }
+
+    void updateHostWindowState()
+    {
+        Presenter &p = g_presenter;
+        const double now = GetTime();
+        // Mouse pointer: hide over the game when idle.
+        const Vector2 mouse = GetMousePosition();
+        if (mouse.x != p.lastMouse.x || mouse.y != p.lastMouse.y)
+        {
+            p.lastMouse = mouse;
+            p.lastMouseMove = now;
+        }
+        const bool wantHidden = g_hostSettings.hideCursor && IsWindowFocused() && now - p.lastMouseMove > 2.0;
+        if (wantHidden != p.cursorHidden)
+        {
+            if (wantHidden)
+                HideCursor();
+            else
+                ShowCursor();
+            p.cursorHidden = wantHidden;
+        }
+        // Volume, muted while another window is in front.
+        const bool focused = IsWindowFocused();
+        const float volume = (g_hostSettings.muteWhenUnfocused && !focused) ? 0.0f : g_hostSettings.volume / 100.0f;
+        SetMasterVolume(volume);
+        p.wasFocused = focused;
+    }
+
+    // Frames the window actually shows: new game frames the GS handed over,
+    // which is what the player sees.
+    void countGameFrame()
+    {
+        Presenter &p = g_presenter;
+        static int logFrames = 0;
+        static uint64_t lastCount = 0;
+        const uint64_t count = ps2x_presentedFrameCount();
+        p.flips += static_cast<int>(count - lastCount);
+        logFrames += static_cast<int>(count - lastCount);
+        lastCount = count;
+        const double now = GetTime();
+        static double logStart = now;
+        if (now - logStart >= 5.0)
+        {
+            std::printf("[present] window showed %.1f new frames/s\n", logFrames / (now - logStart));
+            logStart = now;
+            logFrames = 0;
+        }
+        if (now - p.fpsWindowStart >= 0.5)
+        {
+            p.gameFps = static_cast<float>(p.flips / (now - p.fpsWindowStart));
+            p.flips = 0;
+            p.fpsWindowStart = now;
+        }
+    }
+
+    void drawHostOverlay()
+    {
+        Presenter &p = g_presenter;
+        const int size = std::max(20, GetScreenHeight() / 36);
+        if (g_hostSettings.showFps)
+        {
+            // The active GS implementation is shown with the frame rate (test evidence).
+            const char *text = TextFormat("%.0f FPS  %s", p.gameFps, g_rendererTag.c_str());
+            DrawRectangle(8, 8, MeasureText(text, size) + 16, size + 10, Color{0, 0, 0, 160});
+            DrawText(text, 16, 13, size, p.gameFps >= 29.0f ? GREEN : (p.gameFps >= 20.0f ? YELLOW : RED));
+        }
+        if (const char *badge = g_hostBadge.load(std::memory_order_relaxed))
+        {
+            const int y = g_hostSettings.showFps ? 13 + size + 16 : 13;
+            DrawRectangle(8, y - 5, MeasureText(badge, size) + 16, size + 10, Color{0, 0, 0, 160});
+            DrawText(badge, 16, y, size, Color{120, 200, 255, 255});
+        }
+        if (GetTime() < p.noticeUntil && !p.notice.empty())
+        {
+            const int w = MeasureText(p.notice.c_str(), size);
+            const int x = (GetScreenWidth() - w) / 2;
+            const int y = GetScreenHeight() - size * 3;
+            DrawRectangle(x - 16, y - 8, w + 32, size + 16, Color{0, 0, 0, 180});
+            DrawText(p.notice.c_str(), x, y, size, RAYWHITE);
+        }
+    }
+}
