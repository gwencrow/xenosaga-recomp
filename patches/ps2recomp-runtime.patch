+#ifdef _WIN32
+extern "C" __declspec(dllimport) void *__stdcall GetCurrentThread(void);
+extern "C" __declspec(dllimport) int __stdcall SetThreadPriority(void *thread, int priority);
+#endif
+namespace
+{
+    // PS2X_THREAD_PRIORITIES=0 leaves every thread at normal priority. On
+    // hybrid CPUs (P- and E-cores) Windows puts higher-priority threads on
+    // P-cores: the VIF1/VU1 worker sets the frame rate, the GS band helpers
+    // have headroom.
+    void setHostThreadPriority(int priority)
+    {
+#ifdef _WIN32
+        static const bool enabled = [] {
+            const char *env = std::getenv("PS2X_THREAD_PRIORITIES");
+            return !(env && env[0] == '0');
+        }();
+        if (enabled)
+            SetThreadPriority(GetCurrentThread(), priority);
+#else
+        (void)priority;
+#endif
+    }
+}
