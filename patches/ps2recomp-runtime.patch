+    ivec4 s1; // wrapU, wrapV, texW, texH
+    ivec4 s2; // minU, maxU, minV, maxV
+    ivec4 s3; // ate, atst, aref, afail
+    ivec4 s4; // ztst, zwrite, abe, fba
+    ivec4 s5; // asel, bsel, csel, dsel
+    ivec4 s6; // fix, fst, iip, clutRow
+    ivec4 s7; // date, datm, pabe, sprite
