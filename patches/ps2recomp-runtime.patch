@@ -0,0 +1,467 @@
+// DMA source-chain traversal (VIF1 channel 0x10009000, GIF channel 0x1000A000) as seen by the
+// GIF paths, through PS2Memory's real kick path (D1_TADR/CHCR writes, async VIF1 worker, raw ingress).
+//
+// Properties checked against an independent model of the DMAC tag semantics:
+//  - a valid chain is transferred completely, however many tags it has (the former walker stopped at
+//    4096 tags, dropped the rest and still reported completion);
+//  - after the kick, TADR points past the terminating tag and the channel completed (CIS set);
+//  - a GIF packet whose DIRECT spans DMA tags across the old limit leaves PATH2 at a packet boundary,
+//    so the next kick's GIFtag is parsed as a tag (formerly it was parsed as payload: desynchronization);
+//  - CALL/RET nesting, repeated references, TTE, REFE/RET(ASP 0)/IRQ+TIE/END termination, scratchpad
+//    addressing, GIF-channel (PATH3) chains;
+//  - malformed chains terminate: endless NEXT/CALL cycles and out-of-range tag addresses.
+// No GPU needed. Exit 0 = all checks pass.
+#include "ps2_runtime.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+#include "runtime/ps2_memory.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace
+{
+int g_failures = 0, g_checks = 0;
+
+void check(bool ok, const std::string &what)
+{
+    ++g_checks;
+    if (!ok)
+    {
+        ++g_failures;
+        std::printf("  FAIL: %s\n", what.c_str());
+    }
+}
+
+void run(const char *name, const std::function<void()> &body)
+{
+    const int before = g_failures;
+    std::printf("[test] %s\n", name);
+    body();
+    std::printf("[%s] %s\n", g_failures == before ? "PASS" : "FAIL", name);
+}
+
+constexpr uint32_t D1 = 0x10009000u, D2 = 0x1000A000u, DSTAT = 0x1000E010u;
+constexpr uint32_t CHCR_STR = 0x100u, CHCR_CHAIN = 1u << 2, CHCR_TTE = 0x40u, CHCR_TIE = 0x80u;
+
+enum Id : uint32_t { REFE = 0, CNT = 1, NEXT = 2, REF = 3, REFS = 4, CALL = 5, RET = 6, END = 7 };
+
+uint64_t dmaTag(Id id, uint32_t qwc, uint32_t addr, bool irq = false)
+{
+    return uint64_t(qwc & 0xFFFF) | (uint64_t(id) << 28) | (irq ? 1ull << 31 : 0) | (uint64_t(addr) << 32);
+}
+
+uint64_t gifTag(uint32_t nloop, bool eop, uint32_t flg, uint32_t nreg)
+{
+    return uint64_t(nloop & 0x7FFF) | (eop ? 1ull << 15 : 0) | (uint64_t(flg) << 58) | (uint64_t(nreg & 0xF) << 60);
+}
+
+uint32_t vifCmd(uint32_t cmd, uint32_t num, uint32_t imm) { return (cmd << 24) | (num << 16) | (imm & 0xFFFF); }
+
+struct Qw
+{
+    uint64_t lo, hi;
+};
+
+// Guest memory writer.
+struct Ram
+{
+    uint8_t *base;
+    void qw(uint32_t addr, uint64_t lo, uint64_t hi)
+    {
+        std::memcpy(base + addr, &lo, 8);
+        std::memcpy(base + addr + 8, &hi, 8);
+    }
+    void tag(uint32_t addr, uint64_t t, uint32_t vif0 = 0, uint32_t vif1 = 0)
+    {
+        qw(addr, t, uint64_t(vif0) | (uint64_t(vif1) << 32));
+    }
+};
+
+// One VIF quadword "NOP NOP NOP DIRECT n" (the DIRECT data that follows stays qword aligned).
+Qw directHeader(uint32_t n) { return {0, uint64_t(vifCmd(0x50, 0, n)) << 32}; }
+
+// A+D packet of `n` writes to the non-register address 0x7F, data words carrying `id`.
+std::vector<Qw> adPacket(uint32_t n, uint64_t id)
+{
+    std::vector<Qw> v{{gifTag(n, true, 0, 1), 0xE}};
+    for (uint32_t i = 0; i < n; ++i)
+        v.push_back({(id << 16) | i, 0x7F});
+    return v;
+}
+
+void appendQws(std::vector<uint8_t> &s, const std::vector<Qw> &q)
+{
+    for (const Qw &x : q)
+    {
+        const size_t at = s.size();
+        s.resize(at + 16);
+        std::memcpy(s.data() + at, &x.lo, 8);
+        std::memcpy(s.data() + at + 8, &x.hi, 8);
+    }
+}
+
+// Independent GIF path cursor (GS manual: PACKED / REGLIST / IMAGE, NLOOP/NREG).
+struct GifCursor
+{
+    uint32_t nloop = 0, loop = 0, nreg = 16, reg = 0, flg = 0;
+    uint64_t tags = 0;
+    bool atBoundary() const { return loop == nloop; }
+    void feed(const uint8_t *d, size_t n)
+    {
+        for (size_t o = 0; o + 16 <= n; o += 16)
+        {
+            uint64_t lo;
+            std::memcpy(&lo, d + o, 8);
+            if (loop == nloop)
+            {
+                nloop = uint32_t(lo & 0x7FFF);
+                flg = uint32_t((lo >> 58) & 3);
+                nreg = uint32_t((lo >> 60) & 0xF);
+                if (!nreg)
+                    nreg = 16;
+                loop = reg = 0;
+                ++tags;
+                continue;
+            }
+            if (flg == 0)
+            {
+                if (++reg == nreg)
+                    reg = 0, ++loop;
+            }
+            else if (flg == 1)
+            {
+                for (int w = 0; w < 2 && loop != nloop; ++w)
+                    if (++reg == nreg)
+                        reg = 0, ++loop;
+            }
+            else
+                ++loop;
+        }
+    }
+};
+
+struct Rig
+{
+    PS2Memory mem;
+    std::vector<uint8_t> path[4];
+    GifArbiter arb{[this](GifPathId p, const uint8_t *d, uint32_t n) { path[int(p)].insert(path[int(p)].end(), d, d + n); }};
+    Ram ram{nullptr};
+    bool ok = false;
+    Rig()
+    {
+        ok = mem.initialize();
+        mem.setGifArbiter(&arb);
+        mem.setRawGifIngress(true);
+        ram.base = mem.getRDRAM();
+    }
+    void clear()
+    {
+        for (auto &p : path)
+            p.clear();
+    }
+    // Kick a source chain like the game: TADR, then CHCR with STR; then wait for the VIF1 worker.
+    void kick(uint32_t channel, uint32_t tadr, uint32_t extra = 0)
+    {
+        mem.writeIORegister(channel + 0x30u, tadr);
+        mem.writeIORegister(channel + 0x00u, CHCR_STR | CHCR_CHAIN | extra);
+        mem.syncVif1();
+    }
+    uint32_t tadr(uint32_t channel) { return mem.readIORegister(channel + 0x30u); }
+    bool cis(uint32_t bit)
+    {
+        const bool set = (mem.readIORegister(DSTAT) & (1u << bit)) != 0;
+        mem.writeIORegister(DSTAT, 1u << bit); // W1C for the next kick
+        return set;
+    }
+};
+
+// CNT chain of `tags` tags, each one A+D packet behind a DIRECT; END at the end. Returns the
+// expected PATH2 stream and the address of the END tag (the DMAC leaves TADR on an END tag; only
+// MADR moves past it -- same as PCSX2's TAG_END handling).
+std::vector<uint8_t> buildCntChain(Ram &ram, uint32_t at, uint32_t tags, uint32_t &endNext, uint64_t idBase = 0)
+{
+    std::vector<uint8_t> expect;
+    for (uint32_t t = 0; t < tags; ++t)
+    {
+        const auto pkt = adPacket(1, idBase + t);
+        const bool last = t + 1 == tags;
+        if (last)
+            endNext = at;
+        ram.tag(at, dmaTag(last ? END : CNT, 1 + uint32_t(pkt.size()), 0));
+        const Qw h = directHeader(uint32_t(pkt.size()));
+        ram.qw(at + 16, h.lo, h.hi);
+        for (size_t i = 0; i < pkt.size(); ++i)
+            ram.qw(at + 32 + uint32_t(i) * 16, pkt[i].lo, pkt[i].hi);
+        appendQws(expect, pkt);
+        at += 32 + uint32_t(pkt.size()) * 16;
+    }
+    return expect;
+}
+} // namespace
+
+int main()
+{
+    run("long valid VIF1 chain (6000 CNT tags + END) is transferred completely and completes", []
+        {
+        Rig r;
+        check(r.ok, "memory init");
+        uint32_t endNext = 0;
+        const auto expect = buildCntChain(r.ram, 0x100000, 6000, endNext);
+        r.cis(1);
+        r.kick(D1, 0x100000);
+        check(r.path[2].size() == expect.size(), "PATH2 bytes " + std::to_string(r.path[2].size()) + " == " +
+                                                     std::to_string(expect.size()));
+        check(r.path[2] == expect, "PATH2 stream identical to every DIRECT payload in chain order");
+        check(r.tadr(D1) == endNext, "TADR on the END tag (" + std::to_string(r.tadr(D1)) + ")");
+        check(r.cis(1), "D_STAT CIS1 raised"); });
+
+    run("exactly 4096 and 4097 tags (limit boundary)", []
+        {
+        for (uint32_t n : {4095u, 4096u, 4097u})
+        {
+            Rig r;
+            uint32_t endNext = 0;
+            const auto expect = buildCntChain(r.ram, 0x200000, n, endNext);
+            r.kick(D1, 0x200000);
+            check(r.path[2] == expect, std::to_string(n) + " tags: complete stream");
+            check(r.tadr(D1) == endNext, std::to_string(n) + " tags: TADR on the END tag");
+        } });
+
+    run("GIF packet spanning DMA tags across the old 4096-tag point keeps PATH2 in sync for the next kick", []
+        {
+        Rig r;
+        // 4095 CNT packets, then tag 4096 = CNT with a DIRECT opening an IMAGE packet of 64 qwords whose
+        // pixels come from 8 REF tags (8 qwords each) -- the xglPacketTextureTrans shape -- then END.
+        uint32_t at = 0x300000;
+        std::vector<uint8_t> expect;
+        for (uint32_t t = 0; t < 4095; ++t)
+        {
+            const auto pkt = adPacket(1, t);
+            r.ram.tag(at, dmaTag(CNT, 3, 0));
+            const Qw h = directHeader(2);
+            r.ram.qw(at + 16, h.lo, h.hi);
+            r.ram.qw(at + 32, pkt[0].lo, pkt[0].hi);
+            r.ram.qw(at + 48, pkt[1].lo, pkt[1].hi);
+            appendQws(expect, pkt);
+            at += 64;
+        }
+        const uint32_t pixels = 0x380000;
+        r.ram.tag(at, dmaTag(CNT, 2, 0)); // tag #4096
+        const Qw h = directHeader(1 + 64);
+        r.ram.qw(at + 16, h.lo, h.hi);
+        r.ram.qw(at + 32, gifTag(64, true, 2, 0), 0);
+        appendQws(expect, {{gifTag(64, true, 2, 0), 0}});
+        at += 48;
+        for (int i = 0; i < 8; ++i)
+        {
+            r.ram.tag(at, dmaTag(i == 7 ? REFE : REF, 8, pixels + uint32_t(i) * 128));
+            at += 16;
+        }
+        for (uint32_t q = 0; q < 64; ++q)
+        {
+            r.ram.qw(pixels + q * 16, 0xA000 + q, 0xB000 + q);
+            appendQws(expect, {{0xA000 + q, 0xB000 + q}});
+        }
+        r.kick(D1, 0x300000);
+        check(r.path[2] == expect, "first kick: complete PATH2 stream including all 64 pixel qwords");
+        GifCursor c;
+        c.feed(r.path[2].data(), r.path[2].size());
+        check(c.atBoundary(), "PATH2 at a packet boundary after the first kick");
+        // Next frame: a small chain with one A+D packet.
+        r.clear();
+        uint32_t endNext = 0;
+        const auto second = buildCntChain(r.ram, 0x3C0000, 2, endNext, 0x777);
+        r.kick(D1, 0x3C0000);
+        const uint64_t tagsBefore = c.tags;
+        c.feed(r.path[2].data(), r.path[2].size());
+        check(r.path[2] == second, "second kick: its own stream");
+        check(c.tags == tagsBefore + 2 && c.atBoundary(), "second kick's GIFtags parsed as tags (no desynchronization)"); });
+
+    run("CALL/RET nesting (2 levels) with 5000 repeated REFs of one block", []
+        {
+        Rig r;
+        // block: DIRECT + A+D packet (3 qwords), referenced 5000 times from sub2.
+        const uint32_t block = 0x400000;
+        const auto pkt = adPacket(1, 0xB10C);
+        const Qw h = directHeader(2);
+        r.ram.qw(block, h.lo, h.hi);
+        r.ram.qw(block + 16, pkt[0].lo, pkt[0].hi);
+        r.ram.qw(block + 32, pkt[1].lo, pkt[1].hi);
+        // main @0x410000: CALL sub1 (with its own packet), then END (with a packet).
+        // sub1 @0x420000: CALL sub2 (packet), RET (packet). sub2 @0x430000: 5000 REF block, RET.
+        std::vector<uint8_t> expect;
+        auto cntWithPacket = [&](uint32_t at, Id id, uint32_t addr, uint64_t pid) {
+            const auto p = adPacket(1, pid);
+            r.ram.tag(at, dmaTag(id, 3, addr));
+            r.ram.qw(at + 16, h.lo, h.hi);
+            r.ram.qw(at + 32, p[0].lo, p[0].hi);
+            r.ram.qw(at + 48, p[1].lo, p[1].hi);
+            return p;
+        };
+        appendQws(expect, cntWithPacket(0x410000, CALL, 0x420000, 1));
+        appendQws(expect, cntWithPacket(0x420000, CALL, 0x430000, 2));
+        uint32_t at = 0x430000;
+        for (int i = 0; i < 5000; ++i, at += 16)
+        {
+            r.ram.tag(at, dmaTag(REF, 3, block));
+            appendQws(expect, pkt);
+        }
+        appendQws(expect, cntWithPacket(at, RET, 0, 3)); // sub2 RET -> back into sub1
+        appendQws(expect, cntWithPacket(0x420040, RET, 0, 4)); // sub1 RET -> back into main
+        appendQws(expect, cntWithPacket(0x410040, END, 0, 5));
+        r.kick(D1, 0x410000);
+        check(r.path[2] == expect, "every level's payload, 5000 repeated references, in call order");
+        check(r.tadr(D1) == 0x410040, "TADR on main's END tag");
+        check(((r.mem.readIORegister(D1) >> 4) & 3u) == 0u, "ASP back to 0"); });
+
+    run("TTE: VIFcodes in the tag's upper half, 5000 REF tags", []
+        {
+        Rig r;
+        const uint32_t data = 0x500000;
+        const auto pkt = adPacket(1, 0x77E);
+        r.ram.qw(data, pkt[0].lo, pkt[0].hi);
+        r.ram.qw(data + 16, pkt[1].lo, pkt[1].hi);
+        std::vector<uint8_t> expect;
+        uint32_t at = 0x510000;
+        for (int i = 0; i < 5000; ++i, at += 16)
+        {
+            r.ram.tag(at, dmaTag(i == 4999 ? REFE : REF, 2, data), 0, vifCmd(0x50, 0, 2)); // NOP, DIRECT 2
+            appendQws(expect, pkt);
+        }
+        r.kick(D1, 0x510000, CHCR_TTE);
+        check(r.path[2] == expect, "DIRECT from each tag's upper words + REF payload, all 5000");
+        check(r.tadr(D1) == at, "TADR after REFE"); });
+
+    run("termination: REFE, END, RET with ASP 0, IRQ with TIE (and IRQ without TIE continues)", []
+        {
+        Rig r;
+        const auto pkt = adPacket(1, 0xE);
+        const Qw h = directHeader(2);
+        auto block = [&](uint32_t at, Id id, uint32_t addr, bool irq) {
+            r.ram.tag(at, dmaTag(id, 3, addr, irq));
+            r.ram.qw(at + 16, h.lo, h.hi);
+            r.ram.qw(at + 32, pkt[0].lo, pkt[0].hi);
+            r.ram.qw(at + 48, pkt[1].lo, pkt[1].hi);
+        };
+        std::vector<uint8_t> one, two;
+        appendQws(one, pkt);
+        two = one;
+        two.insert(two.end(), one.begin(), one.end());
+        // RET with ASP 0 ends the chain after its data.
+        block(0x600000, RET, 0, false);
+        block(0x600040, CNT, 0, false);
+        r.kick(D1, 0x600000);
+        check(r.path[2] == one, "RET (ASP 0): its data only");
+        // IRQ + TIE stops after the tag's data; without TIE the chain continues to END.
+        r.clear();
+        block(0x601000, CNT, 0, true);
+        block(0x601040, END, 0, false);
+        r.kick(D1, 0x601000, CHCR_TIE);
+        check(r.path[2] == one && r.tadr(D1) == 0x601040, "IRQ+TIE: stops, TADR at the next tag");
+        r.clear();
+        r.kick(D1, 0x601000);
+        check(r.path[2] == two, "IRQ without TIE: continues to END");
+        // REFE: data from ADDR, then stop.
+        r.clear();
+        r.ram.qw(0x602100, h.lo, h.hi);
+        r.ram.qw(0x602110, pkt[0].lo, pkt[0].hi);
+        r.ram.qw(0x602120, pkt[1].lo, pkt[1].hi);
+        r.ram.tag(0x602000, dmaTag(REFE, 3, 0x602100));
+        block(0x602010, END, 0, false);
+        r.kick(D1, 0x602000);
+        check(r.path[2] == one && r.tadr(D1) == 0x602010, "REFE: referenced data only, TADR after the tag"); });
+
+    run("scratchpad: tags in scratchpad (TADR bit 31) and REF data with the SPR bit", []
+        {
+        Rig r;
+        const auto pkt = adPacket(1, 0x5C);
+        const Qw h = directHeader(2);
+        uint8_t *spr = r.mem.getScratchpad();
+        check(spr != nullptr, "scratchpad");
+        if (!spr)
+            return;
+        Ram s{spr};
+        s.qw(0x100, h.lo, h.hi);
+        s.qw(0x110, pkt[0].lo, pkt[0].hi);
+        s.qw(0x120, pkt[1].lo, pkt[1].hi);
+        s.tag(0x000, dmaTag(REF, 3, 0x80000100u)); // ADDR bit 31 (SPR) -> scratchpad +0x100
+        s.tag(0x010, dmaTag(END, 0, 0));
+        std::vector<uint8_t> expect;
+        appendQws(expect, pkt);
+        r.kick(D1, 0x80000000u);
+        check(r.path[2] == expect, "scratchpad tag + scratchpad data"); });
+
+    run("GIF channel (PATH3) chain of 5000 CNT tags is transferred completely", []
+        {
+        Rig r;
+        uint32_t at = 0x700000;
+        std::vector<uint8_t> expect;
+        for (uint32_t t = 0; t < 5000; ++t)
+        {
+            const auto pkt = adPacket(1, t);
+            r.ram.tag(at, dmaTag(t == 4999 ? END : CNT, 2, 0));
+            r.ram.qw(at + 16, pkt[0].lo, pkt[0].hi);
+            r.ram.qw(at + 32, pkt[1].lo, pkt[1].hi);
+            appendQws(expect, pkt);
+            at += 48;
+        }
+        r.kick(D2, 0x700000);
+        check(r.path[3] == expect, "PATH3 bytes " + std::to_string(r.path[3].size()) + " == " + std::to_string(expect.size()));
+        check(r.tadr(D2) == at - 48, "TADR on the END tag"); });
+
+    run("malformed: endless NEXT cycle and CALL cycle terminate promptly with bounded output", []
+        {
+        Rig r;
+        const auto pkt = adPacket(1, 0xC1C);
+        const Qw h = directHeader(2);
+        // A -> B -> A (NEXT), each with a packet.
+        for (uint32_t a : {0x800000u, 0x800100u})
+        {
+            r.ram.tag(a, dmaTag(NEXT, 3, a == 0x800000u ? 0x800100u : 0x800000u));
+            r.ram.qw(a + 16, h.lo, h.hi);
+            r.ram.qw(a + 32, pkt[0].lo, pkt[0].hi);
+            r.ram.qw(a + 48, pkt[1].lo, pkt[1].hi);
+        }
+        auto t0 = std::chrono::steady_clock::now();
+        r.kick(D1, 0x800000);
+        double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        check(ms < 5000.0, "NEXT cycle: kick returned (" + std::to_string(ms) + " ms)");
+        check(r.path[2].size() <= 64u * 1024u * 1024u, "NEXT cycle: bounded output (" + std::to_string(r.path[2].size()) + " bytes)");
+        GifCursor c;
+        c.feed(r.path[2].data(), r.path[2].size());
+        check(c.atBoundary(), "NEXT cycle: whole packets only (PATH2 at a boundary)");
+        // CALL to a subroutine that NEXTs back to the CALL: the address stack overflows on hardware.
+        r.clear();
+        r.ram.tag(0x810000, dmaTag(CALL, 0, 0x810100));
+        r.ram.tag(0x810100, dmaTag(NEXT, 3, 0x810000));
+        r.ram.qw(0x810110, h.lo, h.hi);
+        r.ram.qw(0x810120, pkt[0].lo, pkt[0].hi);
+        r.ram.qw(0x810130, pkt[1].lo, pkt[1].hi);
+        t0 = std::chrono::steady_clock::now();
+        r.kick(D1, 0x810000);
+        ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        check(ms < 5000.0, "CALL cycle: kick returned (" + std::to_string(ms) + " ms)");
+        check(r.path[2].size() <= 64u * 1024u * 1024u, "CALL cycle: bounded output"); });
+
+    run("malformed: tag address outside guest memory stops the walk without a crash", []
+        {
+        Rig r;
+        const auto pkt = adPacket(1, 0xBAD);
+        const Qw h = directHeader(2);
+        r.ram.tag(0x900000, dmaTag(NEXT, 3, 0x01FFFFF8u)); // next tag straddles the end of RAM
+        r.ram.qw(0x900010, h.lo, h.hi);
+        r.ram.qw(0x900020, pkt[0].lo, pkt[0].hi);
+        r.ram.qw(0x900030, pkt[1].lo, pkt[1].hi);
+        std::vector<uint8_t> expect;
+        appendQws(expect, pkt);
+        r.kick(D1, 0x900000);
+        check(r.path[2] == expect, "payload before the bad tag delivered, nothing after"); });
+
+    std::printf("SUMMARY: %d checks, %d failures\n", g_checks, g_failures);
+    std::printf("DMA CHAIN TESTS: %s\n", g_failures ? "FAIL" : "PASS");
+    return g_failures ? 1 : 0;
+}
diff --git a/ps2xTest/a06/gs_replay_timed.cpp b/ps2xTest/a06/gs_replay_timed.cpp
new file mode 100644
index 0000000..f1a0a8f
--- /dev/null
+++ b/ps2xTest/a06/gs_replay_timed.cpp
@@ -0,0 +1,197 @@
+// XGSR replay through the runtime's Vulkan GS device with per-record wall-clock timing.
+//
+// usage: a06_gs_replay_timed CAPTURE.xgsr [--top N] [--progress] [--validation] [--stop SEQ]
+// Same device setup and record semantics as a05_gs_replay (first keyframe restored, every record
+// applied in order, frame hashes compared), plus: wall time of each Gif record, the N slowest, the
+// time per present interval and the total. --progress prints a line before each Gif record larger than
+// 64 KiB and after any record slower than 1 s, so a run killed by an external timeout shows where it
+// was. Exit: 0 all compared frames match, 1 mismatch, 2 invalid file or device failure.
+#include "../a05/xgsr_replay.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+
+int main(int argc, char **argv)
+{
+    if (argc < 2)
+    {
+        std::fprintf(stderr, "usage: %s CAPTURE.xgsr [--top N] [--progress]\n", argv[0]);
+        return 2;
+    }
+    size_t top = 10;
+    bool progress = false, validation = false;
+    uint64_t stopSeq = 0;
+    for (int i = 2; i < argc; ++i)
+    {
+        const std::string a = argv[i];
+        if (a == "--top" && i + 1 < argc)
+            top = size_t(std::atoi(argv[++i]));
+        else if (a == "--progress")
+            progress = true;
+        else if (a == "--validation")
+            validation = true;
+        else if (a == "--stop" && i + 1 < argc)
+            stopSeq = std::strtoull(argv[++i], nullptr, 10);
+    }
+    setvbuf(stdout, nullptr, _IOLBF, 0); // keep output when a sanitizer or timeout ends the process
+    xgsr_replay::Capture cap;
+    if (!cap.load(argv[1]))
+    {
+        std::printf("INVALID: %s\n", cap.error.c_str());
+        return 2;
+    }
+    std::printf("capture: %zu records, seq %llu..%llu, reason '%s'\n", cap.records.size(),
+                (unsigned long long)cap.header.firstSeq, (unsigned long long)cap.header.lastSeq, cap.header.reason);
+    std::map<uint64_t, uint64_t> expected;
+    for (const auto &r : cap.records)
+        if (r.h.type == uint8_t(xgsr::Rec::FrameHash))
+        {
+            uint64_t present = 0, hash = 0;
+            std::memcpy(&present, r.payload, 8);
+            std::memcpy(&hash, r.payload + 16, 8);
+            expected[present] = hash;
+        }
+    GSRegisters regs{};
+    PgsDeviceConfig cfg{};
+    cfg.samples = int(cap.header.samples);
+    cfg.forceProgressive = cap.header.forceProgressive != 0;
+    cfg.syncPresentation = true;
+    cfg.validation = validation;
+    cfg.privRegs = &regs;
+    PgsDeviceInfo info;
+    std::string err;
+    auto dev = ps2x_createPgsDevice(cfg, err, &info);
+    if (!dev)
+    {
+        std::printf("REPLAY FAILED: device: %s\n", err.c_str());
+        return 2;
+    }
+    using clk = std::chrono::steady_clock;
+    struct Slow
+    {
+        double ms;
+        uint64_t seq;
+        uint8_t path;
+        uint32_t bytes;
+    };
+    std::vector<Slow> slow;
+    uint64_t presentIndex = cap.records.front().h.present;
+    uint64_t compared = 0, matched = 0, missing = 0;
+    bool restored = false;
+    double totalGifMs = 0, intervalMs = 0;
+    const auto t0 = clk::now();
+    for (const auto &r : cap.records)
+    {
+        if (stopSeq && r.h.seq > stopSeq)
+            break;
+        const auto type = xgsr::Rec(r.h.type);
+        switch (type)
+        {
+        case xgsr::Rec::Keyframe:
+            if (!restored)
+            {
+                if (!dev->RestoreKeyframe(r.payload, r.h.bytes, err))
+                {
+                    std::printf("REPLAY FAILED: keyframe: %s\n", err.c_str());
+                    return 2;
+                }
+                restored = true;
+            }
+            break;
+        case xgsr::Rec::Gif:
+        {
+            if (progress && r.h.bytes > 65536)
+                std::printf("  -> seq %llu PATH%u %u bytes\n", (unsigned long long)r.h.seq, r.h.path, r.h.bytes), std::fflush(stdout);
+            const auto a = clk::now();
+            dev->GifTransfer(GifPathId(r.h.path), r.payload, r.h.bytes);
+            const double ms = std::chrono::duration<double, std::milli>(clk::now() - a).count();
+            totalGifMs += ms;
+            intervalMs += ms;
+            slow.push_back({ms, r.h.seq, r.h.path, r.h.bytes});
+            if (progress && ms > 1000.0)
+                std::printf("  SLOW seq %llu PATH%u %u bytes: %.1f ms\n", (unsigned long long)r.h.seq, r.h.path, r.h.bytes, ms),
+                    std::fflush(stdout);
+            break;
+        }
+        case xgsr::Rec::Register:
+        {
+            uint64_t v = 0;
+            std::memcpy(&v, r.payload + 8, 8);
+            dev->WriteRegister(r.payload[0], v);
+            break;
+        }
+        case xgsr::Rec::Present:
+        {
+            GSPresentationRequest req{};
+            std::memcpy(req.privLo, r.payload, sizeof(req.privLo));
+            std::memcpy(&req.csr, r.payload + sizeof(req.privLo), 8);
+            regs.csr = req.csr;
+            const auto a = clk::now();
+            PresentationFrame f = dev->Present(req);
+            const double pms = std::chrono::duration<double, std::milli>(clk::now() - a).count();
+            auto it = expected.find(presentIndex);
+            const char *verdict = "-";
+            if (it != expected.end())
+            {
+                ++compared;
+                if (f.unchanged || f.hiresPixels.empty())
+                    ++missing, verdict = "missing";
+                else if (xgsr::fnv1a64(f.hiresPixels.data(), f.hiresPixels.size()) == it->second)
+                    ++matched, verdict = "match";
+                else
+                    verdict = "MISMATCH";
+            }
+            std::printf("present %llu: gif %.1f ms, present %.1f ms, frame %s\n", (unsigned long long)presentIndex, intervalMs,
+                        pms, verdict);
+            intervalMs = 0;
+            ++presentIndex;
+            break;
+        }
+        case xgsr::Rec::Reset:
+            dev->Reset();
+            break;
+        case xgsr::Rec::FifoRead:
+        {
+            uint32_t want = 0;
+            std::memcpy(&want, r.payload, 4);
+            std::vector<uint8_t> got(want);
+            dev->ReadLocalToHost(got.data(), want);
+            break;
+        }
+        case xgsr::Rec::VramRead:
+        {
+            uint32_t v[6];
+            std::memcpy(v, r.payload, sizeof(v));
+            (void)dev->ReadVram(v[0], v[1], v[2], v[3], v[4]);
+            break;
+        }
+        case xgsr::Rec::VramWrite:
+        {
+            uint32_t v[6];
+            std::memcpy(v, r.payload, sizeof(v));
+            dev->WriteVram(v[0], v[1], v[2], v[3], v[4], v[5]);
+            break;
+        }
+        case xgsr::Rec::VramSnapshot:
+        {
+            std::vector<uint8_t> tmp;
+            dev->SnapshotVram(tmp);
+            break;
+        }
+        default:
+            break;
+        }
+    }
+    const double wall = std::chrono::duration<double, std::milli>(clk::now() - t0).count();
+    std::sort(slow.begin(), slow.end(), [](const Slow &a, const Slow &b) { return a.ms > b.ms; });
+    std::printf("slowest Gif records:\n");
+    for (size_t i = 0; i < std::min(top, slow.size()); ++i)
+        std::printf("  seq %llu PATH%u %u bytes: %.2f ms\n", (unsigned long long)slow[i].seq, slow[i].path, slow[i].bytes,
+                    slow[i].ms);
+    std::printf("gif records %zu, gif time %.1f ms, wall %.1f ms; frames compared %llu matched %llu missing %llu\n", slow.size(),
+                totalGifMs, wall, (unsigned long long)compared, (unsigned long long)matched, (unsigned long long)missing);
+    const bool ok = compared == matched && missing == 0;
+    std::printf("%s\n", ok ? "REPLAY MATCH" : "REPLAY MISMATCH");
+    return ok ? 0 : 1;
+}
