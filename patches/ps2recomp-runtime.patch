+struct GS::AsyncQueue
+{
+    enum Type : uint8_t
+    {
+        GifPacket,
+        NativePacked,
+        UploadNative,
+        WriteRegister,
+        ClearContext,
+        ClearActive,
+        Present, // present presentRequest once everything before it is drawn
+        Call,    // run `fn` on the worker in stream order (device-owned operations)
+    };
+    struct Command
+    {
+        Type type;
+        std::vector<uint8_t> data;
+        uint64_t args[4];
+        std::function<void()> fn{};
+    };
+
+    std::thread worker;
+    std::thread::id workerId;
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::condition_variable done;
+    std::deque<Command> queue;
+    uint64_t submitted = 0;
+    uint64_t processed = 0;
+    // Bytes queued but not processed yet. Producers (EE, VIF1/VU1 worker)
+    // wait above kMaxPendingBytes so a GS that falls behind cannot grow the
+    // queue without bound (it reached ~15 GB in a slow instrumented build).
+    // Kept to about two frames of a heavy scene (~4 MB of GS commands each):
+    // the game can't run further ahead of what is shown, so the picture
+    // stays current (a 64 MB backlog was over half a second behind).
+    static constexpr size_t kMaxPendingBytes = 8u * 1024u * 1024u;
+    size_t pendingBytes = 0;
+    bool stop = false;
+    bool workerSleeping = false; // notify only when the worker waits
+    int producersWaiting = 0;
+    // Packet buffers handed back by the worker, reused by producers so a
+    // packet isn't a heap allocation + free on two threads.
+    std::vector<std::vector<uint8_t>> freeBuffers;
+    static constexpr size_t kMaxFreeBuffers = 4096;
+    static constexpr size_t kMaxRecycledCapacity = 256u * 1024u;
+    // The worker returns queue space every kReleaseBytes it has processed
+    // instead of after a whole batch (up to kMaxPendingBytes), so producers
+    // and the worker overlap instead of taking turns.
+    static constexpr size_t kReleaseBytes = 256u * 1024u;
+    struct PendingPresent
+    {
+        uint64_t marker;
+        GSPresentationRequest request;
+    };
+    static constexpr size_t kMaxPendingPresents = 4;
+    std::deque<PendingPresent> presentRequests;
+
+    static size_t commandBytes(const Command &cmd) { return cmd.data.size() + sizeof(Command); }
+
+    std::vector<uint8_t> buffer(const uint8_t *data, size_t size)
+    {
+        std::vector<uint8_t> out;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (!freeBuffers.empty())
+            {
+                out = std::move(freeBuffers.back());
+                freeBuffers.pop_back();
+            }
+        }
+        out.assign(data, data + size);
+        return out;
+    }
+
+    void push(Command &&cmd)
+    {
+        bool wakeWorker;
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            if (!stop && pendingBytes > kMaxPendingBytes)
+            {
+                ++producersWaiting;
+                Ps2xWaitScope probe(Ps2xWait::GsQueueFull);
+                done.wait(lock, [&] { return stop || pendingBytes <= kMaxPendingBytes; });
+                --producersWaiting;
+            }
+            pendingBytes += commandBytes(cmd);
+            queue.push_back(std::move(cmd));
+            ++submitted;
+            wakeWorker = workerSleeping;
+        }
+        if (wakeWorker)
+            wake.notify_one();
+    }
+
+    void pushPresent(const GSPresentationRequest &request)
+    {
+        bool wakeWorker;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            // Only coalesce in place when no GS work separates the samples.
+            if (!queue.empty() && queue.back().type == Present)
+            {
+                presentRequests.back().request = request;
+                return;
+            }
+            // Keep the newest sample when behind. Its old marker becomes a
+            // no-op, even if it has already moved into the worker's batch.
+            const uint64_t marker = submitted + 1;
+            Command cmd{Present, {}, {marker}};
+            queue.push_back(std::move(cmd));
+            pendingBytes += sizeof(Command);
+            ++submitted;
+            if (presentRequests.size() == kMaxPendingPresents)
+                presentRequests.pop_back();
+            presentRequests.push_back({marker, request});
+            wakeWorker = workerSleeping;
+        }
+        if (wakeWorker)
+            wake.notify_one();
+    }
+
+    // GIF packets (the VIF1/VU1 thread sends thousands per frame): appended
+    // to the newest queued GifPacket command as [u32 size][u32 path][bytes]
+    // records, so a packet costs one lock and, in steady state, no
+    // allocation. The worker hands each record to processGIFPacket in order,
+    // with the GIF path it was accepted from.
+    static constexpr size_t kMaxGifCommandBytes = 64u * 1024u;
+    static constexpr uint32_t kGifRecordHeader = 8u;
+    std::atomic<uint64_t> producerWaitNs{0}, producerWaits{0};
+    void pushGif(GifPathId path, const uint8_t *data, uint32_t size)
+    {
+        bool wakeWorker;
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            if (!stop && pendingBytes > kMaxPendingBytes)
+            {
+                // How often the GS is the bottleneck (log only).
+                static uint64_t waits = 0;
+                if ((++waits & 1023u) == 0u)
+                    std::fprintf(stderr, "[gs-queue] producers waited for space %llu times\n", static_cast<unsigned long long>(waits));
+                ++producersWaiting;
+                const auto waitStart = std::chrono::steady_clock::now();
+                Ps2xWaitScope probe(Ps2xWait::GsQueueFull);
+                done.wait(lock, [&] { return stop || pendingBytes <= kMaxPendingBytes; });
+                producerWaitNs.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                             std::chrono::steady_clock::now() - waitStart).count()),
+                                         std::memory_order_relaxed);
+                producerWaits.fetch_add(1, std::memory_order_relaxed);
+                --producersWaiting;
+            }
+            static const bool pack = [] { const char *e = std::getenv("PS2X_GS_PACK"); return !(e && e[0] == '0'); }();
+            if (!pack || queue.empty() || queue.back().type != GifPacket || queue.back().data.size() >= kMaxGifCommandBytes)
+            {
+                Command cmd{GifPacket, {}, {}};
+                if (!freeBuffers.empty())
+                {
+                    cmd.data = std::move(freeBuffers.back());
+                    freeBuffers.pop_back();
+                }
+                queue.push_back(std::move(cmd));
+                ++submitted;
+                pendingBytes += sizeof(Command);
+            }
+            std::vector<uint8_t> &out = queue.back().data;
+            const size_t at = out.size();
+            const uint32_t pathRaw = static_cast<uint32_t>(path);
+            out.resize(at + kGifRecordHeader + size);
+            std::memcpy(out.data() + at, &size, 4u);
+            std::memcpy(out.data() + at + 4u, &pathRaw, 4u);
+            std::memcpy(out.data() + at + kGifRecordHeader, data, size);
+            pendingBytes += kGifRecordHeader + size;
+            wakeWorker = workerSleeping;
+        }
+        if (wakeWorker)
+            wake.notify_one();
+    }
+
+    // Worker: these commands are done; give their space back (and their
+    // buffers) without waiting for the rest of the batch.
+    void release(std::deque<Command> &batch, size_t from, size_t to, size_t bytes)
+    {
+        bool notify;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            pendingBytes -= bytes;
+            for (size_t i = from; i < to; ++i)
+            {
+                std::vector<uint8_t> &d = batch[i].data;
+                if (d.capacity() != 0u && d.capacity() <= kMaxRecycledCapacity && freeBuffers.size() < kMaxFreeBuffers)
+                {
+                    d.clear();
+                    freeBuffers.push_back(std::move(d));
+                }
+            }
+            notify = producersWaiting != 0;
+        }
+        if (notify)
+            done.notify_all();
+    }
+};
