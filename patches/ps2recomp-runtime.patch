diff --git a/ps2xTest/a03/gif_ingress_tests.cpp b/ps2xTest/a03/gif_ingress_tests.cpp
new file mode 100644
index 0000000..658ccae
--- /dev/null
+++ b/ps2xTest/a03/gif_ingress_tests.cpp
@@ -0,0 +1,270 @@
+// GIF ingress tests: path identity and accepted-qword order through the arbiter, PS2Memory
+// (VIF1 DIRECT, PATH3 fast paths) and the GS async worker queue. CPU/legacy build only; no GPU.
+// Each property has a negative control showing the check detects the failure it guards against.
+#include "ps2_runtime.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+#include "runtime/ps2_memory.h"
+
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace
+{
+int g_failures = 0, g_checks = 0;
+
+void check(bool ok, const std::string &what)
+{
+    ++g_checks;
+    if (!ok)
+    {
+        ++g_failures;
+        std::printf("  FAIL: %s\n", what.c_str());
+    }
+}
+
+void run(const char *name, const std::function<void()> &body)
+{
+    const int before = g_failures;
+    std::printf("[test] %s\n", name);
+    body();
+    std::printf("[%s] %s\n", g_failures == before ? "PASS" : "FAIL", name);
+}
+
+struct Packet
+{
+    GifPathId path;
+    std::vector<uint8_t> bytes;
+    bool operator==(const Packet &o) const { return path == o.path && bytes == o.bytes; }
+};
+
+void put64(std::vector<uint8_t> &v, uint64_t x)
+{
+    const size_t at = v.size();
+    v.resize(at + 8);
+    std::memcpy(v.data() + at, &x, 8);
+}
+
+uint64_t gifTag(uint32_t nloop, bool eop, uint32_t flg, uint32_t nreg)
+{
+    return uint64_t(nloop & 0x7FFF) | (eop ? 1ull << 15 : 0) | (uint64_t(flg) << 58) | (uint64_t(nreg & 0xF) << 60);
+}
+
+// PACKED A+D packet writing `n` harmless registers (address 0x7F is not a GS register); the data
+// words carry `id` so packets are distinguishable.
+std::vector<uint8_t> nopPacket(uint32_t n, uint64_t id)
+{
+    std::vector<uint8_t> v;
+    put64(v, gifTag(n, true, 0, 1));
+    put64(v, 0xE);
+    for (uint32_t i = 0; i < n; ++i)
+    {
+        put64(v, (id << 8) | i);
+        put64(v, 0x7F);
+    }
+    return v;
+}
+
+void appendU32(std::vector<uint8_t> &v, uint32_t x)
+{
+    const size_t at = v.size();
+    v.resize(at + 4);
+    std::memcpy(v.data() + at, &x, 4);
+}
+
+uint32_t vifCmd(uint32_t cmd, uint32_t num, uint32_t imm) { return (cmd << 24) | (num << 16) | (imm & 0xFFFF); }
+
+std::vector<uint8_t> concat(const std::vector<Packet> &ps)
+{
+    std::vector<uint8_t> out;
+    for (const auto &p : ps)
+        out.insert(out.end(), p.bytes.begin(), p.bytes.end());
+    return out;
+}
+} // namespace
+
+int main()
+{
+    run("arbiter passes the accepting path to a path-aware consumer, in submission order", []
+        {
+        std::vector<Packet> seen;
+        GifArbiter arb([&](GifPathId path, const uint8_t *d, uint32_t n) { seen.push_back({path, {d, d + n}}); });
+        const auto p3 = nopPacket(1, 3), p2 = nopPacket(2, 2), p1 = nopPacket(1, 1);
+        arb.submit(GifPathId::Path3, p3.data(), uint32_t(p3.size()));
+        arb.submit(GifPathId::Path2, p2.data(), uint32_t(p2.size()));
+        arb.submit(GifPathId::Path1, p1.data(), uint32_t(p1.size()));
+        arb.drain();
+        const std::vector<Packet> expect = {{GifPathId::Path3, p3}, {GifPathId::Path2, p2}, {GifPathId::Path1, p1}};
+        check(seen == expect, "drained packets keep path, bytes and order");
+        seen.clear();
+        arb.submitAndDrain(GifPathId::Path1, p1.data(), uint32_t(p1.size()));
+        check(seen.size() == 1 && seen[0].path == GifPathId::Path1, "direct (empty-queue) submission keeps its path"); });
+
+    run("legacy two-argument arbiter consumers still receive every packet", []
+        {
+        int count = 0;
+        GifArbiter arb([&](const uint8_t *, uint32_t) { ++count; });
+        const auto p = nopPacket(1, 9);
+        arb.submit(GifPathId::Path2, p.data(), uint32_t(p.size()));
+        arb.submitAndDrain(GifPathId::Path1, p.data(), uint32_t(p.size()));
+        check(count == 2, "legacy consumer saw both packets"); });
+
+    run("GS async queue preserves path, bytes and order across packed records and other commands", []
+        {
+        std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0);
+        GSRegisters regs{};
+        GS gs;
+        gs.init(vram.data(), uint32_t(vram.size()), &regs);
+        gs.setAsync(true);
+        std::vector<Packet> seen;
+        gs.setGifIngressObserver([&](GifPathId p, const uint8_t *d, uint32_t n) { seen.push_back({p, {d, d + n}}); });
+        std::mt19937 rng(1234);
+        std::vector<Packet> sent;
+        for (int i = 0; i < 3000; ++i)
+        {
+            const GifPathId path = GifPathId(1 + rng() % 3);
+            auto bytes = nopPacket(1 + rng() % 40, uint64_t(i));
+            gs.processGIFPacket(path, bytes.data(), uint32_t(bytes.size()));
+            sent.push_back({path, std::move(bytes)});
+            if (i % 97 == 0)
+                gs.writeRegister(0x7F, uint64_t(i)); // non-GIF command splits the packed records
+        }
+        gs.sync();
+        check(seen.size() == sent.size(), "every packet reached the worker (" + std::to_string(seen.size()) + "/" +
+                                              std::to_string(sent.size()) + ")");
+        check(seen == sent, "paths, bytes and order identical after the queue");
+        // Negative control: the former seam (arbiter callback without a path) labels everything one
+        // way; the same comparison must catch it.
+        std::vector<Packet> dropped = sent;
+        for (auto &p : dropped)
+            p.path = GifPathId::Path3;
+        check(!(seen == dropped), "negative control: dropped path identity is detected");
+        std::vector<Packet> swapped = sent;
+        std::swap(swapped[10], swapped[11]);
+        check(!(seen == swapped) || sent[10] == sent[11], "negative control: reordered packets are detected");
+        gs.setGifIngressObserver(nullptr);
+        gs.setAsync(false); });
+
+    run("arbiter -> GS wiring used by the runtime keeps paths end to end", []
+        {
+        std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0);
+        GSRegisters regs{};
+        GS gs;
+        gs.init(vram.data(), uint32_t(vram.size()), &regs);
+        gs.setAsync(true);
+        std::vector<Packet> seen;
+        gs.setGifIngressObserver([&](GifPathId p, const uint8_t *d, uint32_t n) { seen.push_back({p, {d, d + n}}); });
+        GifArbiter arb([&](GifPathId path, const uint8_t *d, uint32_t n) { gs.processGIFPacket(path, d, n); });
+        PS2Memory mem;
+        check(mem.initialize(), "memory init");
+        mem.setGifArbiter(&arb);
+        const auto a = nopPacket(2, 1), b = nopPacket(3, 2), c = nopPacket(1, 3);
+        mem.submitGifPacket(GifPathId::Path3, a.data(), uint32_t(a.size()), false);
+        mem.submitGifPacket(GifPathId::Path1, b.data(), uint32_t(b.size()), true);
+        mem.submitGifPacket(GifPathId::Path2, c.data(), uint32_t(c.size()), true);
+        gs.sync();
+        const std::vector<Packet> expect = {{GifPathId::Path3, a}, {GifPathId::Path1, b}, {GifPathId::Path2, c}};
+        check(seen == expect, "PATH3 queued first, then PATH1, PATH2 - each with its path");
+        // Negative control: the former lambda (no path) forwards everything as the legacy entry.
+        seen.clear();
+        GifArbiter legacy([&](const uint8_t *d, uint32_t n) { gs.processGIFPacket(d, n); });
+        mem.setGifArbiter(&legacy);
+        mem.submitGifPacket(GifPathId::Path1, b.data(), uint32_t(b.size()), true);
+        gs.sync();
+        check(seen.size() == 1 && seen[0].path != GifPathId::Path1, "negative control: legacy seam loses PATH1");
+        gs.setGifIngressObserver(nullptr);
+        gs.setAsync(false); });
+
+    // VIF1 DIRECT carrying a split IMAGE transfer: tag in one DIRECT, pixels across two more.
+    auto vifSplitImage = [](std::vector<uint8_t> &gifStream) {
+        std::vector<uint8_t> vif;
+        std::vector<uint8_t> tagQw;
+        put64(tagQw, gifTag(5, true, 2, 0));
+        put64(tagQw, 0);
+        // Three VIF NOPs before each DIRECT keep the DIRECT data qword aligned in the buffer.
+        appendU32(vif, 0);
+        appendU32(vif, 0);
+        appendU32(vif, 0);
+        appendU32(vif, vifCmd(0x50, 0, 1)); // DIRECT 1 qword: the IMAGE GIF tag (NLOOP=5)
+        vif.insert(vif.end(), tagQw.begin(), tagQw.end());
+        gifStream = tagQw;
+        std::vector<uint8_t> px;
+        for (int i = 0; i < 5 * 16; ++i)
+            px.push_back(uint8_t(0x40 + i));
+        appendU32(vif, 0);
+        appendU32(vif, 0);
+        appendU32(vif, 0);
+        appendU32(vif, vifCmd(0x50, 0, 2)); // first 2 qwords of pixels
+        vif.insert(vif.end(), px.begin(), px.begin() + 32);
+        appendU32(vif, 0);
+        appendU32(vif, 0);
+        appendU32(vif, 0);
+        appendU32(vif, vifCmd(0x50, 0, 3)); // remaining 3 qwords
+        vif.insert(vif.end(), px.begin() + 32, px.end());
+        gifStream.insert(gifStream.end(), px.begin(), px.end());
+        return vif;
+    };
+
+    run("raw ingress: VIF1 DIRECT IMAGE continuation reaches the GS as the exact accepted qwords (PATH2)", [&]
+        {
+        PS2Memory mem;
+        check(mem.initialize(), "memory init");
+        std::vector<Packet> seen;
+        GifArbiter arb([&](GifPathId p, const uint8_t *d, uint32_t n) { seen.push_back({p, {d, d + n}}); });
+        mem.setGifArbiter(&arb);
+        mem.setRawGifIngress(true);
+        std::vector<uint8_t> expected;
+        const auto vif = vifSplitImage(expected);
+        mem.processVIF1Data(vif.data(), uint32_t(vif.size()));
+        bool allPath2 = !seen.empty();
+        for (const auto &p : seen)
+            allPath2 = allPath2 && p.path == GifPathId::Path2;
+        check(allPath2, "all DIRECT data labelled PATH2");
+        check(concat(seen) == expected, "concatenated stream == GIF tag + 5 pixel qwords, nothing added");
+        check(seen.size() == 3, "one submission per DIRECT command (" + std::to_string(seen.size()) + ")"); });
+
+    run("legacy ingress unchanged: VIF1 continuation still gets the synthetic tag (negative control for raw)", [&]
+        {
+        PS2Memory mem;
+        check(mem.initialize(), "memory init");
+        std::vector<Packet> seen;
+        GifArbiter arb([&](GifPathId p, const uint8_t *d, uint32_t n) { seen.push_back({p, {d, d + n}}); });
+        mem.setGifArbiter(&arb);
+        std::vector<uint8_t> expected;
+        const auto vif = vifSplitImage(expected);
+        mem.processVIF1Data(vif.data(), uint32_t(vif.size()));
+        const auto stream = concat(seen);
+        check(stream != expected, "legacy stream differs from the accepted qwords (raw-stream check detects it)");
+        check(stream.size() == expected.size() + 32, "legacy adds one synthetic tag per continuation (2 x 16 bytes)"); });
+
+    run("raw ingress bypasses the native PATH3 packed fast path; legacy keeps it", []
+        {
+        for (int raw = 0; raw < 2; ++raw)
+        {
+            PS2Memory mem;
+            check(mem.initialize(), "memory init");
+            std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0);
+            GSRegisters regs{};
+            GS gs;
+            gs.init(vram.data(), uint32_t(vram.size()), &regs);
+            mem.setRawGifIngress(raw != 0);
+            const uint32_t tadr = 0x100000;
+            const auto pkt = nopPacket(2, 7); // 3 qwords PACKED
+            uint64_t dmaTag = uint64_t(pkt.size() / 16) | (7ull << 28); // END, QWC
+            uint8_t *ram = mem.getRDRAM();
+            std::memcpy(ram + tadr, &dmaTag, 8);
+            std::memset(ram + tadr + 8, 0, 8);
+            std::memcpy(ram + tadr + 16, pkt.data(), pkt.size());
+            const uint32_t chcr = 0x100u | (1u << 2); // STR, chain mode
+            const bool took = mem.tryProcessNativeGifPackedChain(gs, tadr, chcr);
+            check(took == (raw == 0), raw ? "raw mode: fast path declined" : "legacy: fast path taken");
+        } });
+
+    std::printf("SUMMARY: %d checks, %d failures\n", g_checks, g_failures);
+    std::printf("GIF INGRESS TESTS: %s\n", g_failures ? "FAIL" : "PASS");
+    return g_failures ? 1 : 0;
+}
