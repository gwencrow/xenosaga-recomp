+void GS::setAsync(bool enabled)
+{
+    if (enabled == static_cast<bool>(m_async))
+        return;
+    if (!enabled)
+    {
+        // A device lives on the worker thread: tear it down there first.
+        shutdownGifDevice();
+        {
+            std::lock_guard<std::mutex> lock(m_async->mutex);
+            m_async->stop = true;
+        }
+        m_async->wake.notify_all();
+        m_async->done.notify_all(); // producers waiting for queue space
+        m_async->worker.join();
+        m_async.reset();
+        return;
+    }
+
+    auto async = std::make_unique<AsyncQueue>();
+    AsyncQueue *q = async.get();
+    m_async = std::move(async);
+    q->worker = std::thread([this, q]()
+                            {
+        std::deque<AsyncQueue::Command> batch;
+        for (;;)
+        {
+            {
+                std::unique_lock<std::mutex> lock(q->mutex);
+                q->workerSleeping = true;
+                q->wake.wait(lock, [q] { return q->stop || !q->queue.empty(); });
+                q->workerSleeping = false;
+                if (q->queue.empty())
+                    return; // stop requested and nothing left
+                batch.swap(q->queue);
+            }
+            size_t releaseFrom = 0, releaseBytes = 0;
+            for (size_t index = 0; index < batch.size(); ++index)
+            {
+                AsyncQueue::Command &cmd = batch[index];
+                if (releaseBytes >= AsyncQueue::kReleaseBytes)
+                {
+                    q->release(batch, releaseFrom, index, releaseBytes);
+                    releaseFrom = index;
+                    releaseBytes = 0;
+                }
+                releaseBytes += AsyncQueue::commandBytes(cmd);
+                const uint8_t *d = cmd.data.data();
+                const uint32_t n = static_cast<uint32_t>(cmd.data.size());
+                static const char *const kOpNames[] = {"GIF packets", "native packed", "native upload", "register write",
+                                                       "clear context", "clear active", "present", "call"};
+                {
+                    const unsigned t = static_cast<unsigned>(cmd.type);
+                    ps2x_setGsWorkerOp(t < sizeof(kOpNames) / sizeof(kOpNames[0]) ? kOpNames[t] : "command");
+                }
+                switch (cmd.type)
+                {
+                case AsyncQueue::GifPacket:
+                    for (uint32_t at = 0; at + AsyncQueue::kGifRecordHeader <= n;)
+                    {
+                        uint32_t size, pathRaw;
+                        std::memcpy(&size, d + at, 4u);
+                        std::memcpy(&pathRaw, d + at + 4u, 4u);
+                        processGIFPacket(static_cast<GifPathId>(pathRaw), d + at + AsyncQueue::kGifRecordHeader, size);
+                        at += AsyncQueue::kGifRecordHeader + size;
+                    }
+                    break;
+                case AsyncQueue::Call:
+                    if (cmd.fn)
+                        cmd.fn();
+                    break;
+                case AsyncQueue::NativePacked:
+                    processNativePackedGIFPacket(d, n);
+                    break;
+                case AsyncQueue::UploadNative:
+                    uploadImageNative(cmd.args[0], cmd.args[1], cmd.args[2], cmd.args[3], d, n);
+                    break;
+                case AsyncQueue::WriteRegister:
+                    writeRegister(static_cast<uint8_t>(cmd.args[0]), cmd.args[1]);
+                    break;
+                case AsyncQueue::ClearContext:
+                    clearFramebufferContext(static_cast<uint32_t>(cmd.args[0]), static_cast<uint32_t>(cmd.args[1]));
+                    break;
+                case AsyncQueue::ClearActive:
+                    clearActiveFramebuffer(static_cast<uint32_t>(cmd.args[0]));
+                    break;
+                case AsyncQueue::Present:
+                {
+                    GSPresentationRequest request;
+                    {
+                        std::lock_guard<std::mutex> lock(q->mutex);
+                        if (q->presentRequests.empty() || q->presentRequests.front().marker != cmd.args[0])
+                            break;
+                        request = q->presentRequests.front().request;
+                        q->presentRequests.pop_front();
+                    }
+                    t_presentRequest = &request;
+                    latchHostPresentationFrame(); // on this thread: draws and stores the frame
+                    t_presentRequest = nullptr;
+                    break;
+                }
+                }
+            }
+            bool idle;
+            {
+                std::lock_guard<std::mutex> lock(q->mutex);
+                idle = q->queue.empty();
+            }
+            ps2x_setGsWorkerOp(idle ? "idle flush" : "between batches");
+            if (idle)
+            {
+                // Nothing else queued: draw what the rasterizer has batched.
+                std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+                if (m_device)
+                    m_device->IdleFlush();
+                else if (m_backend)
+                    m_backend->Flush();
+            }
+            q->release(batch, releaseFrom, batch.size(), releaseBytes);
+            {
+                // sync() waits on `processed`: only after the whole batch,
+                // including the flush above, as before.
+                std::lock_guard<std::mutex> lock(q->mutex);
+                q->processed += batch.size();
+            }
+            q->done.notify_all();
+            batch.clear();
+        } });
+    m_async->workerId = m_async->worker.get_id();
+}
+
+void GS::sync()
+{
+    if (!deferToWorker())
+        return;
+    std::unique_lock<std::mutex> lock(m_async->mutex);
+    const uint64_t target = m_async->submitted;
+    if (m_async->processed >= target)
+        return;
+    ps2_profile::Scope waitScope(ps2_profile::GsSync);
+    Ps2xWaitScope probe(Ps2xWait::GsSync);
+    m_async->done.wait(lock, [&] { return m_async->processed >= target; });
+}
+
+void GS::runOnWorker(const std::function<void()> &fn)
+{
+    if (!deferToWorker())
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+        fn();
+        return;
+    }
+    AsyncQueue::Command cmd{AsyncQueue::Call, {}, {}};
+    cmd.fn = [this, &fn]()
+    {
+        std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+        fn();
+    };
+    m_async->push(std::move(cmd));
+    sync(); // waits for everything submitted so far, including this call
+}
