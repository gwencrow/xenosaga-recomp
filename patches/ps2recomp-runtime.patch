+class GSGlBackend final : public GSRasterBackend
+{
+public:
+    GSGlBackend() = default;
+    ~GSGlBackend() override
+    {
+        // PS2X_GL_STATS=1: where the GS thread's time went (gs_replay prints it per pass).
+        if (std::getenv("PS2X_GL_STATS"))
+            std::fprintf(stderr, "[gs-gl] stats: draws %llu, readbacks %llu (%.1f ms, %llu px), decoded cells %llu (%.1f ms, %llu texels)\n",
+                         (unsigned long long)m_draws, (unsigned long long)m_syncs, m_syncNs / 1e6,
+                         (unsigned long long)m_syncPixels, (unsigned long long)m_decodedCells, m_decodeNs / 1e6,
+                         (unsigned long long)m_decodedTexels);
+    }
