+Ps2Ipu::Ps2Ipu(FetchFn fetch) : m_fetch(std::move(fetch)) {}
+
+void Ps2Ipu::reset()
+{
+    m_in.clear();
+    m_bitPos = 0;
+    m_pendingBp = 0;
+    m_out.clear();
+    m_outRead = 0;
+    m_ctrl = 0;
+    m_cmdResult = 0;
+}
+
+bool Ps2Ipu::ensureBits(uint32_t bits)
+{
+    while (m_in.size() * 128u < m_bitPos + bits)
+    {
+        std::array<uint8_t, 16> q;
+        if (!m_fetch || !m_fetch(q.data()))
+        {
+            m_starved = true;
+            return false;
+        }
+        if (m_in.empty())
+        {
+            m_bitPos = m_pendingBp;
+            m_pendingBp = 0;
+        }
+        m_in.push_back(q);
+    }
+    return true;
+}
+
+uint32_t Ps2Ipu::peekBits(uint32_t bits)
+{
+    if (bits == 0)
+        return 0;
+    ensureBits(bits);
+    uint32_t value = 0;
+    uint32_t pos = m_bitPos;
+    for (uint32_t i = 0; i < bits; ++i, ++pos)
+    {
+        const size_t q = pos / 128u;
+        uint32_t bit = 0;
+        if (q < m_in.size())
+        {
+            const uint32_t inQ = pos % 128u;
+            bit = (m_in[q][inQ / 8u] >> (7u - inQ % 8u)) & 1u;
+        }
+        value = (value << 1) | bit;
+    }
+    return value;
+}
+
+void Ps2Ipu::skipBits(uint32_t bits)
+{
+    ensureBits(bits);
+    m_bitPos += bits;
+    dropConsumed();
+}
+
+void Ps2Ipu::alignByte()
+{
+    m_bitPos = (m_bitPos + 7u) & ~7u;
+    dropConsumed();
+}
+
+void Ps2Ipu::dropConsumed()
+{
+    while (m_bitPos >= 128u && !m_in.empty())
+    {
+        m_in.pop_front();
+        m_bitPos -= 128u;
+    }
+    if (m_in.empty() && m_bitPos >= 128u)
+        m_bitPos = 0;
+}
+
+void Ps2Ipu::writeCtrl(uint32_t value)
+{
+    if (value & 0x40000000u)
+    {
+        reset();
+        return;
+    }
+    // IDP, AS, IVF, QST, MP1, PCT are written; SCD/ECD and the FIFO counts are status.
+    m_ctrl = (m_ctrl & 0x0000C000u) | (value & 0x07FF0000u);
+}
