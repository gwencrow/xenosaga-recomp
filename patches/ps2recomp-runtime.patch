+noperspective in vec3 vStq;
+noperspective in vec4 vColor;
+flat in vec4 vFlatColor;
+noperspective in float vZ;
+flat in float vFlatZ;
+noperspective in float vFog;
+
+int wrapCoord(int c, int size, int mode, int lo, int hi)
+{
+    if (mode == 0) return c & (size - 1);
+    if (mode == 1) return clamp(c, 0, size - 1);
+    if (mode == 2) return min(max(c, lo), hi);
+    return (c & lo) | hi;
+}
+uvec4 texel(int u, int v)
+{
+    u = wrapCoord(u, s1.z, s1.x, s2.x, s2.y);
+    v = wrapCoord(v, s1.w, s1.y, s2.z, s2.w);
+    uint raw = texelFetch(uTex, ivec2(u, v), 0).r;
+    if (s0.x == 2) raw = texelFetch(uClut, ivec2(int(raw & 255u), s6.w), 0).r;
+    return uvec4(raw & 255u, (raw >> 8) & 255u, (raw >> 16) & 255u, raw >> 24);
+}
+// A texel of an upscaled render target: (U, V) in scaled pixels. Wrapping
+// works on the native texel, the sub-pixel inside it is kept.
+uvec4 texelScaled(int U, int V)
+{
+    int SX = s10.x, SY = s10.y;
+    int nu = U >= 0 ? U / SX : -((SX - 1 - U) / SX);
+    int nv = V >= 0 ? V / SY : -((SY - 1 - V) / SY);
+    int u = wrapCoord(nu, s1.z, s1.x, s2.x, s2.y) * SX + (U - nu * SX);
+    int v = wrapCoord(nv, s1.w, s1.y, s2.z, s2.w) * SY + (V - nv * SY);
+    uint raw = texelFetch(uTex, ivec2(u, v), 0).r;
+    return uvec4(raw & 255u, (raw >> 8) & 255u, (raw >> 16) & 255u, raw >> 24);
+}
+ivec4 sampleScaled(float fu, float fv)
+{
+    float SX = float(s10.x), SY = float(s10.y);
+    if (s0.w == 0)
+        return ivec4(texelScaled(int(floor(fu * SX)), int(floor(fv * SY))));
+    float su = fu * SX - 0.5, sv = fv * SY - 0.5;
+    int u0 = int(floor(su)), v0 = int(floor(sv));
+    float fx = su - float(u0), fy = sv - float(v0);
+    vec4 c00 = vec4(texelScaled(u0, v0)), c10 = vec4(texelScaled(u0 + 1, v0));
+    vec4 c01 = vec4(texelScaled(u0, v0 + 1)), c11 = vec4(texelScaled(u0 + 1, v0 + 1));
+    vec4 top = c00 + (c10 - c00) * fx;
+    vec4 bottom = c01 + (c11 - c01) * fx;
+    return clamp(ivec4(floor(top + (bottom - top) * fy + 0.5)), ivec4(0), ivec4(255));
+}
+ivec4 sampleTexture()
+{
+    float fu, fv;
+    if (s6.y != 0)
+    {
+        // Triangles truncate the interpolated 1/16 texel value, sprites round it.
+        float offset = s7.w != 0 ? 0.5 : 0.0;
+        fu = floor(vStq.x + offset) / 16.0;
+        fv = floor(vStq.y + offset) / 16.0;
+    }
+    else
+    {
+        float q = abs(vStq.z) > 1.0e-8 ? vStq.z : 1.0;
+        fu = vStq.x / q * float(s1.z);
+        fv = vStq.y / q * float(s1.w);
+    }
+    if (s10.x > 1 || s10.y > 1)
+        return sampleScaled(fu, fv);
+    if (s0.w == 0)
+        return ivec4(texel(int(fu), int(fv)));
+    float su = fu - 0.5, sv = fv - 0.5;
+    int u0 = int(floor(su)), v0 = int(floor(sv));
+    float fx = su - float(u0), fy = sv - float(v0);
+    vec4 c00 = vec4(texel(u0, v0)), c10 = vec4(texel(u0 + 1, v0));
+    vec4 c01 = vec4(texel(u0, v0 + 1)), c11 = vec4(texel(u0 + 1, v0 + 1));
+    vec4 top = c00 + (c10 - c00) * fx;
+    vec4 bottom = c01 + (c11 - c01) * fx;
+    return clamp(ivec4(floor(top + (bottom - top) * fy + 0.5)), ivec4(0), ivec4(255));
+}
+ivec4 shadeColor()
+{
+    ivec4 v = s6.z != 0 ? ivec4(vColor) : ivec4(vFlatColor);
+    if (s0.x == 0) return v;
+    ivec4 t = sampleTexture();
+    ivec4 c = t;
+    bool hasA = s0.z != 0;
+    c.a = hasA ? t.a : v.a;
+    if (s0.y == 0)
+    {
+        c.rgb = min((t.rgb * v.rgb) >> 7, ivec3(255));
+        c.a = hasA ? min((t.a * v.a) >> 7, 255) : v.a;
+    }
+    else if (s0.y == 2)
+    {
+        c.rgb = min(((t.rgb * v.rgb) >> 7) + ivec3(v.a), ivec3(255));
+        c.a = hasA ? min(t.a + v.a, 255) : v.a;
+    }
+    else if (s0.y == 3)
+    {
+        c.rgb = min(((t.rgb * v.rgb) >> 7) + ivec3(v.a), ivec3(255));
+    }
+    return c;
+}
+bool alphaPass(int a)
+{
+    if (s3.x == 0) return true;
+    switch (s3.y)
+    {
+    case 0: return false;
+    case 1: return true;
+    case 2: return a < s3.z;
+    case 3: return a <= s3.z;
+    case 4: return a == s3.z;
+    case 5: return a >= s3.z;
+    case 6: return a > s3.z;
+    default: return a != s3.z;
+    }
+}
+int pick(int sel, int cs, int cd) { return sel == 0 ? cs : (sel == 1 ? cd : 0); }
+
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    ivec4 c = shadeColor();
+    if (s8.x != 0)
+    {
+        int fog = clamp(int(vFog), 0, 255);
+        c.r = ((fog * c.r) >> 8) + (((255 - fog) * s8.y) >> 8);
+        c.g = ((fog * c.g) >> 8) + (((255 - fog) * s8.z) >> 8);
+        c.b = ((fog * c.b) >> 8) + (((255 - fog) * s8.w) >> 8);
+    }
+    bool writeRgb = true, writeA = true, writeZ = true;
+    if (!alphaPass(c.a))
+    {
+        writeRgb = s3.w == 1 || s3.w == 3;
+        writeA = s3.w == 1;
+        writeZ = s3.w == 2;
+    }
+    // A float holds whole numbers only from 2^23 up, where adding 0.5 would
+    // round up by one (at maximum depth that beat equal-depth tests). Sprites
+    // have one depth, so they skip interpolation and its rounding altogether.
+    // The test uses the full value, as WritePixel does: the save thumbnail draws
+    // at 0xFFFFFFFF (a float rounds that to 2^32, which uint() can't hold) and must
+    // pass "greater" against a stored 0xFFFFFF. Only the store is masked.
+    float depth = s7.w != 0 ? vFlatZ : vZ;
+    uint z = depth >= 4294967040.0 ? 0xFFFFFFFFu : (depth >= 8388608.0 ? uint(depth) : uint(depth + 0.5));
+    if (s7.w == 0) z = min(z, s9.y); // interpolation can round just past the top
+
+    beginInvocationInterlockARB();
+    if (writeRgb || writeA || writeZ)
+    {
+        uint dst = imageLoad(uFrame, p).r;
+        bool pass = s7.x == 0 || (((dst >> 31) & 1u) != 0u) == (s7.y != 0);
+        if (pass && s4.x != 1)
+        {
+            if (s4.x == 0) pass = false;
+            else
+            {
+                uint stored = imageLoad(uDepth, p).r;
+                pass = s4.x == 2 ? z >= stored : z > stored;
+            }
+        }
+        if (pass)
+        {
+            if (writeRgb || writeA)
+            {
+                ivec4 d = ivec4(dst & 255u, (dst >> 8) & 255u, (dst >> 16) & 255u, dst >> 24);
+                ivec3 rgb = c.rgb;
+                if (s4.z != 0 && !(s7.z != 0 && (c.a & 128) == 0))
