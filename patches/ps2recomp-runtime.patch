+// Runtime-integrated Vulkan GS tests. Everything goes through the real runtime GS class:
+// GS::processGIFPacket(path, ...) -> async worker -> installed paraLLEl-GS device, with CSR in a
+// PS2Memory::GSRegisters, local->host through GS::consumeLocalToHostBytes, VRAM checkpoints
+// through GS::refreshDisplaySnapshot and scanout through GS::latchHostPresentationFrame.
+//
+// usage: gs_vk_runtime_tests FIXTURES REFERENCE_MATRIX OUT_DIR [--validation] [--modes native,2x,x8,x16]
+// FIXTURES = synthetic GIF fixtures (orig/, split/, scaling-v2/), REFERENCE_MATRIX = standalone
+// paraLLEl-GS evaluator outputs on the same device (port: tests/vulkan-fixtures/README.md).
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/gs_pgs_device.h"
+#include "runtime/gs/ps2_gs_memory.h"
+#include "runtime/ps2_memory.h"
+
+#include "context.hpp" // Granite (validation canary only)
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <map>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace fs = std::filesystem;
+
+namespace
+{
+int g_failures = 0, g_checks = 0;
+bool g_validation = false;
+fs::path g_fixtures, g_ref, g_out;
+std::ofstream g_json;
+
+void check(bool ok, const std::string &what)
+{
+    ++g_checks;
+    if (!ok)
+    {
+        ++g_failures;
+        std::printf("  FAIL: %s\n", what.c_str());
+    }
+    else
+        std::printf("  ok: %s\n", what.c_str());
+}
+
+std::vector<uint8_t> readFile(const fs::path &p)
+{
+    std::ifstream in(p, std::ios::binary);
+    return std::vector<uint8_t>((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+}
+
+void writeFile(const fs::path &p, const std::vector<uint8_t> &d)
+{
+    fs::create_directories(p.parent_path());
+    std::ofstream out(p, std::ios::binary);
+    out.write(reinterpret_cast<const char *>(d.data()), std::streamsize(d.size()));
+}
+
+void put64(std::vector<uint8_t> &v, uint64_t x)
+{
+    const size_t at = v.size();
+    v.resize(at + 8);
+    std::memcpy(v.data() + at, &x, 8);
+}
+
+uint64_t gifTag(uint32_t nloop, bool eop, uint32_t flg, uint32_t nreg)
+{
+    return uint64_t(nloop & 0x7FFF) | (eop ? 1ull << 15 : 0) | (uint64_t(flg) << 58) | (uint64_t(nreg & 0xF) << 60);
+}
+
+std::vector<uint8_t> adPacket(const std::vector<std::pair<uint8_t, uint64_t>> &regs)
+{
+    std::vector<uint8_t> v;
+    put64(v, gifTag(uint32_t(regs.size()), true, 0, 1));
+    put64(v, 0xE);
+    for (auto &r : regs)
+    {
+        put64(v, r.second);
+        put64(v, r.first);
+    }
+    return v;
+}
+
+int samplesFor(const std::string &mode)
+{
+    return mode == "native" ? 1 : mode == "2x" ? 4 : mode == "x8" ? 8 : 16;
+}
+
+// One runtime GS with the Vulkan device installed.
+struct Rig
+{
+    std::vector<uint8_t> vram = std::vector<uint8_t>(PS2_GS_VRAM_SIZE, 0);
+    GSRegisters regs{};
+    GS gs;
+    PgsDeviceInfo info;
+    bool ok = false;
+    std::string error;
+
+    explicit Rig(int samples)
+    {
+        gs.init(vram.data(), uint32_t(vram.size()), &regs);
+        gs.setAsync(true);
+        PgsDeviceConfig cfg{};
+        cfg.samples = samples;
+        cfg.validation = g_validation;
+        cfg.forceProgressive = false; // match the standalone evaluator's native scanout settings
+        cfg.initialVram = vram.data();
+        cfg.vramSize = uint32_t(vram.size());
+        cfg.privRegs = &regs;
+        ok = gs.installGifDevice([&](std::string &e) { return ps2x_createPgsDevice(cfg, e, &info); }, error);
+    }
+
+    void gif(uint32_t pathIndex, const std::vector<uint8_t> &d)
+    {
+        gs.processGIFPacket(GifPathId(pathIndex + 1), d.data(), uint32_t(d.size()));
+    }
+
+    std::vector<uint8_t> vramSnapshot()
+    {
+        gs.refreshDisplaySnapshot();
+        uint32_t size = 0;
+        const uint8_t *p = gs.lockDisplaySnapshot(size);
+        std::vector<uint8_t> out(p, p + size);
+        gs.unlockDisplaySnapshot();
+        return out;
+    }
+
+    // Presents until a frame produced after this call is available (the ring is 1-2 behind).
+    bool scanout(const uint64_t v[6], std::vector<uint8_t> &rgba, uint32_t &w, uint32_t &h)
+    {
+        regs.pmode = v[0];
+        regs.smode1 = v[1];
+        regs.smode2 = v[2];
+        regs.dispfb1 = v[3];
+        regs.display1 = v[4];
+        regs.bgcolor = v[5];
+        for (int i = 0; i < 8; ++i)
+        {
+            gs.latchHostPresentationFrame();
+            gs.sync();
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        }
+        return gs.copyLatchedHiresFrame(rgba, w, h);
+    }
+};
+
+struct ScriptResult
+{
+    std::map<std::string, std::vector<uint8_t>> outputs;
+    std::map<std::string, std::pair<uint32_t, uint32_t>> sizes;
+};
+
+// Runs a fixture's commands.txt through the runtime GS. `transform` may rewrite each GIF command
+// into several (path, bytes) transfers (splits, interleaved paths).
+using GifTransform = std::function<std::vector<std::pair<uint32_t, std::vector<uint8_t>>>(uint32_t, const std::string &,
+                                                                                         const std::vector<uint8_t> &)>;
+
+ScriptResult runScript(Rig &rig, const fs::path &fixture, const GifTransform &transform = {})
+{
+    ScriptResult r;
+    std::ifstream script(fixture / "commands.txt");
+    for (std::string line; std::getline(script, line);)
+    {
+        std::istringstream row(line);
+        std::string op, name;
+        row >> op;
+        if (op == "gif")
+        {
+            uint32_t path = 0;
+            row >> path >> name;
+            const auto data = readFile(fixture / name);
+            if (transform)
+                for (auto &t : transform(path, name, data))
+                    rig.gif(t.first, t.second);
+            else
+                rig.gif(path, data);
+        }
+        else if (op == "vram")
+        {
+            row >> name;
+            r.outputs[name] = rig.vramSnapshot();
+        }
+        else if (op == "fifo")
+        {
+            uint32_t qwords = 0;
+            row >> qwords >> name;
+            std::vector<uint8_t> bytes(size_t(qwords) * 16);
+            const uint32_t got = rig.gs.consumeLocalToHostBytes(bytes.data(), uint32_t(bytes.size()));
+            bytes.resize(got);
+            r.outputs[name] = bytes;
+        }
+        else if (op == "scanout")
+        {
+            uint32_t phase = 0;
+            uint64_t v[6];
+            row >> phase >> std::hex >> v[0] >> v[1] >> v[2] >> v[3] >> v[4] >> v[5] >> name;
+            // CSR.FIELD carries the phase (bit 13).
+            if (phase)
+                rig.regs.csr.fetch_or(0x2000);
+            else
+                rig.regs.csr.fetch_and(~0x2000ull);
+            std::vector<uint8_t> px;
+            uint32_t w = 0, h = 0;
+            const bool got = rig.scanout(v, px, w, h);
+            check(got, "presentation produced a frame for " + name);
+            if (got)
+            {
+                r.outputs[name] = px;
+                r.sizes[name] = {w, h};
+            }
+        }
+    }
+    rig.gs.sync();
+    return r;
+}
+
+// Compares outputs with the standalone evaluator reference directory. Scanout alpha is forced opaque by
+// the presenter, so scanouts compare RGB only.
+bool compareWithReference(const ScriptResult &r, const fs::path &refDir, const std::string &label)
+{
+    bool all = true;
+    for (const auto &kv : r.outputs)
+    {
+        const auto ref = readFile(refDir / kv.first);
+        if (ref.empty())
+        {
+            check(false, label + ": reference missing for " + kv.first);
+            all = false;
+            continue;
+        }
+        bool same = ref.size() == kv.second.size();
+        size_t firstDiff = 0, diffs = 0;
+        const bool rgb = kv.first.find("scanout") != std::string::npos;
+        for (size_t i = 0; same && i < ref.size(); ++i)
+        {
+            if (rgb && (i & 3) == 3)
+                continue;
+            if (ref[i] != kv.second[i])
+            {
+                if (!diffs++)
+                    firstDiff = i;
+            }
+        }
+        same = same && diffs == 0;
+        std::string detail = label + ": " + kv.first + " identical to the evaluator (" + std::to_string(kv.second.size()) +
+                             " bytes" + (rgb ? ", " + std::to_string(r.sizes.at(kv.first).first) + "x" +
+                                                       std::to_string(r.sizes.at(kv.first).second)
+                                                 : std::string()) + ")";
+        if (!same)
+            detail += " - size " + std::to_string(kv.second.size()) + " vs " + std::to_string(ref.size()) + ", " +
+                      std::to_string(diffs) + " differing bytes, first at " + std::to_string(firstDiff);
+        check(same, detail);
+        all = all && same;
+        writeFile(g_out / label / kv.first, kv.second);
+    }
+    return all;
+}
+
+std::vector<uint8_t> nop() { return adPacket({{0x7F, 0}}); }
+} // namespace
+
+int main(int argc, char **argv)
+{
+    if (argc < 4)
+    {
+        std::printf("usage: %s FIXTURES REFERENCE_MATRIX OUT_DIR [--validation] [--modes a,b]\n", argv[0]);
+        return 2;
+    }
+    g_fixtures = argv[1];
+    g_ref = argv[2];
+    g_out = argv[3];
+    std::vector<std::string> modes = {"native", "2x", "x8", "x16"};
+    for (int i = 4; i < argc; ++i)
+    {
+        const std::string a = argv[i];
+        if (a == "--validation")
+            g_validation = true;
+        else if (a == "--modes" && i + 1 < argc)
+        {
+            modes.clear();
+            std::stringstream ss(argv[++i]);
+            for (std::string m; std::getline(ss, m, ',');)
+                modes.push_back(m);
+        }
+    }
+    fs::create_directories(g_out);
+    if (g_validation)
+    {
+        // Evidence that the loader really inserts the layer (Release Granite does not log it).
+        setenv("VK_LOADER_DEBUG", "layer", 1);
+        setenv("VK_INSTANCE_LAYERS", "VK_LAYER_KHRONOS_validation", 1);
+        // Canary: one deliberate invalid call in the same process configuration (no debug
+        // messenger, Release Granite) must produce a validation message in this log.
+        if (Vulkan::Context::init_loader(nullptr))
+        {
+            Vulkan::Context ctx;
+            ctx.set_num_thread_indices(1);
+            if (ctx.init_instance_and_device(nullptr, 0, nullptr, 0, Vulkan::CONTEXT_CREATION_ENABLE_PUSH_DESCRIPTOR_BIT))
+            {
+                VkBufferCreateInfo info = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+                info.size = 0; // VUID-VkBufferCreateInfo-size-00912
+                info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+                VkBuffer buffer = VK_NULL_HANDLE;
+                std::printf("[canary] creating a zero-size buffer (expected validation error)\n");
+                std::fflush(stdout);
+                if (ctx.get_device_table().vkCreateBuffer(ctx.get_device(), &info, nullptr, &buffer) == VK_SUCCESS &&
+                    buffer != VK_NULL_HANDLE)
+                    ctx.get_device_table().vkDestroyBuffer(ctx.get_device(), buffer, nullptr);
+                std::printf("[canary] done\n");
+                std::fflush(stdout);
+            }
+        }
+    }
+
+    for (const std::string &mode : modes)
+    {
+        const int samples = samplesFor(mode);
+        std::printf("[mode] %s (requested X%d)\n", mode.c_str(), samples);
+        {
+            Rig rig(samples);
+            check(rig.ok, mode + ": Vulkan device installed in the runtime GS" + (rig.ok ? "" : " - " + rig.error));
+            if (!rig.ok)
+                continue;
+            std::printf("  device '%s' requested %d effective %d max %d\n", rig.info.deviceName.c_str(),
+                        rig.info.samplesRequested, rig.info.samplesEffective, rig.info.samplesDeviceMax);
+            check(rig.info.samplesEffective <= rig.info.samplesDeviceMax &&
+                      rig.info.samplesEffective == std::min(samples, rig.info.samplesDeviceMax),
+                  mode + ": effective sample count clamped to the device maximum before init");
+            const auto r = runScript(rig, g_fixtures / "orig");
+            compareWithReference(r, g_ref / ("orig-" + mode), "orig-" + mode);
+            check((rig.regs.csr.load() & 0x2) != 0, mode + ": FINISH in the GIF stream set CSR.FINISH");
+        }
+        {
+            Rig rig(samples);
+            const auto r = runScript(rig, g_fixtures / "split");
+            compareWithReference(r, g_ref / ("split-" + mode), "split-" + mode);
+        }
+        {
+            Rig rig(samples);
+            const auto r = runScript(rig, g_fixtures / "scaling-v2");
+            compareWithReference(r, g_ref / ("v2-" + mode), "v2-" + mode);
+        }
+    }
+
+    // ---- ordering / path identity at native rate ----
+    std::printf("[ingress] split IMAGE with an interleaved PATH1 packet\n");
+    {
+        Rig rig(1);
+        auto t = [](uint32_t path, const std::string &name, const std::vector<uint8_t> &d) {
+            std::vector<std::pair<uint32_t, std::vector<uint8_t>>> out{{path, d}};
+            if (name == "image-tail.bin")
+                out.insert(out.begin(), {0u, nop()}); // PATH1 packet between head and tail
+            return out;
+        };
+        const auto r = runScript(rig, g_fixtures / "split", t);
+        compareWithReference(r, g_ref / "split-native", "split-native-interleaved-path1");
+    }
+    std::printf("[ingress] negative control: IMAGE tail delivered on the wrong path\n");
+    {
+        Rig rig(1);
+        auto t = [](uint32_t path, const std::string &name, const std::vector<uint8_t> &d) {
+            std::vector<std::pair<uint32_t, std::vector<uint8_t>>> out{{path, d}};
+            if (name == "image-tail.bin")
+                out[0].first = 0; // tail on PATH1: the PATH3 IMAGE never completes there
+            return out;
+        };
+        const auto r = runScript(rig, g_fixtures / "split", t);
+        const auto ref = readFile(g_ref / "split-native" / "after-upload.vram");
+        check(!ref.empty() && r.outputs.count("after-upload.vram") && r.outputs.at("after-upload.vram") != ref,
+              "wrong-path tail corrupts the upload (the comparison detects lost path identity)");
+    }
+    std::printf("[ingress] every GIF command split mid-packet with other paths interleaved\n");
+    for (int variant = 0; variant < 6; ++variant)
+    {
+        Rig rig(1);
+        auto t = [variant](uint32_t path, const std::string &, const std::vector<uint8_t> &d) {
+            std::vector<std::pair<uint32_t, std::vector<uint8_t>>> out;
+            const size_t qw = d.size() / 16;
+            // variant 0/3: after the first qword (tag only: partial tag/continuation);
+            // 1/4: middle; 2/5: one qword before the end. Single-qword packets stay whole.
+            // Variants 0-2 put another path's complete packet between the halves; 3-5 do not.
+            const int v = variant % 3;
+            size_t cut = v == 0 ? 1 : v == 1 ? qw / 2 : qw - 1;
+            if (qw < 2 || cut == 0 || cut >= qw)
+                return std::vector<std::pair<uint32_t, std::vector<uint8_t>>>{{path, d}};
+            out.push_back({path, std::vector<uint8_t>(d.begin(), d.begin() + cut * 16)});
+            if (variant < 3)
+                out.push_back({(path + 1) % 3, nop()});
