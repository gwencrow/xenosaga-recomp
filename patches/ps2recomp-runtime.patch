+// XGSR capture recorder. See include/runtime/gs/gs_capture.h.
+#include "runtime/gs/gs_capture.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+
+#ifdef _WIN32
+#include <process.h>
+#define XGSR_GETPID _getpid
+#else
+#include <unistd.h>
+#define XGSR_GETPID getpid
+#endif
+
+namespace xgsr
+{
+uint32_t crc32(const void *data, size_t bytes, uint32_t crc)
+{
+    static uint32_t table[256];
+    static const bool init = []
+    {
+        for (uint32_t i = 0; i < 256; ++i)
+        {
+            uint32_t c = i;
+            for (int k = 0; k < 8; ++k)
+                c = (c & 1u) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+            table[i] = c;
+        }
+        return true;
+    }();
+    (void)init;
+    const auto *p = static_cast<const uint8_t *>(data);
+    crc = ~crc;
+    for (size_t i = 0; i < bytes; ++i)
+        crc = table[(crc ^ p[i]) & 0xFFu] ^ (crc >> 8);
+    return ~crc;
+}
+
+uint64_t fnv1a64(const void *data, size_t bytes)
+{
+    const auto *p = static_cast<const uint8_t *>(data);
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < bytes; ++i)
+        h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+
+namespace
+{
+uint64_t envU64(const char *name, uint64_t def)
+{
+    const char *v = std::getenv(name);
+    if (!v || !*v)
+        return def;
+    return std::strtoull(v, nullptr, 10);
+}
+size_t padded(size_t n) { return (n + 7u) & ~size_t(7u); }
+} // namespace
+
+CaptureConfig CaptureConfig::fromEnvironment()
+{
+    CaptureConfig c;
+    const uint64_t mb = envU64("PS2X_GS_CAPTURE_MB", 0);
+    if (mb != 0)
+        c.ringBytes = std::clamp<uint64_t>(mb, 64, 4096) * 1024ull * 1024ull;
+    c.keyframeInterval = uint32_t(std::clamp<uint64_t>(envU64("PS2X_GS_CAPTURE_KEYFRAME", 120), 10, 100000));
+    if (const char *d = std::getenv("PS2X_GS_CAPTURE_DIR"))
+        if (*d)
+            c.dir = d;
+    c.dumpOnWarning = envU64("PS2X_GS_CAPTURE_ON_WARNING", 1) != 0;
+    c.warningDumpDelay = uint32_t(std::min<uint64_t>(envU64("PS2X_GS_CAPTURE_DELAY", 60), 100000));
+    c.maxDumps = uint32_t(std::clamp<uint64_t>(envU64("PS2X_GS_CAPTURE_MAX_DUMPS", 3), 1, 100));
+    return c;
+}
+
+Recorder::Recorder(const CaptureConfig &cfg, const FileHeader &templ) : m_cfg(cfg), m_template(templ)
+{
+    if (cfg.ringBytes == 0)
+        return;
+    try
+    {
+        m_ring.resize(size_t(cfg.ringBytes));
+        m_enabled = true;
+    }
+    catch (const std::bad_alloc &)
+    {
+        std::fprintf(stderr, "[gs-cap] could not allocate the %llu MiB capture ring; capture disabled\n",
+                     (unsigned long long)(cfg.ringBytes >> 20));
+        m_ring.clear();
+        m_enabled = false;
+    }
+    if (m_enabled)
+        std::fprintf(stderr,
+                     "[gs-cap] capture armed: ring %llu MiB, keyframe every %u presents, dir '%s', dump on warning %d "
+                     "(delay %u presents), max dumps %u\n",
+                     (unsigned long long)(cfg.ringBytes >> 20), cfg.keyframeInterval, cfg.dir.c_str(),
+                     int(cfg.dumpOnWarning), cfg.warningDumpDelay, cfg.maxDumps);
+}
+
+Recorder::~Recorder()
+{
+    if (m_writer.joinable())
+        m_writer.join();
+}
+
+void Recorder::evictFront()
+{
+    const Ref &r = m_refs.front();
+    if (r.type == Rec::Keyframe && !m_keyframes.empty() && m_keyframes.front() == r.seq)
+        m_keyframes.pop_front();
+    m_refs.pop_front();
+    ++m_evicted;
+}
+
+void Recorder::record(Rec type, uint8_t path, const void *a, uint32_t aBytes, const void *b, uint32_t bBytes,
+                      uint16_t flags)
+{
+    if (!m_enabled)
+        return;
+    const size_t payload = size_t(aBytes) + bBytes;
+    const size_t total = sizeof(RecordHeader) + padded(payload);
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_frozen || total > m_ring.size() / 4u)
+    {
+        ++m_dropped;
+        return;
+    }
+    if (m_head + total > m_ring.size())
+    {
+        // The tail [head, end) cannot hold the record: everything stored there is the oldest data.
+        while (!m_refs.empty() && m_refs.front().offset >= m_head)
+            evictFront();
+        m_head = 0;
+    }
+    while (!m_refs.empty() && m_refs.front().offset >= m_head && m_refs.front().offset < m_head + total)
+        evictFront();
+
+    RecordHeader h;
+    h.type = uint8_t(type);
+    h.path = path;
+    h.flags = flags;
+    h.bytes = uint32_t(payload);
+    h.seq = m_nextSeq++;
+    h.present = m_present.load(std::memory_order_relaxed);
+    uint8_t *dst = m_ring.data() + m_head;
+    std::memcpy(dst, &h, sizeof(h));
+    if (aBytes)
+        std::memcpy(dst + sizeof(h), a, aBytes);
+    if (bBytes)
+        std::memcpy(dst + sizeof(h) + aBytes, b, bBytes);
+    if (padded(payload) != payload)
+        std::memset(dst + sizeof(h) + payload, 0, padded(payload) - payload);
+    m_refs.push_back({m_head, total, h.seq, type});
+    if (type == Rec::Keyframe)
+    {
+        m_keyframes.push_back(h.seq);
+        m_haveKeyframe = true;
+        m_lastKeyframePresent = h.present;
+    }
+    m_head += total;
+    m_bytesRecorded += total;
+}
+
+void Recorder::recordText(Rec type, const std::string &text)
+{
+    record(type, 0, text.data(), uint32_t(text.size()));
+}
+
+bool Recorder::keyframeDue() const
+{
+    if (!m_enabled)
+        return false;
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_frozen)
+        return false;
+    return !m_haveKeyframe || m_keyframes.empty() ||
+           m_present.load(std::memory_order_relaxed) >= m_lastKeyframePresent + m_cfg.keyframeInterval;
+}
+
+bool Recorder::requestDump(const std::string &reason, uint32_t delayPresents)
+{
+    if (!m_enabled)
+        return false;
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_pending || m_frozen || m_dumps >= m_cfg.maxDumps)
+        return false;
+    m_pending = true;
+    m_pendingReason = reason;
+    m_pendingAt = m_present.load(std::memory_order_relaxed) + delayPresents;
+    std::fprintf(stderr, "[gs-cap] dump requested (%s): writing after %u more presents\n", reason.c_str(), delayPresents);
+    return true;
+}
+
+void Recorder::onPresentBoundary()
+{
+    if (!m_enabled)
+        return;
+    std::string reason;
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (!m_pending || m_frozen || m_present.load(std::memory_order_relaxed) < m_pendingAt)
+            return;
+        m_pending = false;
+        m_frozen = true;
+        reason = m_pendingReason;
+    }
+    if (m_writer.joinable())
+        m_writer.join();
+    // The worker continues; recording resumes (new keyframe) when the writer is done.
+    m_writer = std::thread([this, reason]
+                           {
+        writeFrozen(reason);
+        finishDump(); });
+}
+
+void Recorder::finishDump()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_refs.clear();
+    m_keyframes.clear();
+    m_head = 0;
+    m_haveKeyframe = false; // next present boundary takes a keyframe
+    m_frozen = false;
+}
+
+std::string Recorder::dumpNow(const std::string &reason)
+{
+    if (!m_enabled)
+        return {};
+    if (m_writer.joinable() && std::this_thread::get_id() != m_writer.get_id())
+        m_writer.join();
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_frozen || m_dumps >= m_cfg.maxDumps + 1u) // one extra for the final/stall dump
+            return {};
+        m_frozen = true;
+        m_pending = false;
+    }
+    std::string path = writeFrozen(reason);
+    finishDump();
+    return path;
+}
+
+std::string Recorder::writeFrozen(const std::string &reason)
+{
+    // Ring is frozen: no appends while this runs.
+    std::vector<Ref> refs;
+    uint64_t startSeq = 0;
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_keyframes.empty() || m_refs.empty())
+        {
+            std::fprintf(stderr, "[gs-cap] dump '%s' skipped: no keyframe in the ring yet\n", reason.c_str());
+            return {};
+        }
+        startSeq = m_keyframes.front();
+        for (const Ref &r : m_refs)
+            if (r.seq >= startSeq)
+                refs.push_back(r);
+        ++m_dumps;
+    }
+    char name[96];
+    std::string safe;
+    for (char c : reason)
+        safe.push_back((std::isalnum(static_cast<unsigned char>(c)) || c == '-') ? c : '_');
+    if (safe.size() > 40)
+        safe.resize(40);
+    std::snprintf(name, sizeof(name), "gscap-%lld-%d-%02u-%s.xgsr", (long long)std::time(nullptr), int(XGSR_GETPID()),
+                  m_dumps, safe.c_str());
+    std::string path = m_cfg.dir;
+    if (!path.empty() && path.back() != '/' && path.back() != '\\')
+        path.push_back('/');
+    path += name;
+    if (FILE *exists = std::fopen(path.c_str(), "rb"))
+    {
+        std::fclose(exists);
+        std::fprintf(stderr, "[gs-cap] dump '%s' refused: %s already exists\n", reason.c_str(), path.c_str());
+        return {};
+    }
+    FILE *f = std::fopen(path.c_str(), "wb");
+    if (!f)
+    {
+        std::fprintf(stderr, "[gs-cap] dump '%s' failed: cannot create %s\n", reason.c_str(), path.c_str());
+        return {};
+    }
+    FileHeader hdr = m_template;
+    hdr.ringBytes = m_ring.size();
+    hdr.keyframeInterval = m_cfg.keyframeInterval;
+    hdr.firstSeq = refs.front().seq;
+    hdr.lastSeq = refs.back().seq + 1; // + End record
+    hdr.recordCount = refs.size() + 1;
+    hdr.evictedRecords = m_evicted;
+    hdr.droppedRecords = m_dropped;
+    std::snprintf(hdr.reason, sizeof(hdr.reason), "%s", reason.c_str());
+
+    uint32_t crc = crc32(&hdr, sizeof(hdr));
+    bool ok = std::fwrite(&hdr, sizeof(hdr), 1, f) == 1;
+    uint64_t bytes = sizeof(hdr);
+    for (const Ref &r : refs)
+    {
+        const uint8_t *p = m_ring.data() + r.offset;
+        crc = crc32(p, r.size, crc);
+        ok = ok && std::fwrite(p, 1, r.size, f) == r.size;
+        bytes += r.size;
+    }
+    RecordHeader end;
+    end.type = uint8_t(Rec::End);
+    end.bytes = uint32_t(reason.size());
+    end.seq = refs.back().seq + 1;
+    end.present = m_present.load(std::memory_order_relaxed);
+    std::vector<uint8_t> endRec(sizeof(end) + padded(reason.size()), 0);
+    std::memcpy(endRec.data(), &end, sizeof(end));
+    std::memcpy(endRec.data() + sizeof(end), reason.data(), reason.size());
+    crc = crc32(endRec.data(), endRec.size(), crc);
+    ok = ok && std::fwrite(endRec.data(), 1, endRec.size(), f) == endRec.size();
+    ok = ok && std::fwrite(&crc, sizeof(crc), 1, f) == 1;
+    bytes += endRec.size() + sizeof(crc);
+    ok = (std::fclose(f) == 0) && ok;
+    if (!ok)
+    {
+        std::fprintf(stderr, "[gs-cap] dump '%s' FAILED while writing %s (incomplete file)\n", reason.c_str(), path.c_str());
+        return {};
+    }
+    std::fprintf(stderr, "[gs-cap] wrote %s: %llu records, %llu bytes, seq %llu..%llu, presents %llu..%llu, crc32 0x%08x (%s)\n",
+                 path.c_str(), (unsigned long long)(refs.size() + 1), (unsigned long long)bytes,
+                 (unsigned long long)hdr.firstSeq, (unsigned long long)hdr.lastSeq,
+                 (unsigned long long)reinterpret_cast<const RecordHeader *>(m_ring.data() + refs.front().offset)->present,
+                 (unsigned long long)end.present, crc, reason.c_str());
+    std::fflush(stderr);
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_lastPath = path;
+    return path;
+}
+
+std::string Recorder::status() const
+{
+    if (!m_enabled)
+        return {};
+    std::lock_guard<std::mutex> lock(m_mutex);
+    char buf[256];
+    std::snprintf(buf, sizeof(buf),
+                  "  gs-cap: ring %llu/%llu MiB, %zu records live, %zu keyframes, evicted %llu, dropped %llu, dumps %u%s%s\n",
+                  (unsigned long long)(m_refs.empty() ? 0 : (m_bytesRecorded > m_ring.size() ? m_ring.size() : m_bytesRecorded) >> 20),
+                  (unsigned long long)(m_ring.size() >> 20), m_refs.size(), m_keyframes.size(),
+                  (unsigned long long)m_evicted, (unsigned long long)m_dropped, m_dumps, m_frozen ? " (writing)" : "",
+                  m_pending ? " (dump pending)" : "");
+    return buf;
+}
+} // namespace xgsr
