+
+std::string ps2x_stallProbeReport()
+{
+    const uint64_t now = ps2x_probeNowMs();
+    std::string out;
+    char line[320];
+    for (uint32_t k = 0; k < uint32_t(Ps2xWait::Count); ++k)
+    {
+        const uint32_t n = g_waiters[k].load(std::memory_order_acquire);
+        if (n == 0)
+            continue;
+        std::snprintf(line, sizeof(line), "  stall-probe: %u thread(s) waiting in %s, newest wait %.1f s (waits begun %llu)\n", n,
+                      kWaitNames[k], (now - g_waitSinceMs[k].load()) / 1000.0, (unsigned long long)g_waitsStarted[k].load());
+        out += line;
+    }
+    std::snprintf(line, sizeof(line),
+                  "  stall-probe: GS worker '%s' for %.1f s; device op '%s' (a=0x%llx b=0x%llx) for %.1f s, %llu device ops\n",
+                  g_workerOp.load(), (now - g_workerOpSinceMs.load()) / 1000.0, g_deviceOp.load(),
+                  (unsigned long long)g_deviceOpA.load(), (unsigned long long)g_deviceOpB.load(),
+                  (now - g_deviceOpSinceMs.load()) / 1000.0, (unsigned long long)g_deviceOps.load());
+    out += line;
+    const uint64_t job = g_vif1Job.load(std::memory_order_acquire);
+    if (job)
+        std::snprintf(line, sizeof(line), "  stall-probe: VIF1 worker busy with a chain of %llu bytes for %.1f s\n",
+                      (unsigned long long)job, (now - g_vif1JobSinceMs.load()) / 1000.0);
+    else
+        std::snprintf(line, sizeof(line), "  stall-probe: VIF1 worker idle for %.1f s\n", (now - g_vif1JobSinceMs.load()) / 1000.0);
+    out += line;
+    return out;
+}
+
+std::string GS::stallReport()
+{
+    std::string out = ps2x_stallProbeReport();
+    if (m_async)
+    {
+        // try_lock: never block the reporter behind a stuck queue user.
+        std::unique_lock<std::mutex> lock(m_async->mutex, std::try_to_lock);
+        char line[256];
+        if (lock.owns_lock())
+            std::snprintf(line, sizeof(line),
+                          "  stall-probe: GS queue %zu commands, %zu bytes pending, submitted %llu processed %llu, worker %s, "
+                          "%d producer(s) waiting for space\n",
+                          m_async->queue.size(), m_async->pendingBytes, (unsigned long long)m_async->submitted,
+                          (unsigned long long)m_async->processed, m_async->workerSleeping ? "sleeping" : "busy",
+                          m_async->producersWaiting);
+        else
+            std::snprintf(line, sizeof(line), "  stall-probe: GS queue lock held by another thread (not inspected)\n");
+        out += line;
+    }
+    return out;
+}
