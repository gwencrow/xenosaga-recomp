+// The loader-relevant environment as this process sees it, so a negative control can
+// prove whether its driver-hiding condition was really in effect.
+bool processElevated()
+{
+#ifdef _WIN32
+    // Resolved at run time so the executable's import table (staged dependency closure) is unchanged.
+    HMODULE advapi = LoadLibraryA("advapi32.dll");
+    if (!advapi)
+        return false;
+    using OpenTokenFn = BOOL(WINAPI *)(HANDLE, DWORD, PHANDLE);
+    using GetInfoFn = BOOL(WINAPI *)(HANDLE, TOKEN_INFORMATION_CLASS, LPVOID, DWORD, PDWORD);
+    auto openToken = reinterpret_cast<OpenTokenFn>(reinterpret_cast<void *>(GetProcAddress(advapi, "OpenProcessToken")));
+    auto getInfo = reinterpret_cast<GetInfoFn>(reinterpret_cast<void *>(GetProcAddress(advapi, "GetTokenInformation")));
+    bool elevated = false;
+    HANDLE token = nullptr;
+    if (openToken && getInfo && openToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+    {
+        TOKEN_ELEVATION elevation{};
+        DWORD size = 0;
+        elevated = getInfo(token, TokenElevation, &elevation, sizeof(elevation), &size) != 0 && elevation.TokenIsElevated != 0;
+        CloseHandle(token);
+    }
+    FreeLibrary(advapi);
+    return elevated;
+#else
+    return false;
+#endif
+}
+
+void reportLoaderEnvironment()
+{
+    static const char *const names[] = {"VK_DRIVER_FILES", "VK_ICD_FILENAMES", "VK_ADD_DRIVER_FILES",
+                                        "VK_LOADER_DRIVERS_SELECT", "VK_LOADER_DRIVERS_DISABLE", "VK_INSTANCE_LAYERS",
+                                        "VK_LOADER_DEBUG", "PS2X_VK_FAULT_INJECT"};
+    std::string line = "[gs-vk] loader environment:";
+    for (const char *n : names)
+        if (const char *v = std::getenv(n))
+        {
+            line += ' ';
+            line += n;
+            line += '=';
+            line += v;
+        }
+    line += processElevated() ? "; process ELEVATED (the loader ignores some VK_* variables when elevated)"
+                              : "; process not elevated";
+    std::fprintf(stderr, "%s\n", line.c_str());
+}
