+
+// Counters readable from any thread (heartbeat); reset by StatsReport.
+struct Stats
+{
+    std::atomic<uint64_t> gifCalls[3]{}, gifBytes[3]{}, gifNs{};
+    std::atomic<uint64_t> regWrites{};
+    std::atomic<uint64_t> signals{}, finishes{}, labels{};
+    std::atomic<uint64_t> presents{}, vsyncNs{}, emptyScanouts{}, skippedScanouts{};
+    std::atomic<uint64_t> readbackSubmits{}, readbackWaits{}, readbackWaitNs{}, framesPublished{}, convertNs{};
+    std::atomic<uint64_t> fifoReads{}, fifoBytes{}, fifoNs{};
+    std::atomic<uint64_t> pixelReads{}, pixelWrites{}, pixelNs{}, vramSnapshots{}, vramSnapshotNs{};
+    std::atomic<uint64_t> idleFlushes{}, idleFlushNs{};
