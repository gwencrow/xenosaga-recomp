+namespace
+{
+    struct RegisteredProgram
+    {
+        vu1native::ProgramEntry entry;
+        // For each pair in the region, the exclusive end index of its range.
+        // Zero means the next pair belongs to the interpreter.
+        std::array<uint16_t, 0x4000u / 8u> regionEnds{};
+    };
+    struct NativeRegistry
+    {
+        std::vector<RegisteredProgram> entries;
+        std::unordered_map<uint32_t, std::vector<uint32_t>> byPc; // entry pc -> indices
+    };
+    NativeRegistry &nativeRegistry()
+    {
+        static NativeRegistry registry;
+        return registry;
+    }
+    bool g_nativeEnabled = [] {
+        const char *env = std::getenv("PS2X_VU1_PROGRAMS");
+        return env && std::strcmp(env, "1") == 0;
+    }();
+
+    // The program registered for pc whose code pairs match the current
+    // microcode; per entry the match is checked once per code generation.
+    const RegisteredProgram *findNativeProgram(uint64_t generation, const uint8_t *code, uint32_t codeSize, uint32_t pc)
+    {
+        NativeRegistry &registry = nativeRegistry();
+        const auto it = registry.byPc.find(pc);
+        if (it == registry.byPc.end() || codeSize < 0x4000u)
+            return nullptr;
+        thread_local uint64_t cachedGeneration = ~0ull;
+        thread_local const uint8_t *cachedCode = nullptr;
+        thread_local std::vector<int8_t> match; // per entry: -1 unknown, 0 no, 1 yes
+        if (generation != cachedGeneration || code != cachedCode || match.size() != registry.entries.size())
+        {
+            cachedGeneration = generation;
+            cachedCode = code;
+            match.assign(registry.entries.size(), -1);
+        }
+        for (const uint32_t index : it->second)
+        {
+            if (match[index] < 0)
+            {
+                const vu1native::ProgramEntry &e = registry.entries[index].entry;
+                match[index] = vu1native::codeHash(code, e.ranges, e.rangeCount) == e.codeHash ? 1 : 0;
+            }
+            if (match[index] == 1)
+                return &registry.entries[index];
+        }
+        return nullptr;
+    }
+}
+
+void vu1native::registerPrograms(const ProgramEntry *entries, size_t count)
+{
+    NativeRegistry &registry = nativeRegistry();
+    for (size_t i = 0; i < count; ++i)
+    {
+        const ProgramEntry &entry = entries[i];
+        if (!entry.scheduled || entry.fn)
+            continue;
+        RegisteredProgram program{entry};
+        for (uint32_t r = 0; r < entry.rangeCount; ++r)
+        {
+            const uint32_t begin = entry.ranges[2 * r] / 8u;
+            const uint32_t end = entry.ranges[2 * r + 1] / 8u;
+            std::fill(program.regionEnds.begin() + begin, program.regionEnds.begin() + end,
+                      static_cast<uint16_t>(end));
+        }
+        registry.byPc[entry.pc].push_back(static_cast<uint32_t>(registry.entries.size()));
+        registry.entries.push_back(std::move(program));
+    }
+}
